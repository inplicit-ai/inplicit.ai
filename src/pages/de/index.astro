---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import HeroVideo from '../../components/redesign/HeroVideo.astro';
import LogoStrip from '../../components/redesign/LogoStrip.astro';
import Challenge from '../../components/redesign/Challenge.astro';
import Steps from '../../components/redesign/Steps.astro';
import Audience from '../../components/redesign/Audience.astro';
import ProductPeek from '../../components/redesign/ProductPeek.astro';
import Trust from '../../components/redesign/Trust.astro';
import ClosingCta from '../../components/redesign/ClosingCta.astro';
import Footer from '../../components/Footer.astro';

const lang = 'de';
---

<Layout
  title="inplicit.ai - Eure Organisation. In Stunden verstanden."
  description="Inplicit macht das Erfahrungswissen Eurer Mitarbeitenden sichtbar. Unsere KI führt Interviews, erkennt konkrete Lösungswege und zeigt Verbesserungspotenziale auf."
  lang="de"
>
  <Nav lang={lang} ctaHref="/de/call" />
  <main>
    <HeroVideo lang={lang} />
    <!-- Logos vorerst aus: <LogoStrip lang={lang} /> -->
    <Challenge lang={lang} />
    <Steps lang={lang} />
    <Audience lang={lang} />
    <ProductPeek lang={lang} />
    <Trust lang={lang} />
    <ClosingCta lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('.section-fade').forEach((el) => observer.observe(el));
</script>
