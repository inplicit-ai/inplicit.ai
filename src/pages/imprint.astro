  <main class="legal container">
    <h1>Imprint / Impressum</h1>

    <section>
      <h2>DE - Impressum (§5 TMG)</h2>
      <p><strong>Angaben gemäß §5 TMG:</strong></p>
      <p>
        Inplicit GbR<br />
        c/o House of AI<br />
        Hongkongstraße 2&ndash;4<br />
        20457 Hamburg<br />
        Deutschland
      </p>
      <p>
        <strong>Vertretungsberechtigte Gesellschafter</strong><br />
        Martin Auer <br />
        Silas Kruckenberg
      </p>
      <p>
        <strong>Kontakt:</strong><br />
        E-Mail: info@inplicit.ai
      </p>
      <!-- USt-IdNr. ergaenzen, sobald vergeben:
      <p>
        <strong>Umsatzsteuer-Identifikationsnummer:</strong><br />
        [USt-IdNr.]
      </p>
      -->
      <p>
        <strong>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV:</strong><br />
        Silas Kruckenberg<br />
        c/o House of AI<br />
        Hongkongstraße 2&ndash;4<br />
        20457 Hamburg<br />
        Deutschland
      </p>
    </section>

    <section>
      <h2>EN - Imprint</h2>
      <p>
        Inplicit GbR<br />
        c/o House of AI<br />
        Hongkongstraße 2&ndash;4<br />
        20457 Hamburg<br />
        Germany
      </p>
      <p>
        <strong>Represented by:</strong><br />
        Martin Auer <br />
        Silas Kruckenberg
      </p>
      <p>
        <strong>Contact:</strong><br />
        Email: info@inplicit.ai
      </p>
      <!-- <p>
        <strong>VAT identification number:</strong><br />
        [VAT ID, if applicable]
      </p> -->
      <p>
        <strong>Responsible for content (§ 18 (2) MStV):</strong><br />
        Silas Kruckenberg<br />
        c/o House of AI<br />
        Hongkongstraße 2&ndash;4<br />
        20457 Hamburg<br />
        Germany
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .legal {
    /* space-32 top: clear the fixed nav pill */
    padding: var(--space-32) var(--space-4) var(--space-16);
    max-width: 720px;
  }

  .legal h1 {
    font-size: clamp(var(--text-lg), 6vw, var(--text-2xl));
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-8);
    overflow-wrap: break-word;
  }

  .legal section {
    margin-bottom: var(--space-12);
  }

  .legal h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-4);
    color: var(--color-accent);
  }

  .legal p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .legal strong {
    color: var(--color-text-primary);
  }
</style>
