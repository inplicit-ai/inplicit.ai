---
export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;

const year = new Date().getFullYear();

const mainLinks = lang === 'de'
  ? [
      { href: '/de/#how-it-works', label: 'Wie es funktioniert' },
      { href: '/de/#book-demo', label: 'Demo buchen' },
    ]
  : [
      { href: '/#how-it-works', label: 'How it works' },
      { href: '/#book-demo', label: 'Book demo' },
    ];

const legalLinks = lang === 'de'
  ? [
      { href: '/imprint', label: 'Impressum' },
      { href: '/privacy', label: 'Datenschutz' },
      { href: '/terms', label: 'AGB' },
    ]
  : [
      { href: '/imprint', label: 'Imprint' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
    ];

// EU flag: 12 stars evenly spaced on a circle (drawn, not emoji — emoji flags don't render on Windows)
const euStars = Array.from({ length: 12 }, (_, i) => {
  const angle = (i * Math.PI) / 6;
  return { x: 12 + 4.6 * Math.sin(angle), y: 8 - 4.6 * Math.cos(angle) };
});
const starPath = 'M0,-0.85 0.2,-0.26 0.81,-0.26 0.32,0.1 0.5,0.69 0,0.33 -0.5,0.69 -0.32,0.1 -0.81,-0.26 -0.2,-0.26 Z';

const markSquare = 'M47.8331 41.851L5.98219 47.8331L0 5.98219L41.851 0L47.8331 41.851ZM29.3794 20.3663C28.7568 16.0109 24.7216 12.9848 20.3663 13.6073C16.0109 14.2299 12.9849 18.2652 13.6073 22.6205C14.2299 26.9758 18.2651 30.0018 22.6205 29.3794C26.9759 28.7568 30.0019 24.7216 29.3794 20.3663Z';
const markDot = 'M34.1808 25.6463C33.5582 21.2909 29.5228 18.2648 25.1674 18.8874C20.812 19.51 17.7859 23.5454 18.4085 27.9008C19.0311 32.2562 23.0665 35.2822 27.4219 34.6597C31.7773 34.0371 34.8033 30.0017 34.1808 25.6463Z';
---

<footer class="footer">
  <div class="footer__inner container">

    <!-- straddles the footer's top edge: dark half sits on the light section, white half on the black footer -->
    <div class="footer__mark" aria-hidden="true">
      <svg class="footer__mark-half footer__mark-half--above" viewBox="0 0 48 48" fill="none">
        <path d={markSquare} fill="var(--color-text-primary)" />
        <path d={markDot} fill="var(--color-accent)" />
      </svg>
      <svg class="footer__mark-half footer__mark-half--below" viewBox="0 0 48 48" fill="none">
        <path d={markSquare} fill="#ffffff" />
        <path d={markDot} fill="var(--color-accent)" />
      </svg>
    </div>

    <div class="footer__top">
     <a href={lang === 'de' ? '/de/' : '/'} class="nav__logo" aria-label="inplicit.ai home">
      <img class="footer__logo-img" src="/logo-inverted.png" alt="inplicit.ai" width="794" height="232" />
    </a>

      <!-- <ul class="footer__social" role="list">
        <li>
          <a
            href="https://linkedin.com/company/inplicit-ai"
            target="_blank"
            rel="noopener noreferrer"
            class="footer__social-btn"
            aria-label="LinkedIn"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </li>
      </ul> -->
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">© {year} inplicit.ai</p>

      <nav class="footer__nav" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
        {mainLinks.map((link) => (
          <a href={link.href} class="footer__nav-link">{link.label}</a>
        ))}
      </nav>

      <nav class="footer__legal" aria-label={lang === 'de' ? 'Rechtliches' : 'Legal'}>
        {legalLinks.map((link) => (
          <a href={link.href} class="footer__legal-link">{link.label}</a>
        ))}
        <button type="button" class="footer__legal-link footer__legal-btn" data-consent-open>
          {lang === 'de' ? 'Cookie-Einstellungen' : 'Cookie settings'}
        </button>
      </nav>
    </div>

    <p class="footer__origin">
      {lang === 'de' ? 'Mit Liebe in Europa gebaut' : 'Shipped from Europe with love'}
      <svg class="footer__flag" width="24" height="16" viewBox="0 0 24 16" aria-label={lang === 'de' ? 'Europäische Union' : 'European Union'} role="img">
        <rect width="24" height="16" rx="1.5" fill="#003399" />
        {euStars.map((s) => (
          <path d={starPath} fill="#FFCC00" transform={`translate(${s.x} ${s.y})`} />
        ))}
      </svg>
    </p>

  </div>
</footer>

<script>
  document.querySelector('[data-consent-open]')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('implicit:open-consent'));
  });
</script>

<style>
  .footer {
    --footer-pad-top: var(--space-24);
    --mark-size: 120px;
    background-color: #0a0a0a;
    border-top: none;
    padding: var(--footer-pad-top) 0 var(--space-16);
    color: #ffffff;
  }

  .footer__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .footer__mark {
    position: absolute;
    right: 0;
    top: calc(-1 * var(--footer-pad-top));
    width: var(--mark-size);
    height: var(--mark-size);
    transform: translateY(-50%);
  }

  .footer__mark-half {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .footer__mark-half--above { clip-path: inset(0 0 50% 0); }
  .footer__mark-half--below { clip-path: inset(50% 0 0 0); }

    .nav__logo {
    display: flex;
    align-items: center;
    transition: opacity 0.15s var(--ease-smooth);
  }

  .nav__logo:hover { opacity: 0.7; }

  .footer__logo-img {
    height: 24px;
    width: auto;
    display: block;
  }

  .footer__social {
    display: flex;
    list-style: none;
    gap: var(--space-2);
  }

  .footer__social-btn {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-ui);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-tertiary);
    transition: color 0.15s var(--ease-smooth), border-color 0.15s var(--ease-smooth);
  }

  .footer__social-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-tertiary);
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .footer__copy {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.35);
    margin-right: auto;
    font-variant-numeric: tabular-nums;
  }

  .footer__nav,
  .footer__legal {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer__nav-link {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.15s var(--ease-smooth);
  }

  .footer__nav-link:hover { color: #ffffff; }

  .footer__legal-link {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.35);
    transition: color 0.15s var(--ease-smooth);
  }

  .footer__legal-link:hover { color: rgba(255, 255, 255, 0.6); }

  .footer__legal-btn {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  .footer__origin {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.35);
  }

  .footer__flag {
    display: block;
    border-radius: 2px;
  }

  @media (max-width: 640px) {
    .footer {
      --footer-pad-top: var(--space-16);
      --mark-size: 80px;
      padding: var(--footer-pad-top) 0 var(--space-12);
    }
    .footer__logo-img { height: 20px; }
    .footer__bottom { flex-direction: column; align-items: flex-start; }
    .footer__copy { margin-right: 0; }
  }
</style>
