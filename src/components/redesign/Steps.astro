---
// Drei Schritte, jeweils mit dem passenden Produktfenster: Chat, Interview
// mit dem pulsierenden KI-Orb, Einblicke. Die Fenster stehen offen — der
// Hover veraendert nur die Bewegung, er klappt nichts auf.
export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

const t = isDE ? {
  eyebrow: 'Die Lösung',
  h1: 'Sie stellen eine Frage.',
  h2: 'Ihre Organisation antwortet.',
  s1: { n: '01', title: 'Frage stellen', body: 'Sie beschreiben, was Sie herausfinden wollen, und legen fest, welche Mitarbeitenden dazu befragt werden.' },
  s2: { n: '02', title: 'Mitarbeitende antworten', body: 'Die KI führt hunderte Interviews gleichzeitig. Anonym, mit echten Rückfragen, wann es der Person passt.' },
  s3: { n: '03', title: 'Einblick erhalten', body: 'Aus den Gesprächen entsteht ein belastbares Bild: Muster, Widersprüche, Prioritäten. Mit Belegen.' },
  agent: 'Inplicit KI',
  prompt: 'Was möchten Sie herausfinden?',
  question: 'Wo verlieren wir die meiste Zeit?',
  typing: 'tippt …',
  interview: 'Interview',
  ask: 'Wann hakt es bei einem Eilauftrag zuerst?',
  answer: '„Bei Eilaufträgen rufe ich direkt in der Buchhaltung an, sonst wartet die Freigabe zwei Tage."',
  followup: 'Und wenn die Person im Urlaub ist?',
  insights: 'Einblicke',
  themes: [
    { l: 'Freigaben hängen', v: 100 },
    { l: 'Doppelte Erfassung', v: 78 },
    { l: 'Übergaben unklar', v: 58 },
  ],
  slices: [
    { l: 'Problem', v: 47 },
    { l: 'Idee', v: 31 },
    { l: 'Chance', v: 22 },
  ],
  planHead: 'Kampagne fertig konzipiert',
  planItems: [
    'Abstimmungen und Rückfragen',
    'Freigaben und Wartezeiten',
    'Doppelte Erfassung',
    'Werkzeug- und Systemwechsel',
    'Übergaben zwischen Teams',
  ],
} : {
  eyebrow: 'How it works',
  h1: 'You ask a question.',
  h2: 'Your organisation answers.',
  s1: { n: '01', title: 'Ask one question', body: 'You describe what you want to find out and choose which people should be interviewed.' },
  s2: { n: '02', title: 'People answer', body: 'The AI runs hundreds of interviews at once. Anonymous, with real follow-ups, whenever it suits the person.' },
  s3: { n: '03', title: 'Get the picture', body: 'The conversations turn into solid evidence: patterns, contradictions, priorities. Traceable to the source.' },
  agent: 'Inplicit AI',
  prompt: 'What do you want to find out?',
  question: 'Where do we lose the most time?',
  typing: 'typing …',
  interview: 'Interview',
  ask: 'Where does a rush order stall first?',
  answer: '“For rush orders I call finance directly, otherwise approval waits two days.”',
  followup: 'And when that person is on holiday?',
  insights: 'Insights',
  themes: [
    { l: 'Approvals stall', v: 100 },
    { l: 'Duplicate entry', v: 78 },
    { l: 'Unclear handovers', v: 58 },
  ],
  slices: [
    { l: 'Problem', v: 47 },
    { l: 'Idea', v: 31 },
    { l: 'Opportunity', v: 22 },
  ],
  planHead: 'Campaign ready',
  planItems: [
    'Coordination and follow-up queries',
    'Approvals and waiting time',
    'Duplicate entry',
    'Switching tools and systems',
    'Handovers between teams',
  ],
};

// Ring in Karte 3: Boegen als Kreisumfang gerechnet, damit sie sich beim
// Sichtbarwerden und beim Hover zeichnen lassen.
const RING_R = 27;
const RING_C = 2 * Math.PI * RING_R;
const RING_GAP = 3;
const HUES = ['var(--color-accent-dark)', '#5856d6', 'var(--brand-periwinkle)'];
let ringAcc = 0;
const arcs = t.slices.map((sl, i) => {
  const start = (ringAcc / 100) * RING_C;
  ringAcc += sl.v;
  const len = Math.max(1, (sl.v / 100) * RING_C - RING_GAP);
  return { hue: HUES[i], dash: `${len} ${RING_C - len}`, offset: -start, delay: 0.2 + i * 0.16 };
});
---

<section class="steps" id="so-gehts">
  <div class="container">
    <div class="steps__head section-fade">
      <p class="rlabel">{t.eyebrow}</p>
      <h2 class="steps__heading">
        <span>{t.h1}</span>
        <span>{t.h2}</span>
      </h2>
    </div>

    <div class="steps__grid">
      <article class="steps__card section-fade" tabindex="0">
        <span class="steps__num">{t.s1.n}</span>
        <h3 class="steps__title">{t.s1.title}</h3>
        <p class="steps__body">{t.s1.body}</p>

        <div class="steps__reveal"><div class="steps__reveal-in">
          <div class="win">
            <div class="win__bar"><i class="win__dot"></i>{t.agent}</div>
            <div class="win__body">
              <p class="win__label">{t.prompt}</p>
              <p class="win__typed">
                <span class="win__q" style={`--len: ${t.question.length}`}>{t.question}</span><i class="win__caret"></i>
              </p>
              <div class="win__foot">
                <span class="win__hint">{t.typing}</span>
                <span class="win__send" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none"><path d="M8 12.5V4M4.5 7.5L8 4l3.5 3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </div>
            </div>
            <span class="win__pointer" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5.5 3.5l13.5 7.8-6.1 1.3-2.7 5.9z" fill="#0b0c10" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg>
            </span>

            <div class="plan"><div class="plan__in">
              <p class="plan__head">
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {t.planHead}
              </p>
              <ul class="plan__list">
                {t.planItems.map((item, i) => (
                  <li style={`--i:${i}`}>{item}</li>
                ))}
              </ul>
            </div></div>
          </div>
        </div></div>
      </article>

      <article class="steps__card section-fade" style="--delay: 70ms" tabindex="0">
        <span class="steps__num">{t.s2.n}</span>
        <h3 class="steps__title">{t.s2.title}</h3>
        <p class="steps__body">{t.s2.body}</p>

        <div class="steps__reveal"><div class="steps__reveal-in">
          <div class="win">
            <div class="win__bar"><i class="win__dot"></i>{t.interview}</div>
            <div class="win__body win__body--chat">
              <div class="chat__head">
                <span class="orb" aria-hidden="true">
                  <canvas class="orb__canvas" data-orb></canvas>
                  <span class="orb__ring"></span>
                </span>
                <span class="chat__who">{t.agent}</span>
              </div>
              <div class="msg">
                <span class="msg__mark" aria-hidden="true">
                  <svg viewBox="5 5 34 34" xmlns="http://www.w3.org/2000/svg">
                    <path d="M37.71 33.80 L10.24 37.71 L6.31 10.24 L33.80 6.31 Z" fill="#0B0C10"/>
                    <circle cx="20.41" cy="20.38" r="5.23" fill="#FFFFFF"/>
                    <circle cx="23.59" cy="23.90" r="5.23" fill="#FCA157"/>
                  </svg>
                </span>
                <span class="bub bub--agent">{t.ask}</span>
              </div>
              <div class="msg msg--self">
                <span class="bub bub--self">{t.answer}</span>
                <img class="msg__face" src="/people/s7.png" alt="" width="52" height="52" loading="lazy" decoding="async" />
              </div>
              <div class="msg msg--late">
                <span class="msg__mark" aria-hidden="true">
                  <svg viewBox="5 5 34 34" xmlns="http://www.w3.org/2000/svg">
                    <path d="M37.71 33.80 L10.24 37.71 L6.31 10.24 L33.80 6.31 Z" fill="#0B0C10"/>
                    <circle cx="20.41" cy="20.38" r="5.23" fill="#FFFFFF"/>
                    <circle cx="23.59" cy="23.90" r="5.23" fill="#FCA157"/>
                  </svg>
                </span>
                <span class="bub bub--agent bub--late">{t.followup}</span>
              </div>
            </div>
          </div>
        </div></div>
      </article>

      <article class="steps__card section-fade" style="--delay: 140ms" tabindex="0">
        <span class="steps__num">{t.s3.n}</span>
        <h3 class="steps__title">{t.s3.title}</h3>
        <p class="steps__body">{t.s3.body}</p>

        <div class="steps__reveal"><div class="steps__reveal-in">
          <div class="win">
            <div class="win__bar"><i class="win__dot"></i>{t.insights}</div>
            <div class="win__body">
              {t.themes.map((th, i) => (
                <div class="theme" style={`--w: ${th.v}%; --i: ${i}`}>
                  <span class="theme__l">{th.l}</span>
                  <span class="theme__track"><i></i></span>
                </div>
              ))}

              <div class="ring">
                <svg class="ring__svg" viewBox="0 0 72 72" role="img" aria-label={t.slices.map((x) => `${x.l} ${x.v} Prozent`).join(', ')}>
                  <g transform="rotate(-90 36 36)" fill="none" stroke-width="9">
                    {arcs.map((a) => (
                      <circle cx="36" cy="36" r={RING_R} stroke={a.hue} stroke-dashoffset={a.offset} style={`--dash:${a.dash}; --d:${a.delay}s`} />
                    ))}
                  </g>
                </svg>
                <ul class="ring__legend">
                  {t.slices.map((x, i) => (
                    <li><span class="ring__key"><i style={`background:${HUES[i]}`}></i>{x.l}</span><span class="ring__pct">{x.v} %</span></li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div></div>
      </article>
    </div>
  </div>
</section>

<script>
  // Der echte Orb aus dem Produkt (WebGL), nicht die CSS-Nachbildung.
  // Die Nachbildung bleibt als Rueckfall, falls WebGL fehlt.
  import { createImplicitOrb } from '../../scripts/orb.js';

  const host = document.querySelector<HTMLElement>('.orb');
  const canvas = host?.querySelector<HTMLCanvasElement>('canvas[data-orb]');
  if (host && canvas) {
    const orb = createImplicitOrb(canvas, { level: 0.38 });
    if (orb.supported) {
      host.classList.add('is-live');
      const io = new IntersectionObserver(
        (entries) => { entries[0].isIntersecting ? orb.start() : orb.stop(); },
        { threshold: 0.1 }
      );
      io.observe(host);
    }
  }
</script>

<style>
  .steps {
    padding: var(--space-section) 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .steps__head { text-align: center; margin-bottom: var(--space-16); }
  .steps__heading { margin-top: var(--space-4); }

  .steps__heading {
    display: flex;
    flex-direction: column;
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .steps__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    /* Fenster stehen dauerhaft offen, deshalb gleiche Kartenhoehe */
    align-items: stretch;
  }

  .steps__card {
    padding: var(--space-8) var(--space-8) var(--space-10);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    transition: border-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .steps__card:hover,
  .steps__card:focus-visible,
  .steps__card:focus-within {
    border-color: var(--color-accent-muted, rgba(252, 161, 87, 0.36));
    box-shadow: 0 16px 38px -24px rgba(11, 12, 16, 0.24);
    outline: none;
  }

  .steps__num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-6);
    border-radius: 50%;
    background: rgba(252, 161, 87, 0.16);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .steps__title {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .steps__body { font-size: var(--text-base); line-height: 1.6; color: var(--color-text-secondary); }

  /* ── Produktfenster: steht offen, klappt nicht auf ─────────────────── */
  .steps__reveal { display: grid; }
  .steps__reveal-in { min-height: 0; }

  .win {
    margin-top: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s var(--ease-out) 0.1s, transform 0.45s var(--ease-out) 0.1s,
                box-shadow 0.3s var(--ease-out);
  }
  .steps__card.is-visible .win { opacity: 1; transform: none; }
  .steps__card:hover .win { box-shadow: 0 12px 28px -20px rgba(11, 12, 16, 0.3); }

  /* Der Zeiger faehrt beim Hover zum Senden-Knopf und klickt. */
  .win { position: relative; }
  .win__pointer {
    position: absolute;
    left: 22%;
    bottom: 2px;
    width: 15px;
    height: 15px;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 2px 4px rgba(11, 12, 16, 0.3));
  }
  .steps__card:hover .win__pointer { animation: win-point 2.4s var(--ease-out) both; }
  @keyframes win-point {
    0%   { opacity: 0; left: 22%; bottom: -10px; }
    22%  { opacity: 1; left: 30%; bottom: 6px; }
    58%  { opacity: 1; left: calc(100% - 34px); bottom: 15px; }
    66%  { opacity: 1; left: calc(100% - 34px); bottom: 11px; }
    74%  { opacity: 1; left: calc(100% - 34px); bottom: 15px; }
    100% { opacity: 0; left: calc(100% - 34px); bottom: 15px; }
  }
  .win__send { position: relative; }
  .steps__card:hover .win__send::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    animation: win-click 0.55s var(--ease-out) 1.56s both;
  }
  @keyframes win-click {
    from { opacity: 0.85; transform: scale(0.65); }
    to { opacity: 0; transform: scale(1.3); }
  }

  .orb__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }
  .orb.is-live .orb__canvas { display: block; }
  .orb.is-live .orb__ring,
  .orb.is-live::before { display: none; }

  .win__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-secondary);
  }
  .win__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); }

  .win__body { padding: 14px 13px 13px; }
  .win__label { font-size: var(--text-xs); color: var(--color-text-tertiary); }

  .win__typed { display: flex; align-items: flex-end; gap: 2px; margin-top: 10px; }
  .win__q {
    display: inline-block;
    max-width: calc(var(--len) * 1ch);
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .steps__card:hover .win__q { animation: win-type 1.25s steps(30) 0.15s both; }
  @keyframes win-type { from { max-width: 0; } to { max-width: calc(var(--len) * 1ch); } }

  .win__caret {
    width: 2px;
    height: 17px;
    background: var(--color-accent);
    animation: win-blink 1.05s steps(1) infinite;
  }
  @keyframes win-blink { 50% { opacity: 0; } }

  .win__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
  }
  .win__hint { font-size: 11px; color: var(--color-text-tertiary); }
  .win__send {
    display: grid;
    place-items: center;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-text-primary);
  }
  .win__send svg { width: 15px; height: 15px; }

  /* ── Interview ─────────────────────────────────────────────────────── */
  .win__body--chat { display: flex; flex-direction: column; gap: 9px; }

  /* Der Orb sitzt ueber dem Gespraech, nicht neben der ersten Blase:
     er ist der Absender des ganzen Interviews, nicht einer Zeile. */
  .chat__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding-bottom: 13px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--color-border);
  }
  .chat__who {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-text-secondary);
  }

  .orb {
    position: relative;
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    animation: orb-pulse 2.8s ease-in-out infinite;
  }
  @keyframes orb-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.07); }
  }
  .orb__ring,
  .orb::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    /* Farben aus orb.js, Basiswerte nach der Standard-Hue-Drehung von 28° */
    background: conic-gradient(from 210deg, #44d698, #7255ff, #00297c, #7255ff, #44d698);
    -webkit-mask: radial-gradient(circle, transparent 56%, #000 57%);
    mask: radial-gradient(circle, transparent 56%, #000 57%);
    animation: orb-spin 7s linear infinite;
  }
  .orb::before { filter: blur(7px); opacity: 0.65; }
  @keyframes orb-spin { to { transform: rotate(1turn); } }

  /* Hover aendert nur das Tempo, nichts klappt auf. */
  .steps__card:hover .orb { animation-duration: 1.9s; }
  .steps__card:hover .orb__ring,
  .steps__card:hover .orb::before { animation-duration: 4s; }

  .bub {
    display: inline-block;
    max-width: 92%;
    padding: 8px 11px;
    border-radius: 10px;
    font-size: 0.78rem;
    line-height: 1.45;
  }
  .bub--agent { background: var(--color-bg); color: var(--color-text-primary); }
  .bub--self { background: #5856d6; color: #fff; }

  /* Zeile im Gespraech: links die Bildmarke, rechts das Profilbild. */
  .msg { display: flex; align-items: flex-end; gap: 8px; }
  .msg--self { justify-content: flex-end; }
  .msg .bub { max-width: calc(100% - 32px); }
  .msg__mark {
    flex: 0 0 auto;
    width: 22px; height: 22px;
    display: grid; place-items: center;
  }
  .msg__mark svg { width: 22px; height: 22px; overflow: visible; }
  .msg__face {
    flex: 0 0 auto;
    width: 26px; height: 26px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  /* Karte 1: nach dem simulierten Klick waechst der Plan auf. */
  .plan { display: grid; grid-template-rows: 0fr; }
  .plan__in { overflow: hidden; min-height: 0; padding: 0 13px; }
  .steps__card:hover .plan { animation: plan-open 0.5s var(--ease-out) 1.85s both; }
  @keyframes plan-open { from { grid-template-rows: 0fr; } to { grid-template-rows: 1fr; } }

  .plan__head {
    display: flex; align-items: center; gap: 7px;
    padding: 12px 0 9px;
    border-top: 1px solid var(--color-border);
    font-size: 12px; font-weight: 600;
    color: var(--color-accent-dark);
  }
  .plan__head svg { width: 14px; height: 14px; flex: 0 0 auto; }
  .plan__list { list-style: none; padding-bottom: 13px; }
  .plan__list li {
    padding: 5px 0 5px 12px;
    border-left: 2px solid rgba(252, 161, 87, 0.45);
    margin-bottom: 4px;
    font-size: 11.5px;
    line-height: 1.35;
    color: var(--color-text-secondary);
    opacity: 0;
  }
  .steps__card:hover .plan__list li {
    animation: plan-item 0.34s var(--ease-out) backwards;
    animation-delay: calc(2.1s + var(--i) * 0.09s);
    animation-fill-mode: forwards;
  }
  @keyframes plan-item {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: none; }
  }

  /* Karte 3: Ring unter den Balken, nur auf dem Desktop. */
  .ring { display: none; }
  .ring__svg { width: 76px; height: 76px; flex: 0 0 auto; }
  .ring__svg circle {
    stroke-dasharray: 0 400;
    transition: stroke-dasharray 0.8s var(--ease-out);
    transition-delay: var(--d, 0s);
  }
  .steps__card.is-visible .ring__svg circle { stroke-dasharray: var(--dash); }
  .steps__card:hover .ring__svg circle {
    animation: ring-draw 0.8s var(--ease-out) backwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes ring-draw { from { stroke-dasharray: 0 400; } to { stroke-dasharray: var(--dash); } }
  .ring__legend { flex: 1 1 auto; display: flex; flex-direction: column; gap: 5px; list-style: none; }
  .ring__legend li { display: flex; align-items: center; justify-content: space-between; font-size: 11px; }
  .ring__key { display: inline-flex; align-items: center; gap: 7px; color: var(--color-text-secondary); }
  .ring__key i { width: 9px; height: 9px; border-radius: 2px; }
  .ring__pct { font-weight: 500; }

  @media (min-width: 1024px) {
    .ring {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 14px;
      padding-top: 13px;
      border-top: 1px solid var(--color-border);
    }
  }
  .steps__card:hover .bub { animation: bub-in 0.4s var(--ease-out) backwards; }
  .steps__card:hover .chat__head { animation: bub-in 0.4s var(--ease-out) backwards; }
  .steps__card:hover .bub--self { animation-delay: 0.8s; }
  .steps__card:hover .bub--late { animation-delay: 1.45s; }
  @keyframes bub-in {
    from { opacity: 0; transform: translateY(7px); }
    to { opacity: 1; transform: none; }
  }

  /* ── Einblicke ─────────────────────────────────────────────────────── */
