---
// Die drei Zusagen, die im deutschen Enterprise-Vertrieb zuerst gefragt werden.
// Deutschlandflagge fuer das Hosting, Schild im Sternenkranz fuer die DSGVO,
// EU-Flagge fuer den AI Act.
export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

const stars = Array.from({ length: 12 }, (_, i) => i * 30);

const items = isDE ? [
  { k: 'de', t: 'Daten in Deutschland gehostet', s: 'Alle Gesprächsdaten auf deutschen Servern' },
  { k: 'shield', t: 'DSGVO-konform', s: 'AV-Vertrag, Betriebsrat-ready' },
  { k: 'eu', t: 'EU AI Act konform', s: 'Transparenzpflichten erfüllt' },
] : [
  { k: 'de', t: 'Hosted in Germany', s: 'All conversation data on German servers' },
  { k: 'shield', t: 'GDPR compliant', s: 'Data processing agreement, works-council ready' },
  { k: 'eu', t: 'EU AI Act compliant', s: 'Transparency obligations met' },
];
---

<section class="comp">
  <div class="container comp__row">
    {items.map((it) => (
      <div class="comp__item">
        <span class:list={['comp__badge', `comp__badge--${it.k}`]} aria-hidden="true">
          {it.k !== 'de' && stars.map((deg) => (
            <i class="comp__star" style={`--deg:${deg}deg`}>★</i>
          ))}
          {it.k === 'shield' && (
            <svg class="comp__shield" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3l7 3v5.5c0 4.2-2.9 7.6-7 8.5-4.1-.9-7-4.3-7-8.5V6l7-3z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/>
            </svg>
          )}
        </span>
        <span class="comp__text">
          <span class="comp__t">{it.t}</span>
          <span class="comp__s">{it.s}</span>
        </span>
      </div>
    ))}
  </div>
</section>

<style>
  /* Sitzt direkt ueber dem dunklen Footer und geht optisch in ihn ueber. */
  .comp {
    padding: var(--space-12) 0 var(--space-10);
    background: #0a0a0a;
  }

  .comp__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .comp__item { display: flex; align-items: center; gap: var(--space-4); }

  .comp__badge {
    position: relative;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
  }

  .comp__badge--de {
    background: linear-gradient(180deg, #000 0 33.33%, #dd0000 33.33% 66.66%, #ffce00 66.66% 100%);
  }
  .comp__badge--eu,
  .comp__badge--shield { background: #003399; overflow: visible; }

  .comp__star {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    font-size: 7px;
    line-height: 0;
    color: #ffcc00;
    font-style: normal;
    transform: rotate(var(--deg)) translateY(-14px) rotate(calc(-1 * var(--deg)));
  }

  .comp__shield { width: 19px; height: 19px; }

  .comp__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .comp__t { font-size: var(--text-sm); font-weight: 500; color: #f0f1f3; }
  .comp__s { font-size: var(--text-sm); color: rgba(255, 255, 255, 0.56); }

  @media (max-width: 1023px) {
    .comp__row { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
  }
</style>
