---
export interface Props {
  lang?: 'en' | 'de';
  href?: string;
  /** Unterseiten (Preview) setzen eigene Texte; ohne Angabe bleibt die Startseite gleich. */
  lines?: [string, string];
  sub?: string;
  label?: string;
}
const { lang = 'en', href, lines, sub, label } = Astro.props;
const isDE = lang === 'de';
const target = href ?? (isDE ? '/de/call' : '/call');
const heading = lines ?? (isDE ? ['Starten Sie mit einem Team', 'und einer Frage.'] : ['Start with one team', 'and one question.']);
---

<section class="close">
  <div class="container close__inner section-fade">
    <h2 class="close__heading">
      <span>{heading[0]}</span>
      <span>{heading[1]}</span>
    </h2>
    <p class="close__sub">
      {sub ?? (isDE
        ? 'Die erste Kampagne kann bei einem Prozess ansetzen, bei einer Entscheidung oder bei einem Bereich. Was Sie dabei erfahren, bleibt nutzbar, wenn der Rahmen später wächst.'
        : 'The first campaign can focus on a single process, a single decision or a single part of the organisation. What you learn stays useful as the scope grows.')}
    </p>
    <a href={target} class="close__cta">
      <span>{label ?? (isDE ? 'Demo buchen' : 'Book a demo')}</span>
      <i aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h9M8.5 4.5L12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </i>
    </a>
  </div>
</section>

<style>
  .close {
    padding: clamp(5rem, 10vw, 8.5rem) 0;
    background: var(--color-canvas-dark, #0b0c10);
  }
  .close__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .close__heading {
    display: flex;
    flex-direction: column;
    color: #fff;
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.04em;
  }
  .close__sub {
    max-width: 52ch;
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.64);
  }
  .close__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    height: 56px;
    margin-top: var(--space-10);
    padding: 0 6px 0 var(--space-8);
    background: var(--color-cta-bg);
    /* Label bewusst in Weiss (Figma-Vorgabe). Hinweis:
       Weiss auf Signal Orange erreicht die AA-Schwelle nicht. */
    color: #fff;
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    border-radius: var(--radius-full, 999px);
    transition: background-color 0.25s var(--ease-out);
  }
  .close__cta:hover { background: var(--color-cta-hover); }
  .close__cta i {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-cta-text);
    color: var(--color-cta-bg);
    transition: transform 0.25s var(--ease-out);
  }
  .close__cta:hover i { transform: translateX(3px); }

  /* Der feste Umbruch nach "Team" ist eine Desktop-Komposition. Auf dem
     Handy passt die erste Zeile nicht mehr und bricht ein zweites Mal, dann
     steht "Team" allein. Dort laeuft der Satz deshalb frei. */
  @media (max-width: 767px) {
    .close__heading {
      display: block;
      font-size: clamp(1.875rem, 8.4vw, 2.5rem);
      text-wrap: balance;
    }
    .close__heading span { display: inline; }
  }

  @media (prefers-reduced-motion: reduce) {
    .close__cta, .close__cta i { transition: none; }
  }
</style>
