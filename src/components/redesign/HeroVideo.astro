---
// Vollflaechiger Video-Hero. Bis zum ersten Scroll zeigt die Seite nur das
// weisse Logo (aus Nav.astro) und die Headline — Pillbar und Aktionen blenden
// sich erst per .scrolled ein, genau wie auf der alten Seite.
export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';
---

<section class="rhero" id="hero">
  <div class="rhero__bg" aria-hidden="true">
    <video
      class="rhero__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/hero-people-poster.jpg"
    >
      <source src="/hero-people.mp4" type="video/mp4" />
    </video>
    <span class="rhero__scrim"></span>
  </div>

  <div class="rhero__inner container">
    <h1 class="rhero__headline">
      {isDE ? (
        <>
          <span class="rhero__line">Ihre Organisation.</span>
          <span class="rhero__line">In Stunden verstanden.</span>
        </>
      ) : (
        <>
          <span class="rhero__line">Your organisation.</span>
          <span class="rhero__line">Understood in hours.</span>
        </>
      )}
    </h1>
  </div>
</section>

<style>
  .rhero {
    position: relative;
    isolation: isolate;
    display: flex;
    /* Headline sitzt im unteren Drittel, damit das Gesicht im Video frei bleibt */
    align-items: flex-end;
    padding-bottom: clamp(5rem, 15vh, 10rem);
    height: 100svh;
    min-height: 620px;
    max-height: 940px;
    overflow: hidden;
  }

  .rhero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-canvas-dark, #0b0c10);
  }

  .rhero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Zwei Verlaeufe: von unten abdunkeln, dazu links, damit die linksbuendige
     Headline auch ueber der hellen Warnweste steht. */
  .rhero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(11, 12, 16, 0.58) 0%, rgba(11, 12, 16, 0.22) 44%, rgba(11, 12, 16, 0) 68%),
      linear-gradient(0deg, rgba(11, 12, 16, 0.62) 0%, rgba(11, 12, 16, 0.18) 52%, rgba(11, 12, 16, 0.08) 100%);
  }

  .rhero__inner {
    position: relative;
    width: 100%;
  }

  .rhero__headline {
    display: flex;
    flex-direction: column;
    max-width: 16ch;
    color: #fff;
    font-size: clamp(2.5rem, 6.2vw, 5.4rem);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.045em;
  }

  .rhero__line {
    opacity: 0;
    transform: translateY(18px);
    animation: rhero-in 0.85s var(--ease-out) forwards;
  }
  .rhero__line:nth-child(2) { animation-delay: 0.09s; }

  @keyframes rhero-in {
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 767px) {
    .rhero { height: 88svh; min-height: 540px; }
    .rhero__headline { max-width: 100%; letter-spacing: -0.035em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rhero__line { animation: none; opacity: 1; transform: none; }
    .rhero__video { display: none; }
  }
</style>
