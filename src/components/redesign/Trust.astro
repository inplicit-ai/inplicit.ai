---
import TrustBadge from './TrustBadge.astro';

export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

const pillars = isDE ? [
  { kind: 'de' as const, label: 'Deutschlandflagge', t: 'Daten in Deutschland gehostet', b: 'Alle Gesprächsdaten liegen auf deutschen Servern. Kein Transfer in Drittstaaten für Kernprozesse.' },
  { kind: 'gdpr' as const, label: 'DSGVO-Signet', t: 'DSGVO-konform', b: 'Auftragsverarbeitungsvertrag, klare Rechtsgrundlagen, Betriebsrat-ready. Mitarbeitende entscheiden selbst, was sie teilen, ausgewertet wird nur anonymisiert.' },
  { kind: 'eu' as const, label: 'Europaflagge', t: 'EU AI Act konform', b: 'Transparenzpflichten erfüllt, Zweckbindung dokumentiert. Alles, was Euer Unternehmen für den rechtssicheren Einsatz braucht.' },
] : [
  { kind: 'de' as const, label: 'German flag', t: 'Hosted in Germany', b: 'All conversation data sits on German servers. No third-country transfer for core processes.' },
  { kind: 'gdpr' as const, label: 'GDPR badge', t: 'GDPR compliant', b: 'Data processing agreement, clear legal basis, works-council ready. People decide what they share, and only anonymised data is analysed.' },
  { kind: 'eu' as const, label: 'European flag', t: 'EU AI Act compliant', b: 'Transparency obligations met, purpose limitation documented. Everything your company needs for compliant use.' },
];
---

<section class="trust" id="datenschutz">
  <div class="container">
    <div class="trust__head section-fade">
      <p class="rlabel">{isDE ? 'Datenschutz' : 'Data protection'}</p>
      <h2 class="trust__heading">{isDE ? 'Eure Daten gehören Euch.' : 'Your data belongs to you.'}</h2>
    </div>
    <div class="trust__grid">
      {pillars.map((p, i) => (
        <div class="trust__col section-fade" style={`--delay: ${i * 70}ms`}>
          <TrustBadge kind={p.kind} label={p.label} size={52} />
          <h3 class="trust__title">{p.t}</h3>
          <p class="trust__body">{p.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust {
    padding: var(--space-section) 0;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }
  .trust__head { text-align: center; margin-bottom: var(--space-16); }
  .trust__heading {
    margin-top: var(--space-4);
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .trust__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .trust__title {
    margin: var(--space-6) 0 var(--space-3);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .trust__body { font-size: var(--text-base); line-height: 1.6; color: var(--color-text-secondary); }

  @media (max-width: 1023px) { .trust__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-10); } }
  @media (max-width: 767px) { .trust { padding: var(--space-24) 0; } .trust__head { margin-bottom: var(--space-12); } }
</style>
