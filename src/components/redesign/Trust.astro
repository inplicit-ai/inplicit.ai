---
export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

const pillars = isDE ? [
  { t: 'DSGVO & EU AI Act', b: 'Auftragsverarbeitungsvertrag, klare Rechtsgrundlagen, Betriebsrat-ready. Alles für den rechtssicheren Einsatz.' },
  { t: 'Daten bleiben in der EU', b: 'Alle Gesprächsdaten liegen auf europäischer Infrastruktur. Kein Transfer in Drittstaaten für Kernprozesse.' },
  { t: 'Freiwillig & anonym', b: 'Mitarbeitende entscheiden selbst, was sie teilen. Ausgewertet wird nur, was freiwillig gegeben und anonymisiert ist.' },
] : [
  { t: 'GDPR & EU AI Act', b: 'Data processing agreement, clear legal basis, works-council ready. Everything you need for compliant use.' },
  { t: 'Data stays in the EU', b: 'All conversation data sits on European infrastructure. No third-country transfer for core processes.' },
  { t: 'Voluntary & anonymous', b: 'People decide what they share. Only what is given voluntarily and fully anonymised is analysed.' },
];
---

<section class="trust" id="sicherheit">
  <div class="container">
    <div class="trust__head section-fade">
      <p class="section-eyebrow">{isDE ? 'Vertrauen & Sicherheit' : 'Trust & security'}</p>
      <h2 class="trust__heading">{isDE ? 'Vertrauen ist das Produkt.' : 'Trust is the product.'}</h2>
    </div>
    <div class="trust__grid">
      {pillars.map((p, i) => (
        <div class="trust__col section-fade" style={`--delay: ${i * 70}ms`}>
          <span class="trust__rule" aria-hidden="true"></span>
          <h3 class="trust__title">{p.t}</h3>
          <p class="trust__body">{p.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust {
    padding: var(--space-section) 0;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }
  .trust__head { text-align: center; margin-bottom: var(--space-16); }
  .trust__heading {
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .trust__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .trust__rule {
    display: block;
    width: 48px;
    height: 2px;
    margin-bottom: var(--space-6);
    border-radius: 2px;
    background: var(--color-accent);
  }
  .trust__title {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .trust__body { font-size: var(--text-base); line-height: 1.6; color: var(--color-text-secondary); }

  @media (max-width: 1023px) { .trust__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-10); } }
  @media (max-width: 767px) { .trust { padding: var(--space-24) 0; } .trust__head { margin-bottom: var(--space-12); } }
</style>
