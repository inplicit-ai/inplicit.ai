---
export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

// Institutions are set as type, not as logos: using university marks needs permission first.
const studies = [
  {
    org: 'Stanford University',
    ref: 'Park et al., 2024 · arXiv:2411.10109',
    title: 'Generative Agent Simulations of 1,000 People',
    href: 'https://arxiv.org/abs/2411.10109',
    de: 'Zweistündige, KI-geführte Interviews mit 1.052 Menschen reichten aus, um deren Antworten im General Social Survey mit 85 % der Genauigkeit vorherzusagen, die die Personen selbst zwei Wochen später erreichen.',
    en: 'Two-hour AI-led interviews with 1,052 people were enough to predict their General Social Survey answers with 85% of the accuracy the people themselves reach two weeks later.',
  },
  {
    org: 'LMU München',
    ref: 'Wuttke et al., 2024 · arXiv:2410.01824',
    title: 'AI Conversational Interviewing',
    href: 'https://arxiv.org/abs/2410.01824',
    de: 'In einem randomisierten Vergleich lieferten KI-Interviewer Daten in vergleichbarer Qualität wie menschliche Interviewer, und das skalierbar.',
    en: 'In a randomised comparison, AI interviewers produced data of comparable quality to human interviewers, at scale.',
  },
  {
    org: 'University of Southern California',
    ref: 'Lucas et al., 2014 · Computers in Human Behavior 37',
    title: "It's only a computer: Virtual humans increase willingness to disclose",
    href: 'https://doi.org/10.1016/j.chb.2014.04.043',
    de: 'Wer glaubte, mit einer Maschine zu sprechen, hatte weniger Angst, sich zu öffnen, und achtete weniger darauf, einen guten Eindruck zu machen.',
    en: 'People who believed they were talking to a machine were less afraid to open up and less concerned with making a good impression.',
  },
  {
    org: 'UIUC · IBM Research',
    ref: 'Xiao et al., 2020 · ACM TOCHI',
    title: 'Tell Me About Yourself: AI-powered conversational surveys',
    href: 'https://doi.org/10.1145/3381804',
    de: 'Im Feldversuch mit rund 600 Teilnehmenden erzeugte das KI-Gespräch deutlich mehr Engagement und bessere offene Antworten als ein klassischer Online-Fragebogen.',
    en: 'In a field study with about 600 participants, the AI conversation drove clearly more engagement and better open answers than a standard online survey.',
  },
  {
    org: 'Harvard Business School',
    ref: "Dell'Acqua et al., 2023 · HBS Working Paper 24-013",
    title: 'Navigating the Jagged Technological Frontier',
    href: 'https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4573321',
    de: 'Berater:innen der BCG erledigten mit KI 12,2 % mehr Aufgaben, rund 25 % schneller und mit 40 % höherer Qualität.',
    en: 'BCG consultants using AI completed 12.2% more tasks, about 25% faster and at 40% higher quality.',
  },
];
---

<section class="rp">
  <div class="container">
    <ul class="rp__orgs" aria-label={isDE ? 'Zitierte Institutionen' : 'Cited institutions'}>
      {studies.map((s) => <li>{s.org}</li>)}
    </ul>
    <div class="rp__grid">
      {studies.map((s) => (
        <a class="rp__card" href={s.href} target="_blank" rel="noopener noreferrer">
          <span class="rp__org">{s.org}</span>
          <p class="rp__finding">{isDE ? s.de : s.en}</p>
          <span class="rp__title">{s.title}</span>
          <span class="rp__ref">{s.ref}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .rp { padding-bottom: var(--space-section); }
  .rp__orgs {
    display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-10); list-style: none;
    padding: var(--space-8) 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);
  }
  .rp__orgs li { font-family: Georgia, 'Times New Roman', serif; font-size: var(--text-lg); color: var(--color-text-secondary); }
  .rp__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-12); }
  .rp__card {
    display: flex; flex-direction: column; padding: var(--space-8);
    background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl);
    transition: border-color 0.15s var(--ease-smooth), box-shadow 0.15s var(--ease-smooth);
  }
  .rp__card:hover { border-color: var(--color-text-tertiary); box-shadow: var(--shadow-md); }
  .rp__org { font-family: Georgia, 'Times New Roman', serif; font-size: var(--text-base); color: var(--color-text-primary); }
  .rp__finding { margin-top: var(--space-4); font-size: var(--text-lg); line-height: 1.45; letter-spacing: -0.015em; flex: 1; }
  .rp__title { margin-top: var(--space-6); font-size: var(--text-sm); font-weight: 500; color: var(--brand-blue); }
  .rp__ref { margin-top: var(--space-1); font-size: var(--text-xs); color: var(--color-text-secondary); }
  @media (max-width: 767px) { .rp__grid { grid-template-columns: minmax(0, 1fr); } .rp__card { padding: var(--space-6); } }
</style>
