---
// Studienkarten nach dem Muster der Sona8-Research-Seite: Quelle und Jahr,
// eine Aussage, eine Zahl oder ein Vergleich, ein Satz, was wir daraus machen.
// Dazu, anders als dort, die Art der Veroeffentlichung (begutachtet oder nicht).
import { studiesDe, studiesEn } from '../../data/studies';

export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';
const studies = isDE ? studiesDe : studiesEn;
const t = isDE
  ? { reviewed: 'Begutachtet', open: 'Nicht begutachtet', ours: 'Was wir daraus machen', read: 'Zur Studie' }
  : { reviewed: 'Peer reviewed', open: 'Not peer reviewed', ours: 'What we take from it', read: 'Read the study' };
---

<section class="rfind" id="studien">
  <div class="container">
    <div class="rfind__head section-fade">
      <p class="rlabel">{isDE ? 'Was Studien zeigen' : 'What studies show'}</p>
      <h2 class="rfind__heading">
        <span>{isDE ? 'Sechs Studien,' : 'Six studies,'}</span>
        <span>{isDE ? 'eine Richtung.' : 'one direction.'}</span>
      </h2>
    </div>

    <div class="rfind__grid">
      {studies.map((s, i) => (
        <article class="rfind__card section-fade" style={`--delay: ${(i % 2) * 70}ms`}>
          <div class="rfind__meta">
            <span>{s.org} · {s.year}</span>
            <span class:list={['rfind__badge', { 'is-reviewed': s.reviewed }]}>{s.reviewed ? t.reviewed : t.open}</span>
          </div>
          <h3 class="rfind__title">{s.title}</h3>

          {s.stat && (
            <div class="rfind__stat">
              <strong>{s.stat.v}</strong>
              <span>{s.stat.l}</span>
            </div>
          )}
          {s.stats && (
            <div class="rfind__stats">
              {s.stats.map((x) => <div><strong>{x.v}</strong><span>{x.l}</span></div>)}
            </div>
          )}
          {s.bars && (
            <div class="rfind__bars">
              {s.bars.items.map((b, j) => (
                <div class="rfind__bar">
                  <span class="rfind__barlabel">{b.l}</span>
                  <span class="rfind__track"><i class:list={{ 'is-ai': j === 1 }} style={`width: ${b.v * 2}%`}></i></span>
                  <b>{isDE ? `${b.v} %` : `${b.v}%`}</b>
                </div>
              ))}
              <p class="rfind__caption">{s.bars.caption}</p>
            </div>
          )}

          <p class="rfind__body">{s.body}</p>
          <div class="rfind__ours">
            <p class="rfind__ourslabel">{t.ours}</p>
            <p>{s.ours}</p>
          </div>
          <a class="rfind__link" href={s.href} target="_blank" rel="noopener noreferrer">{t.read} · {s.venue} ↗</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .rfind {
    padding: var(--space-section) 0;
    background: var(--color-bg);
  }
  .rfind__head { text-align: center; margin-bottom: var(--space-16); }
  .rfind__heading {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-4);
    font-size: clamp(2rem, 3.6vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .rfind__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .rfind__card {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }
  .rfind__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
  }
  .rfind__badge {
    flex-shrink: 0;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    background: var(--color-surface-elevated);
    color: var(--color-text-tertiary);
    letter-spacing: 0.06em;
  }
  .rfind__badge.is-reviewed { background: var(--brand-blue-weak); color: var(--brand-blue); }
  .rfind__title {
    margin: var(--space-4) 0 var(--space-6);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .rfind__stat strong, .rfind__stats strong {
    display: block;
    font-size: clamp(2.5rem, 4.4vw, 3.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .rfind__stat span, .rfind__stats span {
    display: block;
    max-width: 40ch;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }
  .rfind__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .rfind__stats strong { font-size: clamp(1.75rem, 3vw, 2.25rem); }

  .rfind__bars { display: grid; gap: var(--space-3); }
  .rfind__bar {
    display: grid;
    grid-template-columns: 13rem 1fr 3rem;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .rfind__track { height: 12px; border-radius: 4px; background: var(--color-surface-elevated); overflow: hidden; }
  .rfind__track i { display: block; height: 100%; border-radius: 4px; background: var(--color-text-tertiary); }
  .rfind__track i.is-ai { background: var(--color-accent); }
  .rfind__bar b { font-weight: 500; color: var(--color-text-primary); text-align: right; font-variant-numeric: tabular-nums; }
  .rfind__caption { font-size: var(--text-xs); color: var(--color-text-tertiary); }

  .rfind__body {
    margin-top: var(--space-6);
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .rfind__ours {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--color-accent);
    background: var(--color-accent-light);
    border-radius: 0 var(--radius-ui) var(--radius-ui) 0;
    font-size: var(--text-sm);
    line-height: 1.55;
  }
  .rfind__ourslabel {
    margin-bottom: var(--space-1);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-dark);
  }
  .rfind__link {
    margin-top: auto;
    padding-top: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--brand-blue);
  }
  .rfind__link:hover { text-decoration: underline; }

  @media (max-width: 1023px) {
    .rfind__grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 767px) {
    .rfind { padding: var(--space-24) 0; }
    .rfind__head { margin-bottom: var(--space-12); }
    .rfind__card { padding: var(--space-6); }
    .rfind__bar { grid-template-columns: 1fr 3rem; }
    .rfind__barlabel { grid-column: 1 / -1; }
  }
</style>
