---
export interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  ctaHref?: string;
  ctaLabel?: string;
}
const { eyebrow, title, lead, ctaHref, ctaLabel } = Astro.props;
---

<header class="intro">
  <div class="container">
    <p class="rlabel">{eyebrow}</p>
    <h1 class="intro__h">{title}</h1>
    <p class="intro__lead">{lead}</p>
    {ctaHref && <a href={ctaHref} class="intro__cta">{ctaLabel}</a>}
  </div>
</header>

<style>
  .intro { padding: calc(var(--space-section-lg) + var(--space-12)) 0 var(--space-section); }
  .intro__h {
    margin-top: var(--space-4); max-width: 820px;
    font-size: clamp(2.5rem, 5.6vw, var(--text-3xl)); font-weight: 400; line-height: 1.04; letter-spacing: -0.045em;
  }
  .intro__lead { margin-top: var(--space-6); max-width: 600px; font-size: var(--text-lg); line-height: 1.5; color: var(--color-text-secondary); }
  .intro__cta {
    display: inline-flex; align-items: center; height: 48px; margin-top: var(--space-10); padding: 0 var(--space-6);
    font-size: var(--text-base); font-weight: 600; color: var(--color-cta-text); background: var(--color-cta-bg);
    border-radius: var(--radius-ui); transition: background 0.15s var(--ease-smooth);
  }
  .intro__cta:hover { background: var(--color-accent-dark); }
</style>
