---
// Eine Grafik je Studie, rechts neben dem Paper. Zahlen nur, wo die Studie
// sie nennt (Balken, Kennzahlen); sonst eine als "Illustration" markierte
// Skizze des Versuchsaufbaus ohne erfundene Werte.
import type { Study } from '../../data/studies';

export interface Props {
  study: Study;
  lang: 'en' | 'de';
}
const { study: s, lang } = Astro.props;
const isDE = lang === 'de';
const pct = (v: number) => (isDE ? `${v} %` : `${v}%`);
const illu = 'Illustration';
---

<div class="sv">
  {s.bars && (
    <div class="sv__bars">
      {s.bars.items.map((b, j) => (
        <div class="sv__bar">
          <span class="sv__barlabel">{b.l}</span>
          <span class="sv__track"><i class:list={{ 'is-hi': j === 1 }} style={`width: ${b.v}%`}></i></span>
          <b>{pct(b.v)}</b>
        </div>
      ))}
      <p class="sv__caption">{s.bars.caption}</p>
    </div>
  )}

  {s.stats && (
    <div class="sv__stats">
      {s.stats.map((x) => (
        <div class:list={['sv__stat', { 'is-neg': x.v.startsWith('−') }]}>
          <strong>{x.v}</strong>
          <span>{x.l}</span>
        </div>
      ))}
    </div>
  )}

  {s.id === 'usc' && (
    <div class="sv__usc">
      {[
        { who: isDE ? 'Glaubt: ein Mensch steuert' : 'Believes: a person is in control', img: '/people/s4.png', w: [62, 40] },
        { who: isDE ? 'Glaubt: ein Computer steuert' : 'Believes: a computer is in control', img: '/people/s9.png', w: [92, 100, 78, 56] },
      ].map((c) => (
        <div class="sv__col">
          <p class="sv__who">{c.who}</p>
          <div class="sv__thread">
            <img src={c.img} alt="" width="32" height="32" loading="lazy" />
            <div class="sv__bubbles">{c.w.map((w) => <span class="sv__bubble" style={`width: ${w}%`}></span>)}</div>
          </div>
        </div>
      ))}
      <p class="sv__note">{illu}</p>
    </div>
  )}

  {s.id === 'illinois' && (
    <div class="sv__ill">
      <div class="sv__col">
        <p class="sv__who">{isDE ? 'Fragebogen' : 'Survey form'}</p>
        <div class="sv__form">
          <span class="sv__q">{isDE ? 'Was bremst Sie im Alltag?' : 'What slows you down day to day?'}</span>
          <span class="sv__input">{isDE ? 'Abstimmungen.' : 'Meetings.'}</span>
        </div>
      </div>
      <div class="sv__col">
        <p class="sv__who">{isDE ? 'Gespräch' : 'Conversation'}</p>
        <div class="sv__chat">
          <span class="sv__msg is-ai">{isDE ? 'Was bremst Sie im Alltag?' : 'What slows you down day to day?'}</span>
          <span class="sv__msg">{isDE ? 'Abstimmungen, vor allem mit dem Einkauf.' : 'Meetings, mostly with purchasing.'}</span>
          <span class="sv__msg is-ai">{isDE ? 'Woran hängt es dort genau?' : 'What exactly gets stuck there?'}</span>
          <span class="sv__msg">{isDE ? 'Freigaben ab 5.000 € liegen oft eine Woche.' : 'Approvals above €5,000 often wait a week.'}</span>
        </div>
      </div>
      <p class="sv__note">{illu}</p>
    </div>
  )}

  {s.id === 'lmu' && (
    <div class="sv__lmu">
      <div class="sv__side">
        <span class="sv__chip is-ai">{isDE ? 'KI-Interviewer' : 'AI interviewer'}</span>
        <p>{isDE ? 'fragt nicht immer passend nach' : 'does not always follow up well'}</p>
      </div>
      <span class="sv__eq" aria-hidden="true">≈</span>
      <div class="sv__side">
        <span class="sv__chip">{isDE ? 'Mensch' : 'Human'}</span>
        <p>{isDE ? 'hört nicht immer aktiv zu' : 'does not always listen actively'}</p>
      </div>
      <p class="sv__caption sv__span">{isDE ? 'Vergleichbare Datenqualität' : 'Comparable data quality'}</p>
    </div>
  )}
</div>

<style>
  .sv {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100%;
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }
  .sv__caption { font-size: var(--text-xs); color: var(--color-text-tertiary); }
  .sv__note {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .sv__bars { display: grid; gap: var(--space-4); }
  .sv__bar { display: grid; gap: var(--space-2); grid-template-columns: 1fr 5rem; align-items: center; white-space: nowrap; }
  .sv__barlabel { grid-column: 1 / -1; white-space: normal; font-size: var(--text-sm); color: var(--color-text-secondary); }
  .sv__track { height: 28px; border-radius: 6px; background: var(--color-surface-elevated); overflow: hidden; }
  .sv__track i { display: block; height: 100%; border-radius: 6px; background: var(--color-text-tertiary); }
  .sv__track i.is-hi { background: var(--color-accent); }
  .sv__bar b { font-size: var(--text-lg); font-weight: 500; text-align: right; font-variant-numeric: tabular-nums; }

  .sv__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .sv__stat { display: grid; gap: var(--space-2); align-content: start; padding-top: var(--space-4); border-top: 3px solid var(--color-accent); }
  .sv__stat.is-neg { border-top-color: var(--color-text-tertiary); }
  .sv__stat strong { font-size: clamp(1.5rem, 2.6vw, 2rem); font-weight: 400; letter-spacing: -0.04em; }
  .sv__stat span { font-size: var(--text-xs); line-height: 1.45; color: var(--color-text-secondary); }

  .sv__usc, .sv__ill { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .sv__who { margin-bottom: var(--space-3); font-size: var(--text-xs); font-weight: 500; color: var(--color-text-secondary); }
  .sv__thread { display: grid; grid-template-columns: 32px 1fr; gap: var(--space-3); align-items: start; }
  .sv__thread img { border-radius: 50%; background: var(--color-surface-elevated); }
  .sv__bubbles { display: grid; gap: 6px; }
  .sv__bubble { display: block; height: 14px; border-radius: 7px; background: var(--color-accent-muted); }

  .sv__form { display: grid; gap: var(--space-2); padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-ui); }
  .sv__q { font-size: var(--text-xs); font-weight: 500; }
  .sv__input { padding: 6px 8px; border: 1px solid var(--color-border); border-radius: 6px; font-size: var(--text-xs); color: var(--color-text-secondary); }
  .sv__chat { display: grid; gap: 6px; }
  .sv__msg {
    justify-self: end;
    max-width: 90%;
    padding: 6px 10px;
    border-radius: 10px 10px 2px 10px;
    background: var(--color-surface-elevated);
    font-size: var(--text-xs);
    line-height: 1.4;
  }
  .sv__msg.is-ai { justify-self: start; border-radius: 10px 10px 10px 2px; background: var(--color-accent-light); }

  .sv__lmu { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--space-4); align-items: center; text-align: center; }
  .sv__side p { margin-top: var(--space-3); font-size: var(--text-xs); color: var(--color-text-secondary); }
  .sv__chip { display: inline-block; padding: 8px 14px; border-radius: var(--radius-full); background: var(--color-surface-elevated); font-size: var(--text-sm); font-weight: 500; }
  .sv__chip.is-ai { background: var(--color-accent); color: var(--color-cta-text); }
  .sv__eq { font-size: var(--text-2xl); font-weight: 300; color: var(--color-text-tertiary); }
  .sv__span { grid-column: 1 / -1; }

  @media (max-width: 767px) {
    .sv { padding: var(--space-6); }
    .sv__stats, .sv__usc, .sv__ill { grid-template-columns: minmax(0, 1fr); }
  }
</style>
