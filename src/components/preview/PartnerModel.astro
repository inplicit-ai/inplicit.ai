---
export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

// ⚠ Draft: tier names, shares and prices are placeholders until the partner licence model is final.
const tiers = isDE ? [
  { tag: '01', name: 'Empfehlungspartner', who: 'Für Beratungen, die Kunden zu uns bringen wollen', share: '[XX] % Provision', on: 'auf den ersten Jahresumsatz', points: ['Sie empfehlen, wir liefern das Projekt', 'Keine Einarbeitung nötig', 'Transparentes Tracking pro Empfehlung'] },
  { tag: '02', name: 'Lizenzpartner', who: 'Für Beratungen, die Inplicit selbst im Projekt einsetzen', share: '[XX] % Partnermarge', on: 'auf jede Lizenz, die Sie weiterverkaufen', points: ['Eigener Workspace für Ihre Kundenprojekte', 'Zertifizierung für Ihr Team', 'Sie behalten Kundenbeziehung und Interpretation'], featured: true },
  { tag: '03', name: 'Strategischer Partner', who: 'Für Beratungen mit vielen Mandaten pro Jahr', share: 'Volumenlizenz', on: 'Konditionen auf Anfrage', points: ['Eigene Methodik und Fragenbibliothek', 'Co-Branding im Interview', 'Gemeinsame Roadmap und Go-to-Market'] },
] : [
  { tag: '01', name: 'Referral partner', who: 'For firms that want to bring clients to us', share: '[XX] % commission', on: 'on first-year revenue', points: ['You refer, we deliver the project', 'No onboarding needed', 'Transparent tracking per referral'] },
  { tag: '02', name: 'Licence partner', who: 'For firms that run Inplicit in their own projects', share: '[XX] % partner margin', on: 'on every licence you resell', points: ['Your own workspace for client projects', 'Certification for your team', 'You keep the client relationship and the interpretation'], featured: true },
  { tag: '03', name: 'Strategic partner', who: 'For firms with many engagements per year', share: 'Volume licence', on: 'Terms on request', points: ['Your own methodology and question library', 'Co-branding in the interview', 'Shared roadmap and go-to-market'] },
];

const steps = isDE ? [
  { t: 'Onboarding', b: 'Ihr Team wird in einem halben Tag zertifiziert und erhält einen eigenen Partner-Workspace.' },
  { t: 'Kampagne aufsetzen', b: 'Sie definieren mit Ihrem Kunden die Fragestellung. Inplicit führt hunderte Interviews parallel.' },
  { t: 'Synthese', b: 'Muster, Widersprüche und Zitate liegen nach Tagen vor, nicht nach Wochen.' },
  { t: 'Sie präsentieren', b: 'Ihre Expertise macht aus den Befunden Empfehlungen. Die Kundenbeziehung bleibt bei Ihnen.' },
] : [
  { t: 'Onboarding', b: 'Your team is certified in half a day and gets its own partner workspace.' },
  { t: 'Set up a campaign', b: 'You define the question with your client. Inplicit runs hundreds of interviews in parallel.' },
  { t: 'Synthesis', b: 'Patterns, contradictions and quotes are ready in days, not weeks.' },
  { t: 'You present', b: 'Your expertise turns findings into recommendations. The client relationship stays with you.' },
];
---

<section class="pm">
  <div class="container">
    <p class="rlabel">{isDE ? 'Partnermodell' : 'Partner model'}</p>
    <h2 class="pm__h">{isDE ? 'Drei Wege, mit Inplicit zu arbeiten.' : 'Three ways to work with Inplicit.'}</h2>
    <span class="pm__draft">{isDE ? 'Entwurf: Konditionen sind Platzhalter' : 'Draft: terms are placeholders'}</span>

    <div class="pm__tiers">
      {tiers.map((t) => (
        <article class:list={['pm__tier', { 'is-featured': t.featured }]}>
          <span class="pm__tag">{t.tag}</span>
          <h3 class="pm__name">{t.name}</h3>
          <p class="pm__who">{t.who}</p>
          <p class="pm__share">{t.share}</p>
          <p class="pm__on">{t.on}</p>
          <ul class="pm__points">
            {t.points.map((p) => <li>{p}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <h3 class="pm__sub">{isDE ? 'So läuft ein Partnerprojekt' : 'How a partner project runs'}</h3>
    <ol class="pm__steps">
      {steps.map((s, i) => (
        <li class="pm__step">
          <span class="pm__num">{String(i + 1).padStart(2, '0')}</span>
          <h4 class="pm__step-t">{s.t}</h4>
          <p class="pm__step-b">{s.b}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pm { padding: var(--space-section) 0; border-top: 1px solid var(--color-border); }
  .pm__h { margin-top: var(--space-4); font-size: clamp(2rem, 3.6vw, 3rem); font-weight: 400; line-height: 1.1; letter-spacing: -0.035em; }
  .pm__draft {
    display: inline-block; margin-top: var(--space-4); padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs); font-weight: 500; color: var(--color-text-secondary);
    background: var(--color-surface-elevated); border-radius: var(--radius-ui);
  }
  .pm__tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-12); }
  .pm__tier {
    display: flex; flex-direction: column; padding: var(--space-8) var(--space-6);
    background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl);
  }
  .pm__tier.is-featured { border-color: var(--color-accent); box-shadow: var(--shadow-md); }
  .pm__tag { font-size: var(--text-xs); font-weight: 500; letter-spacing: 0.06em; color: var(--color-text-secondary); }
  .pm__name { margin-top: var(--space-3); font-size: var(--text-lg); font-weight: 500; letter-spacing: -0.02em; }
  .pm__who { margin-top: var(--space-2); font-size: var(--text-sm); line-height: 1.5; color: var(--color-text-secondary); }
  .pm__share { margin-top: var(--space-8); font-size: var(--text-xl); font-weight: 400; letter-spacing: -0.03em; line-height: 1.1; }
  .pm__on { margin-top: var(--space-1); font-size: var(--text-sm); color: var(--color-text-secondary); }
  .pm__points { margin-top: var(--space-6); padding-top: var(--space-6); border-top: 1px solid var(--color-border); display: grid; gap: var(--space-3); list-style: none; }
  .pm__points li { position: relative; padding-left: var(--space-5); font-size: var(--text-sm); line-height: 1.5; }
  .pm__points li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px; border-radius: 2px; background: var(--color-accent); }

  .pm__sub { margin-top: var(--space-24); font-size: var(--text-lg); font-weight: 500; letter-spacing: -0.02em; }
  .pm__steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-6); margin-top: var(--space-8); list-style: none; }
  .pm__step { padding-top: var(--space-4); border-top: 1px solid var(--color-text-primary); }
  .pm__num { font-size: var(--text-xs); font-weight: 500; color: var(--color-text-secondary); }
  .pm__step-t { margin-top: var(--space-3); font-size: var(--text-base); font-weight: 500; }
  .pm__step-b { margin-top: var(--space-2); font-size: var(--text-sm); line-height: 1.55; color: var(--color-text-secondary); }

  @media (max-width: 1023px) {
    .pm__tiers { grid-template-columns: minmax(0, 1fr); }
    .pm__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .pm { padding: var(--space-24) 0; }
    .pm__steps { grid-template-columns: minmax(0, 1fr); }
  }
</style>
