---
// "So sehen Kampagnen aus" — the concrete, classic project names buyers have
// budgets for (Post-Merger-Integration, Wissenstransfer, Trainingsbedarfe …),
// deliberately kept separate from the more abstract Anwendungsfälle tiles.
export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

const img = (id: string) => `https://images.unsplash.com/${id}?w=900&q=65&auto=format&fit=crop`;

const p = (n: number) => `/people/s${n}.png`;

const campaigns = isDE ? [
  {
    tag: 'Post-Merger-Integration',
    title: 'Zwei Organisationen, ein Bild davon, wer was kann',
    body: 'Nach dem Closing läuft die Uhr: Je länger die Integration dauert, desto mehr Geld verbrennt. Wir erfassen in Tagen, wo Wissen, Doppelstrukturen und Reibung sitzen — statt sich auf ein Intro der übernommenen Führung zu verlassen.',
    who: 'Beide Standorte, von Führung bis Team',
    people: [1, 2, 3, 4],
    image: img('photo-1486406146926-c627a92ad1ab'),
  },
  {
    tag: 'Wissenstransfer & Nachfolge',
    title: 'Erfahrungswissen sichern, bevor es das Haus verlässt',
    body: 'Wenn erfahrene Mitarbeitende gehen, geht undokumentiertes Wissen mit. Wir machen sichtbar, welches Wissen an einzelnen Personen hängt, und übersetzen es in eine nutzbare Wissensbasis.',
    who: 'Erfahrene Fachkräfte und ihre Nachfolge',
    people: [5, 6, 7],
    image: img('photo-1600880292203-757bb62b4baf'),
  },
  {
    tag: 'Trainingsbedarfe',
    title: 'Wissenslücken finden, statt Trainings zu raten',
    body: 'Ein strukturierter Quick-Check über die Belegschaft zeigt, wo tatsächlich Qualifikationslücken bestehen — die Grundlage für Personalentwicklung, Skill-Matrix und ISO-Nachweise.',
    who: 'Gesamte Belegschaft, nach Rollen ausgewertet',
    people: [8, 9, 10, 11, 12],
    image: img('photo-1552664730-d307ca884978'),
  },
  {
    tag: 'Wissensmanagement',
    title: 'Eine Wissensbasis, die aus der Belegschaft entsteht',
    body: 'Statt Dokumente zu sammeln, die niemand pflegt: strukturiertes Wissen direkt aus den Köpfen — durchsuchbar, mit Beleg zur anonymen Quelle, anschlussfähig an Ihre bestehenden Tools.',
    who: 'Alle Abteilungen, fortlaufend befragt',
    people: [2, 5, 9, 12],
    image: img('photo-1556761175-b413da4baf72'),
  },
  {
    tag: 'Innovationsroadmap',
    title: 'Die Ideen, die längst im Unternehmen liegen',
    body: 'Ihre Mitarbeitenden wissen, was besser laufen könnte — nur fragt sie selten jemand strukturiert. Wir sammeln Vorschläge, clustern sie und zeigen, welche Potenziale mehrfach genannt werden.',
    who: 'Operative Teams, die es täglich sehen',
    people: [3, 7, 10, 1],
    image: img('photo-1522071820081-009f0129c71c'),
  },
  {
    tag: 'Transformation & Change',
    title: 'Erst verstehen, was heute wirklich passiert',
    body: 'Jede Transformation beginnt mit einer ehrlichen Ist-Aufnahme. Wir erfassen, wie heute wirklich gearbeitet wird — und wo der Wandel auf Widerstand oder auf Rückenwind trifft.',
    who: 'Die betroffenen Bereiche im Rollout',
    people: [4, 8, 11, 6],
    image: img('photo-1531482615713-2afd69097998'),
  },
] : [
  {
    tag: 'Post-merger integration',
    title: 'Two organisations, one picture of who knows what',
    body: 'After closing, the clock runs: the longer integration takes, the more real money burns. In days we map where knowledge, duplicate structures and friction actually sit — instead of relying on an intro from the acquired leadership.',
    who: 'Both sites, from leadership to team level',
    people: [1, 2, 3, 4],
    image: img('photo-1486406146926-c627a92ad1ab'),
  },
  {
    tag: 'Knowledge transfer & succession',
    title: 'Capture experience before it walks out the door',
    body: 'When experienced people leave, undocumented knowledge leaves with them. We surface which knowledge sits with individuals and turn it into a knowledge base you can use.',
    who: 'Experienced specialists and their successors',
    people: [5, 6, 7],
    image: img('photo-1600880292203-757bb62b4baf'),
  },
  {
    tag: 'Training needs',
    title: 'Find the skill gaps instead of guessing at training',
    body: 'A structured quick-check across the workforce shows where qualification gaps really are — the basis for people development, a skill matrix and ISO evidence.',
    who: 'Whole workforce, evaluated by role',
    people: [8, 9, 10, 11, 12],
    image: img('photo-1552664730-d307ca884978'),
  },
  {
    tag: 'Knowledge management',
    title: 'A knowledge base that grows out of your workforce',
    body: 'Instead of collecting documents nobody maintains: structured knowledge straight from people\'s heads — searchable, evidenced to an anonymous source, and connected to the tools you already run.',
    who: 'Every department, asked continuously',
    people: [2, 5, 9, 12],
    image: img('photo-1556761175-b413da4baf72'),
  },
  {
    tag: 'Innovation roadmap',
    title: 'The ideas already sitting inside your company',
    body: 'Your employees know what could run better — they are rarely asked in a structured way. We collect proposals, cluster them and show which opportunities come up again and again.',
    who: 'The operational teams who see it daily',
    people: [3, 7, 10, 1],
    image: img('photo-1522071820081-009f0129c71c'),
  },
  {
    tag: 'Transformation & change',
    title: 'First understand what actually happens today',
    body: 'Every transformation starts with an honest baseline. We capture how work really gets done — and where the change will meet resistance or momentum.',
    who: 'The areas affected by the rollout',
    people: [4, 8, 11, 6],
    image: img('photo-1531482615713-2afd69097998'),
  },
];
---

<section class="cg" id="campaigns">
  <div class="container">
    <div class="cg__head section-fade">
      <div class="cg__head-copy">
        <span class="section-eyebrow">{isDE ? 'Kampagnen' : 'Campaigns'}</span>
        <h2 class="cg__heading">
          <span>{isDE ? 'So können Kampagnen' : 'What campaigns can'}</span>
          <span class="cg__heading-ghost">{isDE ? 'konkret aussehen.' : 'look like in practice.'}</span>
        </h2>
        <p class="cg__sub">
          {isDE
            ? 'Jede Kampagne beantwortet eine konkrete Frage aus dem Tagesgeschäft. Diese Einsätze sehen wir am häufigsten.'
            : 'Every campaign answers one concrete question from day-to-day business. These are the engagements we see most often.'}
        </p>
      </div>
      <div class="cg__nav" aria-hidden="true">
        <button type="button" class="cg__arrow" data-cg-prev aria-label={isDE ? 'Zurück' : 'Previous'}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="cg__arrow" data-cg-next aria-label={isDE ? 'Weiter' : 'Next'}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="cg__rail" data-cg-rail tabindex="0" role="region" aria-label={isDE ? 'Kampagnen' : 'Campaigns'}>
    <div class="cg__track">
      {campaigns.map((c) => (
        <article class="cg__card">
          <img class="cg__img" src={c.image} alt="" loading="lazy" decoding="async" width="900" height="600" />
          <span class="cg__scrim" aria-hidden="true"></span>
          <div class="cg__body">
            <span class="cg__tag">{c.tag}</span>
            <h3 class="cg__title">{c.title}</h3>
            <p class="cg__text">{c.body}</p>
            <div class="cg__who">
              <span class="cg__faces" aria-hidden="true">
                {c.people.map((n) => <img class="cg__face" src={p(n)} alt="" loading="lazy" decoding="async" width="64" height="64" />)}
              </span>
              <span class="cg__who-label">{c.who}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="cg__dots" data-cg-dots aria-hidden="true">
    {campaigns.map((_, i) => (
      <button type="button" class={`cg__dot${i === 0 ? ' is-active' : ''}`} data-cg-dot={i}></button>
    ))}
  </div>
</section>

<style>
  .cg {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
    overflow: hidden;
  }
  @media (max-width: 767px) { .cg { padding: var(--space-24) 0; } }

  .cg__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }
  .cg__head-copy { max-width: 620px; }

  .cg__heading {
    font-size: clamp(var(--text-xl), 4vw, var(--text-2xl));
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
    display: flex;
    flex-direction: column;
    gap: 0.06em;
  }
  .cg__heading-ghost { color: var(--color-text-primary); opacity: 0.3; }

  .cg__sub {
    margin-top: var(--space-5);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 520px;
  }

  .cg__nav { display: flex; gap: var(--space-2); flex-shrink: 0; }
  .cg__arrow {
    width: 42px; height: 42px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: var(--radius-full, 999px);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-primary);
    transition: border-color 0.15s var(--ease-smooth), opacity 0.15s var(--ease-smooth);
  }
  .cg__arrow:hover { border-color: var(--color-text-tertiary); }
  .cg__arrow[disabled] { opacity: 0.35; pointer-events: none; }
  @media (max-width: 767px) { .cg__nav { display: none; } }

  /* ── Rail: native scroll-snap (drag/swipe works without JS) ── */
  .cg__rail {
    /* page gutter: keeps the first card in line with the container copy.
       scroll-padding matters — without it snapping pulls the card flush left. */
    --cg-gutter: max(var(--space-6), calc((100vw - var(--max-width)) / 2 + var(--space-6)));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--cg-gutter);
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  @media (min-width: 768px) {
    .cg__rail { --cg-gutter: max(var(--space-8), calc((100vw - var(--max-width)) / 2 + var(--space-8))); }
  }
  .cg__rail::-webkit-scrollbar { display: none; }
  .cg__rail:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 4px; }

  .cg__track {
    display: flex;
    gap: var(--space-4);
    padding: 0 var(--cg-gutter);
  }

  .cg__card {
    position: relative;
    isolation: isolate;
    flex: 0 0 auto;
    width: 340px;
    height: 440px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--color-canvas-dark, #0B0C10);
  }
  @media (max-width: 480px) { .cg__card { width: 82vw; height: 420px; } }

  .cg__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    /* lightly desaturated so the six photos read as one set — no colour cast */
    filter: saturate(0.35) contrast(1.04);
    transition: transform 0.5s var(--ease-smooth);
  }
  .cg__card:hover .cg__img { transform: scale(1.05); }

  /* Neutral black scrim, same treatment as the hero */
  .cg__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(11,12,16,0.95) 0%, rgba(11,12,16,0.72) 38%, rgba(11,12,16,0.32) 68%, rgba(11,12,16,0.14) 100%);
  }

  .cg__body {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cg__tag {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: var(--radius-full, 999px);
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.22);
    backdrop-filter: blur(6px);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #fff;
    margin-bottom: var(--space-1);
  }
  .cg__title {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .cg__text {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: rgba(255,255,255,0.78);
  }
  /* Who gets interviewed in this campaign */
  .cg__who {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255,255,255,0.16);
  }
  .cg__faces { display: flex; flex-shrink: 0; }
  .cg__face {
    width: 26px; height: 26px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255,255,255,0.9);
    box-shadow: 0 1px 4px rgba(11,12,16,0.4);
  }
  .cg__face + .cg__face { margin-left: -9px; }
  .cg__who-label {
    font-size: var(--text-xs);
    line-height: 1.4;
    color: rgba(255,255,255,0.8);
  }

  .cg__dots {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin-top: var(--space-8);
  }
  .cg__dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: var(--color-text-primary);
    opacity: 0.18;
    transition: opacity 0.2s var(--ease-smooth), background-color 0.2s var(--ease-smooth);
  }
  .cg__dot.is-active { opacity: 1; background: var(--color-accent); }

  @media (prefers-reduced-motion: reduce) {
    .cg__rail { scroll-behavior: auto; }
    .cg__card:hover .cg__img { transform: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.cg').forEach((section) => {
    const rail = section.querySelector<HTMLElement>('[data-cg-rail]');
    const track = section.querySelector<HTMLElement>('.cg__track');
    if (!rail || !track) return;

    const cards = [...track.querySelectorAll<HTMLElement>('.cg__card')];
    const dots = [...section.querySelectorAll<HTMLElement>('[data-cg-dot]')];
    const prev = section.querySelector<HTMLButtonElement>('[data-cg-prev]');
    const next = section.querySelector<HTMLButtonElement>('[data-cg-next]');
    if (!cards.length) return;

    const step = () => {
      if (cards.length < 2) return cards[0].offsetWidth;
      return cards[1].offsetLeft - cards[0].offsetLeft;
    };

    const sync = () => {
      const maxScroll = rail.scrollWidth - rail.clientWidth - 1;
      const atEnd = rail.scrollLeft >= maxScroll;
      // at the end the last card can't scroll flush left, so pin the last dot
      const i = atEnd ? cards.length - 1 : Math.round(rail.scrollLeft / step());
      const active = Math.max(0, Math.min(cards.length - 1, i));
      dots.forEach((d, j) => d.classList.toggle('is-active', j === active));
      if (prev) prev.disabled = rail.scrollLeft <= 1;
      if (next) next.disabled = atEnd;
    };

    prev?.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: 'smooth' }));
    dots.forEach((d, j) => d.addEventListener('click', () => {
      rail.scrollTo({ left: j * step(), behavior: 'smooth' });
    }));

    let raf = 0;
    rail.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(sync);
    }, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
    sync();
  });
</script>
