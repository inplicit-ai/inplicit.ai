---
// Company Brain Kampagne — hero. Reuses the site hero's video asset, scrim
// treatment and CTA mechanics; copy is landing-page specific.
export interface Props {
  bookingHref: string;
}
const { bookingHref } = Astro.props;

const faces = [2, 5, 9, 12, 7];
---

<section class="cbh" id="hero">
  <div class="cbh__bg" aria-hidden="true">
    <video
      class="cbh__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/company-brain-poster.jpg"
    >
      <source src="/company-brain-hero.mp4" type="video/mp4" />
    </video>
    <div class="cbh__scrim"></div>
  </div>

  <div class="cbh__inner container">
    <div class="cbh__content">
      <span class="cbh__pill">Wissensbasis</span>

      <h1 class="cbh__headline">
        <span class="cbh__line">Ein Company Brain,</span>
        <span class="cbh__line">das aus Ihrer Belegschaft</span>
        <span class="cbh__line cbh__line--ghost">entsteht.</span>
      </h1>

      <p class="cbh__sub">
        Machen Sie das Wissen, die Erfahrungen und die informellen Lösungen Ihrer
        Mitarbeitenden dauerhaft nutzbar, statt darauf zu hoffen, dass sie
        irgendwann dokumentiert werden.
      </p>

      <div class="cbh__actions">
        <a href={bookingHref} class="cbh__cta" data-cb-cta="hero">
          <span class="cbh__cta-label">Company Brain Kampagne besprechen</span>
          <i class="cbh__cta-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </i>
        </a>
        <p class="cbh__microcopy">
          In 20 Minuten klären wir, welche Wissensbereiche Sie zuerst sichtbar machen sollten.
        </p>
      </div>

      <div class="cbh__who">
        <span class="cbh__faces" aria-hidden="true">
          {faces.map((n) => (
            <img class="cbh__face" src={`/people/s${n}.png`} alt="" loading="eager" decoding="async" width="64" height="64" />
          ))}
          <span class="cbh__face cbh__face--mic">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/>
            </svg>
          </span>
        </span>
        <span class="cbh__who-label">Für Geschäftsführung, Operations und Transformationsteams</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cbh {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100svh;
    padding: 128px 0 96px;
    overflow: hidden;
  }

  .cbh__bg { position: absolute; inset: 0; z-index: -1; background: var(--color-canvas-dark, #0b0c10); }
  .cbh__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Same readability treatment as the site hero: dark under the copy,
     clearing to the right, with a soft top/bottom vignette. */
  .cbh__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    background:
      linear-gradient(90deg, rgba(11, 12, 16, 0.9) 0%, rgba(11, 12, 16, 0.72) 40%, rgba(11, 12, 16, 0.32) 74%, rgba(11, 12, 16, 0.14) 100%),
      linear-gradient(0deg, rgba(11, 12, 16, 0.6) 0%, rgba(11, 12, 16, 0) 34%),
      linear-gradient(180deg, rgba(11, 12, 16, 0.5) 0%, rgba(11, 12, 16, 0) 24%);
  }

  .cbh__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    animation: cbh-in 0.7s var(--ease-out) forwards;
  }

  @keyframes cbh-in {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .cbh__content { max-width: 660px; }

  .cbh__pill {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-full, 999px);
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #fff;
  }

  .cbh__headline {
    font-family: var(--font-family);
    font-size: clamp(2.2rem, 5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.07;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
    animation: cbh-in 0.7s var(--ease-out) forwards 0.1s;
    opacity: 0;
  }
  .cbh__line { color: #fff; }
  .cbh__line--ghost { color: rgba(255, 255, 255, 0.42); }

  .cbh__sub {
    font-size: clamp(var(--text-base), 1.7vw, var(--text-lg));
    color: rgba(255, 255, 255, 0.86);
    line-height: 1.75;
    max-width: 560px;
    margin-bottom: var(--space-10);
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.35);
    animation: cbh-in 0.7s var(--ease-out) forwards 0.18s;
    opacity: 0;
  }

  .cbh__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
    animation: cbh-in 0.7s var(--ease-out) forwards 0.26s;
    opacity: 0;
  }

  /* White pill with the orange fill sliding across on hover — site hero mechanics */
  .cbh__cta {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    height: 50px;
    padding: 0 var(--space-8);
    background-color: #fff;
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    border-radius: var(--radius-full, 999px);
    box-shadow: 0 10px 30px -10px rgba(11, 12, 16, 0.5);
    transition: color 0.3s var(--ease-smooth);
  }
  .cbh__cta:active { transform: scale(0.98); }
  .cbh__cta:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .cbh__cta-label { margin-right: var(--space-12); transition: opacity 0.35s var(--ease-smooth); }
  .cbh__cta:hover .cbh__cta-label { opacity: 0; }
  .cbh__cta-icon {
    position: absolute;
    right: 4px; top: 4px; bottom: 4px;
    width: 42px;
    display: grid;
    place-items: center;
    z-index: 1;
    border-radius: var(--radius-full, 999px);
    color: #fff;
    background-color: var(--color-accent);
    transition: width 0.4s var(--ease-spring), top 0.4s var(--ease-spring), right 0.4s var(--ease-spring), bottom 0.4s var(--ease-spring);
  }
  .cbh__cta:hover .cbh__cta-icon { top: 0; right: 0; bottom: 0; width: 100%; }

  .cbh__microcopy {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.6;
    max-width: 44ch;
  }

  /* Interview marker: the people who get heard, closed by the mic badge */
  .cbh__who {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    max-width: 520px;
    animation: cbh-in 0.7s var(--ease-out) forwards 0.34s;
    opacity: 0;
  }
  .cbh__faces { display: flex; align-items: center; flex-shrink: 0; }
  .cbh__face {
    width: 30px; height: 30px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 1px 5px rgba(11, 12, 16, 0.45);
  }
  .cbh__face + .cbh__face { margin-left: -8px; }
  .cbh__face--mic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: var(--color-canvas-dark, #0b0c10);
    flex-shrink: 0;
  }
  .cbh__who-label {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 767px) {
    .cbh { padding: 112px 0 72px; }
    /* Copy spans the full width on phones, so the horizontal scrim can't carry
       contrast on its own. Darken evenly top to bottom instead. */
    .cbh__scrim {
      background: linear-gradient(180deg, rgba(11, 12, 16, 0.62) 0%, rgba(11, 12, 16, 0.78) 55%, rgba(11, 12, 16, 0.9) 100%);
    }
    .cbh__headline { font-size: clamp(1.9rem, 8.5vw, 2.6rem); }
    .cbh__sub { font-size: var(--text-base); margin-bottom: var(--space-8); }
    .cbh__actions { align-self: stretch; }
    /* Long CTA label: let the button grow instead of wrapping under the icon */
    .cbh__cta {
      width: 100%;
      justify-content: center;
      height: auto;
      min-height: 52px;
      padding: var(--space-4) var(--space-5);
      text-align: center;
    }
    .cbh__cta-label { margin-right: 0; }
    .cbh__cta-icon { display: none; }
    .cbh__who { align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cbh__inner, .cbh__headline, .cbh__sub, .cbh__actions, .cbh__who { animation: none; opacity: 1; }
    .cbh__video { display: none; }
    .cbh__bg { background: #0b0c10 url('/company-brain-poster.jpg') center / cover no-repeat; }
  }
</style>
