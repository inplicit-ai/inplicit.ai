---
// Closing section. Same two-column layout as CalBooking on the main landing
// page: copy on the left, the Cal.eu inline embed on the right. Own element
// ids so it never collides with CalBooking if both ever appear on one page.
const CAL_LINK = 'inplicit/30min';

// Only claims the existing site already makes (Hero meta, TrustSecurity).
const trust = ['DSGVO-konform', 'Anonymes Feedback', 'Betriebsrat früh einbindbar'];
---

<section class="cbc" id="gespraech">
  <div class="container">
    <div class="cbc__inner">

      <div class="cbc__copy section-fade">
        <span class="section-eyebrow">Nächster Schritt</span>

        <h2 class="cbc__heading">
          Machen Sie sichtbar, was Ihre Organisation bereits weiß.
        </h2>

        <p class="cbc__sub">
          Starten Sie mit einer konkreten Fragestellung. Gemeinsam definieren wir, welche
          Teams und Wissensbereiche für Ihre nächste Entscheidung relevant sind.
        </p>

        <p class="cbc__microcopy">
          20 Minuten. Kein Standard-Pitch. Eine erste Einschätzung Ihrer Wissensrisiken und Potenziale.
        </p>

        <ul class="cbc__trust" role="list">
          {trust.map((item) => (
            <li class="cbc__trust-item">
              <svg class="cbc__check" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 7l3 3 6-6" stroke="var(--color-accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <div class="cbc__founder">
          <img class="cbc__founder-photo" src="/martin.png" alt="Martin Auer" width="56" height="56" />
          <div>
            <p class="cbc__founder-name">Martin Auer</p>
            <p class="cbc__founder-role">Co-Founder &amp; CEO</p>
          </div>
        </div>
      </div>

      <div class="cbc__embed-wrap section-fade" style="--delay: 100ms">
        <div id="cb-cal-inline" class="cbc__embed" data-cal-link={CAL_LINK}></div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var el = document.getElementById('cb-cal-inline');
    if (!el) return;
    var calLink = el.getAttribute('data-cal-link');

    function loadCal() {
      (function (C, A, INIT) {
        var p = function (a, ar) { a.q.push(ar); };
        var d = C.document;
        C.Cal = C.Cal || function () {
          var cal = C.Cal;
          var ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement('script')).src = A;
            cal.loaded = true;
          }
          if (ar[0] === INIT) {
            var api = function () { p(api, arguments); };
            var ns = ar[1];
            api.q = api.q || [];
            typeof ns === 'string' ? (cal.ns[ns] = api) && p(api, ar) : p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window, 'https://app.cal.eu/embed/embed.js', 'init');

      // Carry campaign attribution into the booking itself.
      var config = { theme: 'light', locale: document.documentElement.lang || 'de', campaign: 'company-brain' };
      new URLSearchParams(window.location.search).forEach(function (value, key) {
        if (key.indexOf('utm_') === 0 || key === 'gclid' || key === 'fbclid' || key === 'li_fat_id') {
          config[key] = value;
        }
      });

      Cal('init', { origin: 'https://cal.eu' });
      Cal('inline', {
        elementOrSelector: '#cb-cal-inline',
        calLink: calLink,
        layout: 'month_view',
        config: config,
      });
      Cal('ui', {
        styles: { branding: { brandColor: '#f5a623' } },
        hideEventTypeDetails: false,
      });
    }

    var section = document.getElementById('gespraech');
    var observer = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) {
        window.posthog?.capture('company_brain_booking_started', { location: 'cal_embed' });
        loadCal();
        observer.disconnect();
      }
    }, { threshold: 0.2 });
    observer.observe(section);
  })();
</script>

<style>
  .cbc {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
    scroll-margin-top: 88px;
  }
  @media (max-width: 767px) { .cbc { padding: var(--space-24) 0; } }

  /* Same proportions as CalBooking: narrow copy column, calendar right-aligned */
  .cbc__inner {
    display: grid;
    grid-template-columns: 360px minmax(0, 520px);
    justify-content: space-between;
    gap: var(--space-16);
    align-items: start;
  }
  @media (max-width: 900px) {
    .cbc__inner { grid-template-columns: 1fr; justify-content: stretch; gap: var(--space-10); }
  }

  .cbc__heading {
    font-size: clamp(var(--text-xl), 4vw, var(--text-2xl));
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: var(--space-5);
    color: var(--color-text-primary);
  }

  .cbc__sub {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-4);
  }

  .cbc__microcopy {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .cbc__trust {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cbc__trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .cbc__check { width: 14px; height: 14px; flex-shrink: 0; }

  .cbc__founder {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .cbc__founder-photo {
    width: 56px; height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
    background: var(--color-accent-light);
    flex-shrink: 0;
  }
  .cbc__founder-name { font-size: var(--text-sm); font-weight: 600; color: var(--color-text-primary); }
  .cbc__founder-role { font-size: var(--text-sm); color: var(--color-text-secondary); }

  /* Fixed-height card; the Cal embed scrolls inside it (same as CalBooking) */
  .cbc__embed-wrap {
    position: relative;
    height: 600px;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
  }

  .cbc__embed { width: 100%; height: 100%; overflow: hidden; }

  /* !important is needed because Cal's embed.js sets an inline height */
  .cbc__embed :global(cal-inline) { height: 100% !important; display: block; overflow: hidden; }
  .cbc__embed-wrap :global(iframe.cal-embed) { height: 100% !important; }
</style>
