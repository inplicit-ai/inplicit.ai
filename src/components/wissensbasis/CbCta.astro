---
// Closing CTA. Dark card echoing the hero canvas, orange primary action.
export interface Props {
  bookingHref: string;
}
const { bookingHref } = Astro.props;

// Only claims that the existing site already makes (Hero meta, TrustSecurity).
const trust = ['DSGVO-konform', 'Anonymes Feedback', 'Betriebsrat früh einbindbar'];
---

<section class="cbc" id="gespraech">
  <div class="container">
    <div class="cbc__card section-fade">
      <span class="cbc__pill">Nächster Schritt</span>

      <h2 class="cbc__heading">
        <span>Machen Sie sichtbar,</span>
        <span class="cbc__heading-ghost">was Ihre Organisation bereits weiß.</span>
      </h2>

      <p class="cbc__sub">
        Starten Sie mit einer konkreten Fragestellung. Gemeinsam definieren wir, welche
        Teams und Wissensbereiche für Ihre nächste Entscheidung relevant sind.
      </p>

      <a href={bookingHref} class="cbc__cta" data-cb-cta="final">
        <span class="cbc__cta-label">Company Brain Campaign besprechen</span>
        <i class="cbc__cta-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </i>
      </a>

      <p class="cbc__microcopy">
        20 Minuten. Kein Standard-Pitch. Eine erste Einschätzung Ihrer Wissensrisiken und Potenziale.
      </p>

      <ul class="cbc__trust" role="list">
        {trust.map((item) => (
          <li class="cbc__trust-item">
            <svg class="cbc__check" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 6l3 3 5-5" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .cbc {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
    scroll-margin-top: 88px;
  }
  @media (max-width: 767px) { .cbc { padding: var(--space-24) 0; } }

  .cbc__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-canvas-dark, #0b0c10);
    border-radius: var(--radius-xl);
    padding: var(--space-16) var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Soft ember glow, the only warm light on the card */
  .cbc__card::after {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    width: 520px;
    height: 520px;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(252, 161, 87, 0.18) 0%, rgba(252, 161, 87, 0) 68%);
    pointer-events: none;
  }

  .cbc__pill {
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-full, 999px);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.86);
  }

  .cbc__heading {
    font-size: clamp(var(--text-xl), 4vw, var(--text-2xl));
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
    display: flex;
    flex-direction: column;
    gap: 0.06em;
    margin-bottom: var(--space-5);
    color: #fff;
    max-width: 18ch;
  }
  .cbc__heading-ghost { color: rgba(255, 255, 255, 0.42); }

  .cbc__sub {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.8;
    max-width: 52ch;
    margin-bottom: var(--space-8);
  }

  .cbc__cta {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    height: 50px;
    padding: 0 var(--space-8);
    background-color: var(--color-cta-bg);
    color: var(--color-cta-text);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
    border-radius: var(--radius-full, 999px);
    transition: opacity 0.2s var(--ease-smooth);
  }
  .cbc__cta:hover { opacity: 0.9; }
  .cbc__cta:active { transform: scale(0.98); }
  .cbc__cta:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .cbc__cta-label { margin-right: var(--space-12); transition: opacity 0.4s var(--ease-smooth); }
  .cbc__cta:hover .cbc__cta-label { opacity: 0; }
  .cbc__cta-icon {
    position: absolute;
    right: 4px; top: 4px; bottom: 4px;
    width: 42px;
    display: grid;
    place-items: center;
    z-index: 1;
    border-radius: var(--radius-full, 999px);
    background-color: var(--color-cta-icon-bg);
    transition: width 0.4s var(--ease-spring);
  }
  .cbc__cta:hover .cbc__cta-icon { width: calc(100% - 8px); }

  .cbc__microcopy {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.62);
    line-height: 1.6;
    max-width: 52ch;
  }

  .cbc__trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    width: 100%;
  }
  .cbc__trust-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.72);
  }
  .cbc__check { width: 12px; height: 12px; flex-shrink: 0; }

  @media (max-width: 767px) {
    .cbc__card { padding: var(--space-10) var(--space-6); }
    .cbc__heading { max-width: none; }
    /* Long CTA label: let the button grow instead of wrapping under the icon */
    .cbc__cta {
      width: 100%;
      justify-content: center;
      height: auto;
      min-height: 52px;
      padding: var(--space-4) var(--space-5);
      font-size: var(--text-sm);
      text-align: center;
    }
    .cbc__cta-label { margin-right: 0; }
    .cbc__cta-icon { display: none; }
    .cbc__trust { flex-direction: column; gap: var(--space-2); }
  }
</style>
