---
// How the campaigns connect to the Company Brain and from there to the AI
// tools. The diagram gets the full container width so the three stages stay
// readable; the takeaways sit underneath it.
import CbBrainViz from './CbBrainViz.astro';
import CbBrainVizStacked from './CbBrainVizStacked.astro';
import type { KampagneContent } from '../../data/kampagnen';

export interface Props {
  content: KampagneContent['aiLayer'];
}
const { content } = Astro.props;
---

<section class="cbl" id="ki-anbindung">
  <div class="container">

    <div class="cbl__header section-fade">
      <span class="section-eyebrow">{content.eyebrow}</span>
      <h2 class="cbl__heading">{content.heading}</h2>
      <p class="cbl__sub">{content.sub}</p>
    </div>

    <div class="cbl__viz cbl__viz--wide section-fade" style="--delay: 100ms">
      <CbBrainViz campaigns={content.campaigns} />
    </div>
    <div class="cbl__viz cbl__viz--stacked section-fade" style="--delay: 100ms">
      <CbBrainVizStacked campaigns={content.campaigns} />
    </div>

    <ul class="cbl__points section-fade" style="--delay: 160ms" role="list">
      {content.points.map((point) => (
        <li class="cbl__point">
          <svg class="cbl__check" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7l3 3 6-6" stroke="var(--color-accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {point}
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .cbl {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }
  @media (max-width: 767px) { .cbl { padding: var(--space-16) 0; } }

  .cbl__header { max-width: 660px; margin-bottom: var(--space-12); }

  .cbl__heading {
    font-size: clamp(var(--text-xl), 4vw, var(--text-2xl));
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
  }

  .cbl__sub {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .cbl__viz {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-8);
  }
  @media (max-width: 767px) { .cbl__viz { padding: var(--space-5) var(--space-4); } }

  /* One diagram per breakpoint: side by side on desktop, stacked on phones */
  .cbl__viz--stacked { display: none; }
  @media (max-width: 860px) {
    .cbl__viz--wide { display: none; }
    .cbl__viz--stacked { display: block; }
  }

  .cbl__points {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  @media (min-width: 768px) {
    .cbl__points { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  }

  .cbl__point {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .cbl__check { width: 14px; height: 14px; flex-shrink: 0; margin-top: 4px; }
</style>
