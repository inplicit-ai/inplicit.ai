---
// Campaign-page variant of the context diagram: campaigns on the left feed the
// Company Brain in the centre, which hands context to the AI tools via MCP.
// The main landing page keeps UspViz type="context" unchanged.
export interface Props {
  campaigns: { label: string; people: number[] }[];
}
const { campaigns } = Astro.props;

const tools = ['Claude', 'Gemini', 'ChatGPT', 'Copilot'];
---

<div class="bviz" aria-hidden="true">

  <!-- LEFT: each campaign is one interview round feeding the brain -->
  <div class="bviz__side">
    <span class="bviz__label">Kampagnen</span>
    <div class="bviz__campaigns">
      {campaigns.map((c) => (
        <div class="bviz__campaign">
          <span class="bviz__campaign-title">{c.label}</span>
          <span class="bviz__faces">
            {c.people.map((n) => (
              <img class="bviz__face" src={`/people/s${n}.png`} alt="" loading="lazy" decoding="async" width="48" height="48" />
            ))}
            <span class="bviz__face bviz__face--mic">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/>
              </svg>
            </span>
          </span>
        </div>
      ))}
    </div>
  </div>

  <span class="bviz__flow" data-dir="in"></span>

  <!-- CENTRE: the Company Brain itself -->
  <div class="bviz__brain">
    <span class="bviz__brain-title">Company Brain</span>

    <div class="bviz__zone">
      <span class="bviz__zone-label">Expliziter Kontext</span>
      <span class="bviz__zone-item">Dokumente</span>
      <span class="bviz__zone-item">Systeme</span>
      <span class="bviz__zone-item">Besprechungen</span>
    </div>

    <div class="bviz__zone bviz__zone--implicit">
      <span class="bviz__zone-label">Impliziter Kontext</span>
      <span class="bviz__zone-item">Praxiswissen</span>
      <span class="bviz__zone-item">Echte Abläufe</span>
      <span class="bviz__zone-item">Erfahrungswissen</span>
      <span class="bviz__zone-source">aus den Kampagnen</span>
    </div>
  </div>

  <span class="bviz__flow" data-dir="out"><span class="bviz__mcp">MCP</span></span>

  <!-- RIGHT: the tools that consume the context -->
  <div class="bviz__side bviz__side--tools">
    <span class="bviz__label">KI-Anwendungen</span>
    <div class="bviz__tools">
      {tools.map((tool) => <span class="bviz__tool">{tool}</span>)}
    </div>
  </div>

</div>

<style>
  .bviz {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1.15fr) 76px minmax(0, 0.7fr);
    align-items: center;
    gap: 0;
  }

  .bviz__label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-3);
  }

  /* ── Campaign cards ── */
  .bviz__campaigns { display: flex; flex-direction: column; gap: var(--space-2); }

  .bviz__campaign {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-ui);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .bviz__campaign-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .bviz__faces { display: flex; align-items: center; }
  .bviz__face {
    width: 22px; height: 22px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--color-surface);
    background: var(--color-surface-elevated);
  }
  .bviz__face + .bviz__face { margin-left: -7px; }
  .bviz__face--mic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: var(--color-canvas-dark, #0b0c10);
    flex-shrink: 0;
  }

  /* ── Flow connectors ── */
  .bviz__flow {
    position: relative;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bviz__flow::before {
    content: '';
    position: absolute;
    left: 4px;
    right: 4px;
    top: 50%;
    border-top: 1px dashed var(--color-border);
  }
  .bviz__flow::after {
    content: '';
    position: absolute;
    right: 4px;
    top: 50%;
    width: 5px; height: 5px;
    margin-top: -3px;
    border-top: 1px solid var(--color-text-tertiary);
    border-right: 1px solid var(--color-text-tertiary);
    transform: rotate(45deg);
  }

  .bviz__mcp {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--color-text-primary);
    color: var(--color-bg);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  /* ── The Company Brain, visually the anchor of the diagram ── */
  .bviz__brain {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .bviz__brain-title {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    text-align: center;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .bviz__zone { display: flex; flex-direction: column; align-items: center; gap: 2px; }

  .bviz__zone-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: 2px;
  }
  .bviz__zone-item { font-size: var(--text-sm); color: var(--color-text-tertiary); line-height: 1.5; }

  /* The implicit half is what Inplicit contributes, so it carries the accent */
  .bviz__zone--implicit {
    background: var(--color-accent-light);
    border: 1px solid var(--color-accent-muted);
    border-radius: var(--radius-ui);
    padding: var(--space-3);
  }
  .bviz__zone--implicit .bviz__zone-label { color: var(--color-accent-dark); }
  .bviz__zone--implicit .bviz__zone-item { color: var(--color-text-secondary); }
  .bviz__zone-source {
    font-size: 10px;
    color: var(--color-text-tertiary);
    margin-top: 4px;
  }

  /* ── Tools ── */
  .bviz__tools { display: flex; flex-direction: column; gap: var(--space-2); }
  .bviz__tool {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-ui);
    background: var(--color-surface);
  }

  /* ── Stacked layout on narrow screens: connectors point downwards ── */
  @media (max-width: 860px) {
    .bviz { grid-template-columns: 1fr; }
    .bviz__flow { height: 44px; align-self: auto; }
    .bviz__flow::before {
      left: 50%; right: auto; top: 4px; bottom: 4px;
      border-top: none;
      border-left: 1px dashed var(--color-border);
    }
    .bviz__flow::after {
      right: auto; left: 50%; top: auto; bottom: 4px;
      margin-top: 0; margin-left: -3px;
      transform: rotate(135deg);
    }
    .bviz__side--tools .bviz__tools { flex-direction: row; flex-wrap: wrap; }
    .bviz__label { margin-top: var(--space-2); }
  }
</style>
