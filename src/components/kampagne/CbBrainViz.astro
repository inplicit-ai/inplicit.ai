---
// Campaign-page variant of the context diagram: every campaign feeds the
// implicit half of the Company Brain. Drawn as one SVG so the flow lines can
// converge. No hand-off to AI tools: the MCP surface was removed from the
// product on 2026-09-01, and the site shows only what is built.

export interface Props {
  campaigns: { label: string; people: number[] }[];
}
const { campaigns } = Astro.props;

// Card geometry — three stacked campaign cards on the left
const CARD = { x: 2, w: 190, h: 68, gap: 16, top: 20 };
const cardY = (i: number) => CARD.top + i * (CARD.h + CARD.gap);
const cardMid = (i: number) => cardY(i) + CARD.h / 2;

// Where every campaign line converges: the left edge of the implicit box
const SINK = { x: 302, y: 211 };

---

<div class="bviz" aria-hidden="true">
  <div class="bviz__scroll">
    <svg class="bviz__svg" viewBox="0 0 548 300" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        {campaigns.map((c, ci) => c.people.map((n, pi) => (
          <clipPath id={`bviz-c${ci}-${pi}`}>
            <circle cx={18 + pi * 14} cy={cardY(ci) + 48} r="9" />
          </clipPath>
        )))}
      </defs>

      <!-- ── Column labels ── -->
      <text x="2" y="10" class="bviz__label">KAMPAGNEN</text>

      <!-- ── Campaign cards: who was interviewed in each round ── -->
      {campaigns.map((c, ci) => (
        <g>
          <rect x={CARD.x} y={cardY(ci)} width={CARD.w} height={CARD.h} rx="8"
                fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1" />
          <text x="16" y={cardY(ci) + 27} class="bviz__card-title">{c.label}</text>
          {c.people.map((n, pi) => (
            <>
              <image href={`/people/s${n}.png`} x={9 + pi * 14} y={cardY(ci) + 39}
                     width="18" height="18" clip-path={`url(#bviz-c${ci}-${pi})`} preserveAspectRatio="xMidYMid slice" />
              <circle cx={18 + pi * 14} cy={cardY(ci) + 48} r="9" fill="none"
                      stroke="var(--color-surface)" stroke-width="1.5" />
            </>
          ))}
          <circle cx={18 + c.people.length * 14} cy={cardY(ci) + 48} r="9" fill="var(--color-accent)" />
          <g transform={`translate(${18 + c.people.length * 14 - 5}, ${cardY(ci) + 48 - 5})`}>
            <path d="M5 1.2h0a1.6 1.6 0 0 1 1.6 1.6v2.4A1.6 1.6 0 0 1 5 6.8a1.6 1.6 0 0 1-1.6-1.6V2.8A1.6 1.6 0 0 1 5 1.2z
                     M2.2 5a2.8 2.8 0 0 0 5.6 0 M5 7.8v1.2"
                  stroke="var(--color-canvas-dark)" stroke-width="1.1" stroke-linecap="round" fill="none" />
          </g>
        </g>
      ))}

      <!-- ── Every campaign flows into the implicit context ── -->
      <g class="bviz__feed">
        {campaigns.map((_, ci) => (
          <line x1={CARD.x + CARD.w + 4} y1={cardMid(ci)} x2={SINK.x - 4} y2={SINK.y} />
        ))}
      </g>

      <!-- ── The Company Brain ── -->
      <rect x="292" y="12" width="250" height="276" rx="10"
            fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1.2" />
      <text x="417" y="39" text-anchor="middle" class="bviz__brain-title">Company Brain</text>
      <line x1="306" y1="52" x2="528" y2="52" stroke="var(--color-border)" stroke-width="1" />

      <text x="417" y="70" text-anchor="middle" class="bviz__zone-label">EXPLIZITER KONTEXT</text>
      <text x="417" y="90" text-anchor="middle" class="bviz__item">Dokumente</text>
      <text x="417" y="108" text-anchor="middle" class="bviz__item">Richtlinien</text>
      <text x="417" y="126" text-anchor="middle" class="bviz__item">Prozessbeschreibungen</text>

      <line x1="306" y1="140" x2="528" y2="140" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="3 3" />

      <rect x="304" y="150" width="226" height="122" rx="6"
            fill="var(--color-accent-light)" stroke="var(--color-accent-muted)" stroke-width="1" />
      <text x="417" y="170" text-anchor="middle" class="bviz__zone-label bviz__zone-label--acc">IMPLIZITER KONTEXT</text>
      <text x="417" y="194" text-anchor="middle" class="bviz__item bviz__item--acc">Praxiswissen</text>
      <text x="417" y="214" text-anchor="middle" class="bviz__item bviz__item--acc">Echte Abläufe</text>
      <text x="417" y="234" text-anchor="middle" class="bviz__item bviz__item--acc">Erfahrungswissen</text>
      <text x="417" y="257" text-anchor="middle" class="bviz__source">aus den Kampagnen</text>

    </svg>
  </div>
</div>

<style>
  .bviz__scroll { overflow-x: auto; scrollbar-width: none; }
  .bviz__scroll::-webkit-scrollbar { display: none; }
  .bviz__svg { display: block; width: 100%; min-width: 500px; height: auto; }

  .bviz__label,
  .bviz__zone-label,
  .bviz__card-title,
  .bviz__brain-title,
  .bviz__item,
  .bviz__source { font-family: var(--font-family); }

  .bviz__label { font-size: 8.5px; font-weight: 700; letter-spacing: 0.09em; fill: var(--color-text-tertiary); }
  .bviz__card-title { font-size: 12px; font-weight: 500; fill: var(--color-text-primary); }
  .bviz__brain-title { font-size: 13px; font-weight: 600; fill: var(--color-text-primary); }
  .bviz__zone-label { font-size: 8.5px; font-weight: 700; letter-spacing: 0.08em; fill: var(--color-text-tertiary); }
  .bviz__zone-label--acc { fill: var(--color-accent-dark); }
  .bviz__item { font-size: 11px; fill: var(--color-text-tertiary); }
  .bviz__item--acc { fill: var(--color-text-secondary); }
  .bviz__source { font-size: 9px; fill: var(--color-text-tertiary); }

  /* Thin orange dashes travelling from the campaigns into the implicit
     context. Same cadence as UspViz. */
  .bviz__feed line {
    stroke: var(--color-accent);
    stroke-width: 0.9;
    stroke-dasharray: 3 5;
    animation: bvizFlow 0.28s linear infinite;
  }
  @keyframes bvizFlow { to { stroke-dashoffset: -8; } }

  @media (prefers-reduced-motion: reduce) {
    .bviz__feed line { animation: none; }
  }
</style>
