---
// Who gets interviewed. Reuses the site's avatar-stack + orange mic badge
// (see Campaigns.astro) as the section's visual anchor.
import type { KampagneContent } from '../../data/kampagnen';

export interface Props {
  content: KampagneContent['audience'];
}
const { content } = Astro.props;
const groups = content.groups;
---

<section class="cba" id="wer-wird-interviewt">
  <div class="container">
    <div class="cba__inner">

      <div class="cba__copy section-fade">
        <span class="section-eyebrow">{content.eyebrow}</span>
        <h2 class="cba__heading">
          <span>{content.heading}</span>
          <span class="cba__heading-ghost">{content.headingGhost}</span>
        </h2>
        <p class="cba__sub">{content.sub}</p>
      </div>

      <ul class="cba__list section-fade" style="--delay: 100ms" role="list">
        {groups.map((group) => (
          <li class="cba__row">
            <span class="cba__faces" aria-hidden="true">
              {group.people.map((n) => (
                <img class="cba__face" src={`/people/s${n}.png`} alt="" loading="lazy" decoding="async" width="64" height="64" />
              ))}
              <span class="cba__face cba__face--mic">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/>
                </svg>
              </span>
            </span>
            <span class="cba__label">{group.label}</span>
          </li>
        ))}
      </ul>

    </div>
  </div>
</section>

<style>
  .cba {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }
  @media (max-width: 767px) { .cba { padding: var(--space-24) 0; } }

  .cba__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: start;
  }
  @media (min-width: 900px) {
    .cba__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 440px); gap: var(--space-16); }
  }

  .cba__heading {
    font-size: clamp(var(--text-xl), 4vw, var(--text-2xl));
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
    display: flex;
    flex-direction: column;
    gap: 0.06em;
    margin-bottom: var(--space-4);
    color: var(--color-text-primary);
  }
  .cba__heading-ghost { opacity: 0.3; }

  .cba__sub {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.75;
    max-width: 46ch;
  }

  .cba__list {
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-2) var(--space-6);
  }

  .cba__row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
  }
  .cba__row + .cba__row { border-top: 1px solid var(--color-border-subtle); }

  .cba__faces { display: flex; align-items: center; flex-shrink: 0; }
  .cba__face {
    width: 28px; height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--color-surface);
    background: var(--color-surface-elevated);
  }
  .cba__face + .cba__face { margin-left: -9px; }
  .cba__face--mic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: var(--color-canvas-dark, #0b0c10);
    flex-shrink: 0;
  }

  .cba__label {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  @media (max-width: 767px) {
    .cba__list { padding: var(--space-2) var(--space-5); }
  }
</style>
