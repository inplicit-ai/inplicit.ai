---
import ScrollStage from '../scroll/ScrollStage.astro';
import SceneKnowledgeLoss from './SceneKnowledgeLoss.astro';
import AppShell from './AppShell.astro';
import SceneSetup from './SceneSetup.astro';
import SceneInterview from './SceneInterview.astro';
import SceneThemes from './SceneThemes.astro';
import SceneChat from './SceneChat.astro';

export interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';
---

<section class="jsec" id="how-it-works">
  <!-- Full-bleed. The product labels itself through its own breadcrumb, so the
       journey carries no marketing copy of its own. -->
  <!-- Six beats: two of problem, four of product. --t-off tells the dashboard
       chrome that the tour's own scene 0 starts at journey time 2. -->
  <ScrollStage scenes={6} travel={620}>
    <div class="jframe">
      <SceneKnowledgeLoss lang={lang} />

      <!-- The dashboard chrome persists across steps; only the breadcrumb and
           the work area change. It steps aside for the interview room, which is
           a standalone participant view with no sidebar. -->
      <div class="jshell">
        <AppShell lang={lang}>
          <div class="jtopbar" slot="topbar">
            <!-- Setup shows the flow's step pills, not a breadcrumb. -->
            <div class="jcrumb steps" style="--t0: 2">
              <span class="steps__pill steps__pill--on">{isDE ? 'Konfigurieren' : 'Configure'}</span>
              <span class="steps__pill">{isDE ? 'Prüfen' : 'Review'}</span>
              <span class="steps__pill steps__pill--off">{isDE ? 'Starten' : 'Launch'}</span>
            </div>
            <div class="jcrumb" style="--t0: 3"></div>
            <nav class="jcrumb crumb" style="--t0: 4">
              <span class="crumb__link">{isDE ? 'Kampagnen' : 'Campaigns'}</span>
              <span class="crumb__sep">›</span>
              <span class="crumb__link">Post-Merger Integration: Meridian</span>
              <span class="crumb__sep">›</span>
              <span class="crumb__now">Insights</span>
            </nav>
            <nav class="jcrumb crumb" style="--t0: 5" data-last>
              <span class="crumb__now">{isDE ? 'Wissens-Chat' : 'Knowledge Chat'}</span>
            </nav>
          </div>

          <SceneSetup lang={lang} />
          <SceneThemes lang={lang} />
          <SceneChat lang={lang} />
        </AppShell>
      </div>

      <SceneInterview lang={lang} />
    </div>

    <!-- Scroll cue: the stage pins on entry, so without this the page looks
         stuck. Fades out once the first step is underway. -->
    <div class="jcue" aria-hidden="true">
      <span class="jcue__label">{isDE ? 'Scrollen' : 'Scroll'}</span>
      <svg class="jcue__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </div>
  </ScrollStage>
</section>

<style>
  /* White ground: the dashboard's own canvas is grey (#F7F8FA), so a grey page
     behind it would swallow the mock. */
  .jsec {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  /* Two knowledge-loss beats run before the product tour, so the tour's own
     scene 0 sits at journey time 2. journey.css derives --jt from this. */
  .jsec :global(.jstage) { --t-off: 2; }

  /* Not full-bleed: the mock sits inside the normal content column. */
  .jframe {
    position: relative;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    height: 90%; max-height: 720px;
    /* Same gutters as .container, so the mock's edges line up with the
       section heading above it. */
    padding: 0 var(--space-6);
  }

  /* The mock sits on a white section, so without its own edge it dissolves
     into the page and the pinned frame reads as empty space with a toolbar
     floating in it. Border and shadow resolve LAST, per the choreography. */
  .jshell {
    width: 100%; height: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .jsec :global(.jstage.is-live) .jshell {
    --edge: clamp(0, calc((var(--jt) + 0.35) / 0.45), 1);
    border: 1px solid color-mix(in srgb, var(--color-border) calc(var(--edge) * 100%), transparent);
    box-shadow: 0 calc(18px * var(--edge)) calc(44px * var(--edge)) calc(-22px * var(--edge)) rgba(11, 12, 16, 0.16);
  }
  .jsec :global(.jstage:not(.is-live)) .jshell {
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }

  /* Breadcrumb — 13px, grey links, ink current page, chevron separators. */
  .crumb { display: flex; align-items: center; gap: 6px; font-size: 13px; min-width: 0; }
  .crumb__link { color: var(--color-text-secondary); white-space: nowrap; }
  .crumb__sep { color: var(--color-text-quaternary); }
  .crumb__now { color: var(--color-text-primary); font-weight: 500; white-space: nowrap; }

  /* Setup flow step pills. */
  .steps {
    display: inline-flex; gap: 4px; padding: 4px; width: fit-content;
    border-radius: var(--radius-ui); border: 1px solid var(--color-border);
    background: var(--color-surface-elevated);
  }
  .steps__pill {
    display: inline-flex; align-items: center; gap: 7px;
    height: 32px; padding: 0 13px;
    border-radius: var(--radius-sm); font-size: 13px; font-weight: 500;
    color: var(--color-text-secondary); white-space: nowrap;
  }
  /* A numbered dot per step, so the bar reads as "step 1 of 3" at a glance
     instead of as three unexplained words. */
  .steps__pill::before {
    content: counter(step); counter-increment: step;
    display: grid; place-items: center;
    width: 17px; height: 17px; border-radius: var(--radius-full);
    background: var(--color-border); color: var(--color-surface);
    font-size: 10px; font-weight: 700; font-variant-numeric: tabular-nums;
  }
  .steps { counter-reset: step; }
  .steps__pill--on {
    background: var(--color-surface); color: var(--color-text-primary);
    box-shadow: var(--shadow-xs);
  }
  .steps__pill--on::before { background: var(--color-accent); color: var(--color-text-primary); }
  .steps__pill--off { color: var(--color-text-tertiary); }

  .jcue {
    position: absolute; left: 50%; bottom: var(--space-4);
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    color: var(--color-text-tertiary);
    opacity: clamp(0, calc((0.35 - var(--t)) / 0.25), 1);
  }
  .jcue__label {
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.07em; text-transform: uppercase;
  }
  @media (prefers-reduced-motion: no-preference) {
    .jcue__arrow { animation: jcue-drift 1.8s var(--ease-smooth) infinite; }
  }
  @keyframes jcue-drift {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50%      { transform: translateY(4px); opacity: 1; }
  }

  @media (min-width: 768px) { .jframe { padding: 0 var(--space-8); } }

  @media (max-width: 1023px) {
    .jsec :global(.jstage.is-live) { height: calc(100svh + 420 * 1svh); }
    .jframe { max-height: none; }
  }

  /* No JS / reduced motion: nothing is pinned, so let the scenes stack. */
  .jsec :global(.jstage:not(.is-live)) .jframe {
    display: flex; flex-direction: column; gap: var(--space-16); height: auto;
  }
  .jsec :global(.jstage:not(.is-live)) .jcue { display: none; }
</style>
