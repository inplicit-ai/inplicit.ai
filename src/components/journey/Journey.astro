---
import ScrollStage from '../scroll/ScrollStage.astro';
import SceneKnowledgeLoss from './SceneKnowledgeLoss.astro';
import SceneAsk from './SceneAsk.astro';
import SceneInterviews from './SceneInterviews.astro';
import AppShell from './AppShell.astro';
import SceneInsights from './SceneInsights.astro';

export interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';
---

<section class="jsec" id="how-it-works">
  <!-- Full-bleed. The product labels itself through its own breadcrumb, so the
       journey carries no marketing copy of its own. -->
  <!-- One continuous flow, six beats:
         0  the knowledge in the organisation, invisible
         1  a person leaves and takes a piece of it
         2  the question
         3  the question gets typed and the campaign goes out
         4  fifteen interviews running, converging
         5  what comes back
       --t-off tells the dashboard chrome that the product tour's own scene 0
       sits at journey time 5. -->
  <ScrollStage scenes={6} travel={660}>
    <div class="jframe">
      <!-- The line that runs the whole journey. The path is generated from the
           frame's MEASURED pixel size, so the viewBox is 1:1 with the box and
           preserveAspectRatio has nothing to distort. Its sway tapers to zero
           before the fan, because below that point the split owns the centre
           and a line still wandering sideways there crosses it at an angle. -->
      <svg class="jline" data-jline preserveAspectRatio="none" aria-hidden="true">
        <path class="jline__path" fill="none" stroke-linecap="round" stroke-width="1.5" />
      </svg>

      <SceneKnowledgeLoss lang={lang} />
      <SceneAsk lang={lang} />
      <SceneInterviews lang={lang} />

      <!-- The last stretch of line: it fills the --stub gap, so it runs from
           where the strands come to rest down to the insight card's top edge.
           This is the piece the card grows out of, and the only line left once
           the interviews layer has gone. -->
      <span class="jstub" aria-hidden="true"></span>

      <!-- The insight frame is not placed on top of that line, it GROWS OUT of
           its lower end: the card is --stub shorter than the frame and sits at
           its bottom, so its top edge is exactly where the line stops, and the
           card only ever scales out of that edge. -->
      <div class="jshell">
        <AppShell lang={lang}>
          <nav class="jtopbar crumb" slot="topbar">
            <span class="crumb__link">{isDE ? 'Kampagnen' : 'Campaigns'}</span>
            <span class="crumb__sep">›</span>
            <span class="crumb__link">Post-Merger Integration: Meridian</span>
            <span class="crumb__sep">›</span>
            <span class="crumb__now">Insights</span>
          </nav>

          <SceneInsights lang={lang} />
        </AppShell>
      </div>
    </div>

    <!-- Scroll cue: the stage pins on entry, so without this the page looks
         stuck. Fades out once the first step is underway. -->
    <div class="jcue" aria-hidden="true">
      <span class="jcue__label">{isDE ? 'Scrollen' : 'Scroll'}</span>
      <svg class="jcue__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </div>
  </ScrollStage>
</section>

<style>
  /* White ground: the dashboard's own canvas is grey (#F7F8FA), so a grey page
     behind it would swallow the mock. */
  .jsec {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    /* The gap above the insight card. The card is that much shorter than the
       frame and sits at its bottom, so its top edge is a FIXED point the
       strands are brought to rest on. */
    --stub: 90px;
  }

  /* Five beats run before the dashboard appears, so the product tour's own
     scene 0 sits at journey time 5. journey.css derives --jt from this, and
     --shell-in is when the chrome is allowed on screen at all. */
  .jsec :global(.jstage) { --t-off: 5; --shell-in: 4.84; }

  /* --exit-th mirrors the interviews section's own exit ramp, so the frame
     below can be positioned against where that section comes to rest. */
  .jsec :global(.jstage.is-live) {
    /* Mirrors the interviews section's own exit ramp. */
    --exit-th: clamp(0, calc((var(--t) - 4.90) / 0.16), 1);
  }

  /* Not full-bleed: the mock sits inside the normal content column. */
  .jframe {
    position: relative;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    height: 90%; max-height: 720px;
    /* Same gutters as .container, so the mock's edges line up with the
       section heading above it. */
    padding: 0 var(--space-6);
  }

  /* The mock sits on a white section, so without its own edge it dissolves
     into the page and the pinned frame reads as empty space with a toolbar
     floating in it. Border and shadow resolve LAST, per the choreography. */
  /* Base state (no JS, reduced motion): the whole line, already drawn. */

  .jline {
    grid-area: 1 / 1;
    width: 100%; height: 100%;
    pointer-events: none;
    opacity: 0.62;
    overflow: visible;
  }
  .jline__path { stroke: var(--color-accent); }

  /* Drawn top to bottom. It stops at the fan while the split is running, runs
     on to the merge point once the strands are one line again, and stops there
     for good: from there the stub carries on to the card. */
  .jsec :global(.jstage.is-live) .jline {
    /* --jline-cap is the fan's apex as it stands RIGHT NOW, measured in the
       script below rather than modelled from a resting fraction plus a drop
       term. The modelled version drifted apart from the real fan whenever the
       two ramps disagreed, and a line that stops a hundred pixels past where
       the split begins reads as a break. */
    --rejoin: clamp(0, calc((var(--t) - 4.88) / 0.22), 1);
    --raw: clamp(0, calc((var(--t) + 0.34) / 5.74), 1);
    --cap: calc(var(--jline-cap, 1) + (var(--thread-stop, 1) - var(--jline-cap, 1)) * var(--rejoin));
    --p: min(var(--raw), var(--cap));
    clip-path: inset(0 0 calc(100% - 100% * var(--p)) 0);
  }

  .jstub {
    grid-area: 1 / 1;
    justify-self: center;
    align-self: start;
    width: 1.5px;
    height: var(--stub);
    background: var(--color-accent);
    pointer-events: none;
    opacity: 0;
  }
  /* Drawn downward as the strands arrive, held while the card grows out of its
     lower end, gone once the card stands on its own. */
  .jsec :global(.jstage.is-live) .jstub {
    transform-origin: center top;
    transform: scaleY(clamp(0, calc((var(--t) - 4.92) / 0.10), 1));
    opacity: calc(0.62 * min(
      clamp(0, calc((var(--t) - 4.92) / 0.06), 1),
      clamp(0, calc((5.52 - var(--t)) / 0.12), 1)
    ));
  }

  .jshell {
    position: relative;
    align-self: end;
    width: 100%; height: calc(100% - var(--stub));
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  /* Live: the card is ANCHORED at the point the strands run into and scales
     up out of it. Nothing translates, so it grows rather than arriving: the
     transform origin is that point, which means the card opens outward around
     it in every direction and its edges reach the frame exactly when it is
     done. A version that started below and rose into place read as sliding in,
     which is the opposite of being built. */
  .jsec :global(.jstage.is-live) .jshell {
    /* Strictly after the section has finished leaving at 5.06. */
    --born: clamp(0, calc((var(--t) - 5.08) / 0.34), 1);
    --settled: clamp(0, calc((var(--t) - 5.42) / 0.10), 1);
    /* Top centre on the merge point, opening downward and sideways from it.
       The point itself travels up with the departing section, so the card
       ends up in place without ever being slid there. */
    /* Pure growth out of its own top edge. No translate at all: the card's top
       IS the point the strands were brought to, so there is nothing left to
       move it to. */
    transform-origin: 50% 0;
    transform: scale(calc(0.02 + 0.98 * var(--born)));
    /* Orange while it is being drawn, the ordinary hairline once it stands. */
    border: 1.5px solid color-mix(in srgb, var(--color-border) calc(var(--settled) * 100%), var(--color-accent));
    box-shadow: 0 calc(18px * var(--settled)) calc(44px * var(--settled)) calc(-22px * var(--settled)) rgba(11, 12, 16, 0.16);
  }

  /* No JS / reduced motion: the frame is simply there, with no drawn outline. */
  .jsec :global(.jstage:not(.is-live)) .jshell {
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }

  /* Breadcrumb — 13px, grey links, ink current page, chevron separators. */
  .crumb { display: flex; align-items: center; gap: 6px; font-size: 13px; min-width: 0; }
  .crumb__link { color: var(--color-text-secondary); white-space: nowrap; }
  .crumb__sep { color: var(--color-text-quaternary); }
  .crumb__now { color: var(--color-text-primary); font-weight: 500; white-space: nowrap; }


  .jcue {
    position: absolute; left: 50%; bottom: var(--space-4);
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    color: var(--color-text-tertiary);
    opacity: clamp(0, calc((0.35 - var(--t)) / 0.25), 1);
  }
  .jcue__label {
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.07em; text-transform: uppercase;
  }
  @media (prefers-reduced-motion: no-preference) {
    .jcue__arrow { animation: jcue-drift 1.8s var(--ease-smooth) infinite; }
  }
  @keyframes jcue-drift {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50%      { transform: translateY(4px); opacity: 1; }
  }

  @media (min-width: 768px) { .jframe { padding: 0 var(--space-8); } }

  @media (max-width: 1023px) {
    .jsec :global(.jstage.is-live) { height: calc(100svh + 480 * 1svh); }
    .jframe { max-height: none; }
  }

  /* No JS / reduced motion: nothing is pinned, so let the scenes stack. */
  .jsec :global(.jstage:not(.is-live)) .jframe {
    display: flex; flex-direction: column; gap: var(--space-16); height: auto;
  }
  .jsec :global(.jstage:not(.is-live)) .jcue { display: none; }
</style>

<script>
  /* Builds the line. Everything is in the frame's own pixels: the viewBox is
     the measured box, so one user unit is one device-independent pixel and
     nothing gets scaled. The sway fades out above --thread-apex, the point
     where the fan takes over. Rebuilt only when the inputs actually change. */
  const svg = document.querySelector<SVGSVGElement>('[data-jline]');
  const path = svg?.querySelector<SVGPathElement>('.jline__path');
  const frame = document.querySelector<HTMLElement>('.jframe');

  if (svg && path && frame) {
    const PERIOD = 380;  // px per wave
    const SWAY = 24;     // px either side at full amplitude
    const STEPS = 16;
    let lastKey = '';

    const build = () => {
      const w = frame.clientWidth;
      const h = frame.clientHeight;
      if (!w || !h) return;
      const apex = parseFloat(getComputedStyle(frame).getPropertyValue('--thread-apex')) || 1;
      const key = `${w}x${h}x${apex.toFixed(3)}`;
      if (key === lastKey) return;
      lastKey = key;

      const cx = w / 2;
      const apexY = apex * h;
      const amp = (y: number) => {
        const full = apexY * 0.45;
        if (y <= full) return SWAY;
        if (y >= apexY) return 0;
        const t = (y - full) / (apexY - full);
        return SWAY * (1 - t * t * (3 - 2 * t));   // smoothstep, no corner
      };
      const xAt = (y: number) => cx + amp(y) * Math.sin((2 * Math.PI * y) / PERIOD);

      // Cubic segments with tangents from a finite difference: few segments,
      // exactly smooth joins, no polyline faceting.
      const step = h / STEPS;
      let d = `M${xAt(0).toFixed(2)} 0`;
      for (let i = 0; i < STEPS; i++) {
        const y0 = i * step, y1 = y0 + step, k = step / 3;
        const dx0 = xAt(y0 + 0.5) - xAt(y0 - 0.5);
        const dx1 = xAt(y1 + 0.5) - xAt(y1 - 0.5);
        d += ` C${(xAt(y0) + dx0 * k).toFixed(2)} ${(y0 + k).toFixed(2)}`
           + ` ${(xAt(y1) - dx1 * k).toFixed(2)} ${(y1 - k).toFixed(2)}`
           + ` ${xAt(y1).toFixed(2)} ${y1.toFixed(2)}`;
      }
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      path.setAttribute('d', d);
    };

    build();
    addEventListener('resize', build, { passive: true });
    /* --thread-apex is measured by the interviews scene on its first scroll,
       so keep checking until it settles; build() is a no-op after that. */
    addEventListener('scroll', build, { passive: true });
  }
</script>
