---
import ScrollStage from '../scroll/ScrollStage.astro';
import SceneKnowledgeLoss from './SceneKnowledgeLoss.astro';
import SceneAsk from './SceneAsk.astro';
import SceneInterviews from './SceneInterviews.astro';
import AppShell from './AppShell.astro';
import SceneInsights from './SceneInsights.astro';

export interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';
---

<section class="jsec" id="how-it-works">
  <!-- Full-bleed. The product labels itself through its own breadcrumb, so the
       journey carries no marketing copy of its own. -->
  <!-- One continuous flow, six beats:
         0  the knowledge in the organisation, invisible
         1  a person leaves and takes a piece of it
         2  the question
         3  the question gets typed and the campaign goes out
         4  fifteen interviews running, converging
         5  what comes back
       --t-off tells the dashboard chrome that the product tour's own scene 0
       sits at journey time 5. -->
  <ScrollStage scenes={6} travel={660}>
    <div class="jframe">
      <!-- One line down the whole journey: a plain rule on the frame's vertical
           centre, revealed top to bottom as --t advances. It sits exactly where
           the fan, the strands and the merge sit, so the split reads as this
           same line coming apart and closing again. -->
      <span class="jthread" aria-hidden="true"></span>

      <SceneKnowledgeLoss lang={lang} />
      <SceneAsk lang={lang} />
      <SceneInterviews lang={lang} />

      <!-- The insight frame is not placed on top of the line, it GROWS OUT of
           it: the clip starts as a hairline-wide sliver sitting on the thread
           at the top centre and opens outward and downward into the full card.
           Because the frame's own orange edge is revealed by that same clip,
           the outline draws itself as a consequence of the growth rather than
           as a second animation on top of it. -->
      <div class="jshell">
        <AppShell lang={lang}>
          <nav class="jtopbar crumb" slot="topbar">
            <span class="crumb__link">{isDE ? 'Kampagnen' : 'Campaigns'}</span>
            <span class="crumb__sep">›</span>
            <span class="crumb__link">Post-Merger Integration: Meridian</span>
            <span class="crumb__sep">›</span>
            <span class="crumb__now">Insights</span>
          </nav>

          <SceneInsights lang={lang} />
        </AppShell>
      </div>
    </div>

    <!-- Scroll cue: the stage pins on entry, so without this the page looks
         stuck. Fades out once the first step is underway. -->
    <div class="jcue" aria-hidden="true">
      <span class="jcue__label">{isDE ? 'Scrollen' : 'Scroll'}</span>
      <svg class="jcue__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M19 12l-7 7-7-7"/>
      </svg>
    </div>
  </ScrollStage>
</section>

<style>
  /* White ground: the dashboard's own canvas is grey (#F7F8FA), so a grey page
     behind it would swallow the mock. */
  .jsec {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    /* The gap the thread's last stretch lives in, above the insight card.
       The card is that much shorter than the frame and sits at its bottom, so
       its top edge is a FIXED point the strands can be brought to rest on. */
    --stub: 90px;
  }

  /* Five beats run before the dashboard appears, so the product tour's own
     scene 0 sits at journey time 5. journey.css derives --jt from this, and
     --shell-in is when the chrome is allowed on screen at all. */
  .jsec :global(.jstage) { --t-off: 5; --shell-in: 4.84; }

  /* The line's whole life, in one place.
       --cap-lo   how far down it is drawn (it ends at the fan, then at the merge)
       --retract  how far its TOP has been pulled down after the merge, so that
                  what is left is a short stub above the card rather than a rule
                  the height of the frame. */
  .jsec :global(.jstage.is-live) {
    --retract: clamp(0, calc((var(--t) - 5.00) / 0.20), 1);
    /* Mirrors the interviews section's own exit ramp. */
    --exit-th: clamp(0, calc((var(--t) - 4.90) / 0.16), 1);
  }

  /* Not full-bleed: the mock sits inside the normal content column. */
  .jframe {
    position: relative;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    height: 90%; max-height: 720px;
    /* Same gutters as .container, so the mock's edges line up with the
       section heading above it. */
    padding: 0 var(--space-6);
  }

  /* The mock sits on a white section, so without its own edge it dissolves
     into the page and the pinned frame reads as empty space with a toolbar
     floating in it. Border and shadow resolve LAST, per the choreography. */
  .jthread {
    grid-area: 1 / 1;
    justify-self: center;
    width: 1.5px;
    height: 100%;
    background: var(--color-accent);
    pointer-events: none;
    opacity: 0.62;
  }
  /* Base state (no JS, reduced motion): the whole line, already drawn. */
  .jsec :global(.jstage.is-live) .jthread {
    /* Starts with a head already drawn: the line has to be there when the
       section arrives, not after a screen of scrolling. */
    --raw: clamp(0, calc((var(--t) + 0.34) / 5.74), 1);
    /* The line has to END where the fan begins, or it just runs through the
       split and the whole thing reads as two drawings laid over each other
       instead of one line coming apart.
         - during the split it stops at the fan's apex (which sits lower while
           the layer is still dropped against the campaign card, hence the
           --drop-frac term: the cap follows it),
         - once the strands have merged it runs on to that merge point, one
           line again,
         - and there it stops for good, because that is where the insight
           frame is born and the frame covers it as it opens. */
    --drop-th: clamp(0, calc((4.24 - var(--t)) / 0.12), 1);
    --apex-now: calc(var(--thread-apex, 1) + var(--drop-frac, 0) * var(--drop-th));
    --rejoin: clamp(0, calc((var(--t) - 4.88) / 0.22), 1);
    /* All of this in LENGTHS, because the end of the line has to land on the
       card's top edge, and that edge is --stub from the frame's bottom section
       rather than a percentage. */
    --apex-len: calc(var(--apex-now) * 100%);
    --merge-len: calc(var(--thread-stop, 0.9) * 100%
                      - (var(--thread-stop, 0.9) * 100% - var(--stub)) * var(--exit-th));
    --cap-len: calc(var(--apex-len) + (var(--merge-len) - var(--apex-len)) * var(--rejoin));
    --raw-len: calc(var(--raw) * 100%);
    /* Top pulled down once the strands are one line again, leaving exactly the
       stub above the card instead of a rule down the whole frame. */
    clip-path: inset(
      calc(max(0px, var(--cap-len) - var(--stub)) * var(--retract))
      0
      calc(100% - min(var(--raw-len), var(--cap-len)))
      0
    );
  }

  .jshell {
    position: relative;
    align-self: end;
    width: 100%; height: calc(100% - var(--stub));
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  /* Live: the card is ANCHORED at the point the strands run into and scales
     up out of it. Nothing translates, so it grows rather than arriving: the
     transform origin is that point, which means the card opens outward around
     it in every direction and its edges reach the frame exactly when it is
     done. A version that started below and rose into place read as sliding in,
     which is the opposite of being built. */
  .jsec :global(.jstage.is-live) .jshell {
    /* Strictly after the section has finished leaving at 5.06. */
    --born: clamp(0, calc((var(--t) - 5.08) / 0.34), 1);
    --settled: clamp(0, calc((var(--t) - 5.42) / 0.10), 1);
    /* Top centre on the merge point, opening downward and sideways from it.
       The point itself travels up with the departing section, so the card
       ends up in place without ever being slid there. */
    /* Pure growth out of its own top edge. No translate at all: the card's top
       IS the point the strands were brought to, so there is nothing left to
       move it to. */
    transform-origin: 50% 0;
    transform: scale(calc(0.02 + 0.98 * var(--born)));
    /* Orange while it is being drawn, the ordinary hairline once it stands. */
    border: 1.5px solid color-mix(in srgb, var(--color-border) calc(var(--settled) * 100%), var(--color-accent));
    box-shadow: 0 calc(18px * var(--settled)) calc(44px * var(--settled)) calc(-22px * var(--settled)) rgba(11, 12, 16, 0.16);
  }

  /* No JS / reduced motion: the frame is simply there, with no drawn outline. */
  .jsec :global(.jstage:not(.is-live)) .jshell {
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }

  /* Breadcrumb — 13px, grey links, ink current page, chevron separators. */
  .crumb { display: flex; align-items: center; gap: 6px; font-size: 13px; min-width: 0; }
  .crumb__link { color: var(--color-text-secondary); white-space: nowrap; }
  .crumb__sep { color: var(--color-text-quaternary); }
  .crumb__now { color: var(--color-text-primary); font-weight: 500; white-space: nowrap; }


  .jcue {
    position: absolute; left: 50%; bottom: var(--space-4);
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    color: var(--color-text-tertiary);
    opacity: clamp(0, calc((0.35 - var(--t)) / 0.25), 1);
  }
  .jcue__label {
    font-size: 11px; font-weight: 500;
    letter-spacing: 0.07em; text-transform: uppercase;
  }
  @media (prefers-reduced-motion: no-preference) {
    .jcue__arrow { animation: jcue-drift 1.8s var(--ease-smooth) infinite; }
  }
  @keyframes jcue-drift {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50%      { transform: translateY(4px); opacity: 1; }
  }

  @media (min-width: 768px) { .jframe { padding: 0 var(--space-8); } }

  @media (max-width: 1023px) {
    .jsec :global(.jstage.is-live) { height: calc(100svh + 480 * 1svh); }
    .jframe { max-height: none; }
  }

  /* No JS / reduced motion: nothing is pinned, so let the scenes stack. */
  .jsec :global(.jstage:not(.is-live)) .jframe {
    display: flex; flex-direction: column; gap: var(--space-16); height: auto;
  }
  .jsec :global(.jstage:not(.is-live)) .jcue { display: none; }
</style>
