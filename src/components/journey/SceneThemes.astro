---
/**
 * SceneThemes — pixel mock of the dashboard's Insights work-area content
 * (AppShell.astro supplies the sidebar/topbar chrome around every scene;
 * this file renders only what sits below the campaign tab bar).
 *
 * Card design is copied verbatim from the currently-shipped reference:
 * src/components/HowItWorks.astro, scene 3 ("Suggestions" / .ins* classes).
 * Do not diverge from that anatomy without re-reading it first.
 *
 * Scenario: an M&A advisory running post-merger integration (PMI) diligence
 * for a client — Halden (acquirer) absorbing Meridian (target). Interviews
 * surface integration risk a data room never shows.
 *
 * Facts pinned against the real product (do not "improve" without re-checking):
 *  - there is no quote-level linking UI; nothing here claims to point at one
 *    exact quote.
 *  - the cluster thresholds are internal and must never be printed; a flat
 *    confidence percentage as text is fine, the math behind it is not.
 *  - any interview count refers to INTERVIEWS, never people.
 */
export interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const en = lang === 'en';

const tabs = [
  { label: en ? 'Overview' : 'Übersicht', active: false },
  { label: en ? 'Participants' : 'Teilnehmer', active: false },
  { label: en ? 'Interviews' : 'Interviews', active: false },
  { label: en ? 'Insights' : 'Insights', active: true },
  { label: en ? 'Cross-Validation' : 'Cross-Validation', active: false },
  { label: en ? 'Agent' : 'Agent', active: false },
  { label: en ? 'Ask' : 'Fragen', active: false },
];

const t = {
  heading: 'Insights',
  problem: en ? 'Problem' : 'Problem',
  idea: en ? 'Idea' : 'Idee',
  opportunity: en ? 'Opportunity' : 'Chance',
};

const cards = [
  {
    title: en ? 'Insight: process ownership' : 'Einblick: Prozessverantwortung',
    dept: en ? 'Meridian Finance' : 'Meridian Finanzen',
    problem: en ? 'Reconciliation sits with two teams after the merger, and neither is marked as owner.' : 'Der Abgleich liegt nach der Fusion bei zwei Teams, ohne dass eines als Verantwortlicher markiert ist.',
    idea: en ? 'One named owner per process, fixed in the integration RACI.' : 'Ein benannter Verantwortlicher pro Prozess, festgelegt in der Integrations-RACI.',
    opportunity: en ? 'Fewer dropped handoffs during the transition window.' : 'Weniger verlorene Übergaben im Übergangsfenster.',
    proofs: en ? '9 proofs' : '9 Belege',
    confidence: en ? 'Confidence 84%' : 'Konfidenz 84 %',
    phase: en ? 'Integration phase' : 'Integrationsphase',
    axis: 'left', g: 2, rot: -1.5,
  },
  {
    title: en ? 'Insight: client handover' : 'Einblick: Kundenübergabe',
    dept: en ? 'Halden Sales' : 'Halden Vertrieb',
    problem: en ? 'Meridian account leads leave before named successors are briefed.' : 'Meridian-Kundenbetreuer verlassen das Unternehmen, bevor Nachfolger eingearbeitet sind.',
    idea: en ? 'A transition briefing template filled in before each departure.' : 'Eine Übergabe-Vorlage, die vor jedem Abgang ausgefüllt wird.',
    opportunity: en ? 'Client relationships survive the reorganisation intact.' : 'Kundenbeziehungen bleiben durch die Reorganisation hindurch erhalten.',
    proofs: en ? '6 proofs' : '6 Belege',
    confidence: en ? 'Confidence 77%' : 'Konfidenz 77 %',
    phase: en ? 'Integration phase' : 'Integrationsphase',
    axis: 'right', g: 3, rot: 1.5,
  },
];
---

<div class="jscene" style="--t0: 5" data-last aria-hidden="true">
  <div class="shell">

    <nav class="tabs jpart" data-axis="down" data-weight="chrome" style="--g:0">
      {tabs.map((tab) => (
        <span class={`tab ${tab.active ? 'tab--active' : ''}`}>{tab.label}</span>
      ))}
    </nav>

    <h3 class="section-heading jpart" data-axis="down" data-weight="chrome" style="--g:1">{t.heading}</h3>

    <div class="ins">
      {cards.map((c, i) => (
        <article class="ins__card jpart" data-axis={c.axis} style={`--g:${c.g}; --card-rot:${c.rot}deg`}>
          <header class="ins__bar">
            <span class="ins__num">{i + 1}</span>
            <span class="ins__title">{c.title}</span>
            <span class="ins__dept">{c.dept}</span>
          </header>
          <div class="ins__rows">
            <div class="ins__row"><span class="tlabel">{t.problem}</span><span class="ttext">{c.problem}</span></div>
            <div class="ins__row"><span class="tlabel">{t.idea}</span><span class="ttext">{c.idea}</span></div>
            <div class="ins__row"><span class="tlabel">{t.opportunity}</span><span class="ttext">{c.opportunity}</span></div>
          </div>
          <footer class="ins__foot">
            <span>{c.proofs}</span><span class="ins__sep">·</span>
            <span>{c.confidence}</span><span class="ins__sep">·</span>
            <span>{c.phase}</span>
          </footer>
        </article>
      ))}
    </div>

  </div>
</div>

<style>
  .jscene {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--color-surface);
    font-family: var(--font-family);
  }
  .shell {
    width: 100%; height: 100%;
    padding: 16px 24px; overflow: hidden;
    display: flex; flex-direction: column; gap: 12px;
  }

  .tabs {
    display: flex; align-items: center; gap: 2px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 4px;
  }
  .tab {
    position: relative;
    display: inline-flex; align-items: center;
    padding: 9px 12px; margin-bottom: -1px;
    font-size: 13.5px; color: var(--color-text-secondary);
    white-space: nowrap;
  }
  .tab:first-child { padding-left: 0; }
  .tab--active { color: var(--color-text-primary); font-weight: 500; }
  .tab--active::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px;
    height: 2px; background: var(--brand-blue);
  }

  .section-heading { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; color: var(--color-text-primary); }

  /* ── Insights triad cards (copied from HowItWorks.astro scene 3) ── */
  .ins { display: flex; flex-direction: column; gap: var(--space-3); }

  .ins__card { border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); overflow: hidden; }
  /* Card must translate AND rotate as one unit; journey.css only supplies
     the translate, so this composes the rotate on top of the settle value. */
  .ins__card.jpart { transform: translate3d(calc(var(--dx, 0px) * (1 - var(--s))), calc(var(--dy, 0px) * (1 - var(--s))), 0) rotate(calc(var(--card-rot, 0deg) * (1 - var(--s)))); }

  .ins__bar {
    display: flex; align-items: center; gap: 8px;
    padding: 7px var(--space-3);
    background: var(--color-surface-elevated);
    border-bottom: 1px solid var(--color-border);
  }
  .ins__num {
    flex-shrink: 0; width: 17px; height: 17px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-accent); color: var(--color-canvas-dark);
    font-size: 10px; font-weight: 800; font-variant-numeric: tabular-nums;
  }
  .ins__title { font-size: 11px; font-weight: 600; color: var(--color-text-primary); letter-spacing: -0.01em; }
  .ins__dept {
    margin-left: auto; flex-shrink: 0;
    font-size: 9px; font-weight: 600; color: var(--color-text-secondary);
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 2px 8px;
  }

  .ins__rows { display: flex; flex-direction: column; padding: 0 var(--space-4); }
  .ins__row { display: flex; flex-direction: column; gap: 2px; padding: var(--space-2) 0; border-top: 1px solid var(--color-border-subtle); }
  .ins__row:first-child { border-top: none; padding-top: var(--space-3); }
  .tlabel { font-size: 10px; font-weight: 500; color: var(--color-text-tertiary); }
  .ttext { font-size: 11.5px; line-height: 1.45; color: var(--color-text-primary); }

  .ins__foot {
    display: flex; align-items: center; gap: 5px;
    padding: 7px var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
    background: var(--color-bg);
    font-size: 9.5px; color: var(--color-text-tertiary);
  }
  .ins__sep { opacity: 0.5; }

  @media (max-width: 1023px) {
    .shell { padding: 16px 18px; gap: 10px; }
    .tabs { overflow-x: auto; }
  }
</style>
