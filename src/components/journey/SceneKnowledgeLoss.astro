---
/**
 * SceneKnowledgeLoss — the two beats the journey opens on, before any product
 * is shown. A frame-level layer inside the journey's own stage, NOT a separate
 * section: the whole thing is one continuous scroll.
 *
 *   0 → 1  The field fills in. Every bubble is one piece of knowledge, and
 *          almost all of them are drawn as hollow rings: the knowledge is
 *          there, nobody can see or reach it. The handful of filled dots are
 *          the fraction that actually got written down somewhere.
 *   1 → 2  One person leaves. Her rings drift after her and fade out, and the
 *          hole they leave stays on screen.
 *
 * The field is deliberately NOT inside a .jscene: it persists across both beats
 * on absolute journey time (--lt: var(--t)), the same trick AppShell uses for
 * the dashboard chrome. Only the left-hand copy swaps, so the loss reads as one
 * continuous picture instead of two slides. The layer then clears out as the
 * question takes over at --t 2.
 *
 * Base markup (no .is-live) is the full, assembled field with nobody gone. That
 * is the no-JS and reduced-motion state, per the journey.css contract.
 */
// The choreography contract this scene is written against. ScrollStage pulls it
// in too, but this scene reads .jstage/.jscene/.jpart directly, so it declares
// the dependency itself rather than relying on a sibling to have loaded it.
import '../../styles/journey.css';

export interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

// Deterministic scatter: same seed, same field on every build.
const rand = (s: number) => () => {
  s = (s + 0x6d2b79f5) | 0;
  let t = Math.imul(s ^ (s >>> 15), 1 | s);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const CENTRE = 50;
const R_FIELD = 48;   // field radius, in % of the square stage
const R_CLEAR = 8;    // her own node needs room
const R_LOST = 26;    // roughly where her knowledge ends

const next = rand(20260915);
const field: { x: number; y: number; w: number; g: number; lost: boolean; filled: boolean; ddx: number; ddy: number }[] = [];
for (let tries = 0; tries < 9000 && field.length < 124; tries++) {
  const a = next() * Math.PI * 2;
  // sqrt keeps the disc evenly covered instead of crowding the middle
  const d = Math.sqrt(next()) * R_FIELD;
  if (d < R_CLEAR) continue;
  const x = CENTRE + Math.cos(a) * d;
  const y = CENTRE + Math.sin(a) * d;
  const r = 1.15 + next() * next() * 2.9;
  if (field.some((b) => Math.hypot(b.x - x, b.y - y) < b.w / 2 + r + 1.25)) continue;
  // A ragged boundary, not a drawn circle: the hole has to look like something
  // was pulled out of the field, not like a shape was placed on top of it. A
  // few small outliers further out go too, because her work touched them.
  const lost = d < R_LOST * (0.8 + 0.4 * next()) || (r < 1.9 && next() < 0.07);
  field.push({
    x, y, w: r * 2,
    // The small minority that somebody actually wrote down. Everything else
    // stays a hollow ring: present, unreadable, unreachable.
    filled: next() < 0.12,
    g: Math.min(4, Math.floor((d / R_FIELD) * 5)),
    lost,
    // her knowledge drifts after her: inward, then up and out
    ddx: (CENTRE - x) * 0.42,
    ddy: (CENTRE - y) * 0.42 - 7,
  });
}

const t = isDE
  ? {
      head0: 'Das meiste Wissen Ihrer Organisation sieht niemand.',
      sub0: 'Es steckt in Erfahrung, in Gewohnheiten, in Gesprächen auf dem Flur. Aufgeschrieben ist fast nichts davon.',
      chip: 'Wissen der Organisation',
      legendHidden: 'nicht dokumentiert',
      legendKnown: 'irgendwo festgehalten',
      head1: 'Und jeden Tag geht davon etwas verloren.',
      sub1: 'Verlässt jemand das Unternehmen, geht sein Wissen mit. Die Nachfolge fängt wieder bei null an.',
    }
  : {
      head0: 'Most of what your organisation knows, nobody can see.',
      sub0: 'It lives in experience, in habits, in conversations by the coffee machine. Almost none of it is written down.',
      chip: 'What the organisation knows',
      legendHidden: 'not documented',
      legendKnown: 'written down somewhere',
      head1: 'And every day, some of it leaves.',
      sub1: 'When someone leaves the company, their knowledge goes with them. Their successor starts from zero.',
    };
---

<div class="kl">
  <div class="pframe">

    <div class="pcopy">
      <div class="pcopy__scenes">
        <div class="jscene" style="--t0: 0">
          <h2 class="pcopy__head jpart" data-axis="up" style="--g: 0">{t.head0}</h2>
          <p class="pcopy__sub jpart" data-axis="up" style="--g: 1">{t.sub0}</p>
        </div>

        <div class="jscene" style="--t0: 1">
          <h2 class="pcopy__head jpart" data-axis="up" style="--g: 0">{t.head1}</h2>
          <p class="pcopy__sub jpart" data-axis="up" style="--g: 1">{t.sub1}</p>
        </div>
      </div>
    </div>

    <div class="kf" aria-hidden="true">
      <div class="kf__disc">
        <span class="kf__hole"></span>

        {field.map((b) => (
          <span
            class={`kf__b${b.lost ? ' kf__b--lost' : ''}${b.filled ? ' kf__b--known' : ''}`}
            style={`--x:${b.x.toFixed(2)}%;--y:${b.y.toFixed(2)}%;--w:${b.w.toFixed(2)}%;--g:${b.g}${b.lost ? `;--ddx:${b.ddx.toFixed(1)}%;--ddy:${b.ddy.toFixed(1)}%` : ''}`}
          ></span>
        ))}

        <span class="kf__person"></span>
      </div>

      <p class="kf__chip">
        <span class="kf__key"><span class="kf__key-dot kf__key-dot--hidden"></span>{t.legendHidden}</span>
        <span class="kf__key"><span class="kf__key-dot kf__key-dot--known"></span>{t.legendKnown}</span>
      </p>
    </div>

  </div>
</div>

<style>
  /* ── Layer ──────────────────────────────────────────────────────────── */
  /* Stacks in the journey frame's single cell, like .jshell does. */
  .kl { grid-area: 1 / 1; display: flex; align-items: center; width: 100%; height: 100%; }

  .pframe {
    width: 100%;
    display: grid;
    grid-template-columns: 0.92fr 1fr;
    align-items: center;
    gap: var(--space-16);
  }

  /* ── Copy ───────────────────────────────────────────────────────────── */
  .pcopy { display: flex; flex-direction: column; gap: var(--space-6); }

  /* Both copy beats share one cell and start on the same line, so the heading
     does not jump when the scenes swap. */
  .pcopy__scenes {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  .pcopy__scenes .jscene { grid-area: 1 / 1; display: flex; flex-direction: column; }

  .pcopy__head {
    font-size: clamp(var(--text-xl), 3.2vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text-primary);
    max-width: 18ch;
  }
  .pcopy__sub {
    margin-top: var(--space-5);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 44ch;
  }

  /* ── Knowledge field ────────────────────────────────────────────────── */
  .kf { display: flex; flex-direction: column; align-items: center; gap: var(--space-5); }

  .kf__disc {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1;
  }

  .kf__b {
    position: absolute;
    left: calc(var(--x) + var(--ddx, 0%) * var(--gone, 0));
    top: calc(var(--y) + var(--ddy, 0%) * var(--gone, 0));
    width: var(--w);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    /* A ring, not a dot: the knowledge is there, and there is nothing to read
       inside it. A flat 1.5px reads as a ring at every bubble size here
       (roughly 6px to 30px across). */
    border: 1.5px solid var(--color-border-strong);
  }
  /* The fraction somebody actually wrote down. */
  .kf__b--known { background: var(--color-border-strong); border-color: transparent; }
  /* Hers are orange from the first beat, so the thing that disappears is the
     thing the eye was already tracking. */
  .kf__b--lost { border-color: var(--color-accent); }
  .kf__b--lost.kf__b--known { background: var(--color-accent); border-color: transparent; }

  .kf__hole {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px dashed var(--color-accent-muted);
    transform: translate(-50%, -50%);
    opacity: 0;
  }

  /* The person at the centre is a node like the rest of the field, only
     heavier. A photograph would make it one named individual; the point is
     that it is anybody. */
  .kf__person {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9%;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .kf__chip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
  .kf__key { display: inline-flex; align-items: center; gap: 7px; }
  .kf__key-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
  .kf__key-dot--hidden { border: 1.5px solid var(--color-border-strong); }
  .kf__key-dot--known { background: var(--color-border-strong); }

  /* ── Live choreography (pure functions of --t) ───────────────────────── */
  /* The opening owns the frame for two beats, then hands it to the tour. */
  :global(.jstage.is-live) .kl {
    pointer-events: none;
    opacity: clamp(0, calc((2.12 - var(--t)) / 0.12), 1);
  }

  /* The field runs on ABSOLUTE journey time: it has to survive the scene swap. */
  :global(.jstage.is-live) .kf { --lt: var(--t); }

  :global(.jstage.is-live) .kf__b {
    /* rings fill outward, so the middle (hers) is populated first */
    --d: calc(var(--g) * 0.09);
    --in: clamp(0, calc((var(--lt) - var(--d)) / 0.42), 1);
    opacity: calc(0.92 * var(--in));
    transform: translate(-50%, -50%) scale(calc(0.35 + 0.65 * var(--in)));
  }

  :global(.jstage.is-live) .kf__b--lost {
    --gone: clamp(0, calc((var(--lt) - 1.02 - var(--g) * 0.03) / 0.44), 1);
    opacity: calc(var(--in) * (1 - var(--gone)));
    transform: translate(-50%, -50%) scale(calc((0.35 + 0.65 * var(--in)) * (1 - 0.55 * var(--gone))));
  }

  :global(.jstage.is-live) .kf__person {
    --inp: clamp(0, calc((var(--lt) - 0.22) / 0.40), 1);
    --gonep: clamp(0, calc((var(--lt) - 1.00) / 0.40), 1);
    top: calc(50% - 7% * var(--gonep));
    opacity: calc(var(--inp) * (1 - var(--gonep)));
    transform: translate(-50%, -50%) scale(calc(0.6 + 0.4 * var(--inp)));
  }

  /* The hole only exists once her bubbles are actually gone. */
  :global(.jstage.is-live) .kf__hole {
    opacity: clamp(0, calc((var(--lt) - 1.30) / 0.40), 1);
  }

  :global(.jstage.is-live) .kf__chip {
    opacity: clamp(0, calc(var(--lt) / 0.30), 1);
  }

  /* ── Stacked below the 2-column breakpoint ──────────────────────────── */
  @media (max-width: 1023px) {
    .pframe {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
    .pcopy__head { max-width: none; }
    .pcopy__sub { max-width: none; }
    /* The pin is one viewport tall and the copy sits above the field on this
       breakpoint, so the disc has to leave room for both. */
    .kf__disc { max-width: min(330px, 68vw); }
    .kf { gap: var(--space-4); }
  }
</style>
