---
/**
 * SceneInterviews — beat 4. The campaign is out, so the conversations run.
 *
 * The orange thread that has led down the whole journey splits here: one
 * strand per column, running behind the windows, and merging again at the
 * bottom into the insight frame. The wires are one SVG over the same box as
 * the grid, in a 0-100 viewBox with preserveAspectRatio="none", so the strands
 * line up with the columns at any width without measuring anything.
 *
 * Each window is the interview room in miniature: the agent's orb on the left,
 * the conversation hinted on the right. The count is deliberately not in the
 * copy, only in how many windows there happen to be.
 *
 * Everything is a function of absolute journey time, so scrolling back deals
 * the windows out again. The typing dots are the one exception: a conversation
 * that freezes when you stop scrolling reads as dead, so they run on their own
 * keyframes and stop when the beat is off screen.
 */
import '../../styles/journey.css';

export interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

const rand = (s: number) => () => {
  s = (s + 0x6d2b79f5) | 0;
  let t = Math.imul(s ^ (s >>> 15), 1 | s);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const next = rand(4815162342);

const COLS = 5, ROWS = 3;
const windows = Array.from({ length: COLS * ROWS }, (_, i) => {
  const col = i % COLS, row = Math.floor(i / COLS);
  return {
    no: String(i + 1).padStart(2, '0'),
    col, row,
    // three hinted turns: agent, reply, agent. Widths only; at this size the
    // words would be noise.
    lines: Array.from({ length: 3 }, (_, k) => ({ me: k === 1, w: Math.round((k === 1 ? 52 : 70) + next() * 26) })),
    // deal order runs outward from the middle of the grid
    g: Math.round(Math.hypot(col - (COLS - 1) / 2, (row - (ROWS - 1) / 2) * 1.6) * 1.35),
    beat: (1.05 + next() * 0.5).toFixed(2),
    dx: ((COLS - 1) / 2 - col) * 100,
    dy: ((ROWS - 1) / 2 - row) * 100,
  };
});

// Column centres in the 0-100 wire viewBox.
const strands = Array.from({ length: COLS }, (_, c) => +(((c + 0.5) / COLS) * 100).toFixed(2));

const t = isDE
  ? { head: 'Jede Person wird einzeln befragt.', sub: 'Anonym, im Gespräch mit dem Agenten, wann es ihr passt.', label: 'Interview' }
  : { head: 'Everyone is interviewed separately.', sub: 'Anonymously, in conversation with the agent, whenever it suits them.', label: 'Interview' };
---

<div class="iv">
  <div class="iv__inner">
    <header class="iv__head">
      <h2 class="iv__title">{t.head}</h2>
      <p class="iv__sub">{t.sub}</p>
    </header>

    <div class="iv__stage">
      <!-- The thread, split into one strand per column and merged again. -->
      <svg class="iv__wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {strands.map((x) => (
          <path
            class="iv__wire"
            vector-effect="non-scaling-stroke"
            d={`M50 -14 C 50 -2 ${x} 0 ${x} 12 L ${x} 88 C ${x} 100 50 102 50 114`}
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="1.25"
            stroke-linecap="round"
          />
        ))}
      </svg>

      <div class="iv__grid">
        {windows.map((w) => (
          <div class="win" style={`--g:${w.g};--dx:${w.dx}%;--dy:${w.dy}%;--beat:${w.beat}s`}>
            <span class="win__no">{t.label} {w.no}</span>
            <div class="win__body">
              <span class="win__orb"></span>
              <div class="win__thread" aria-hidden="true">
                {w.lines.map((l) => (
                  <span class={`win__line${l.me ? ' win__line--me' : ''}`} style={`width:${l.w}%`}></span>
                ))}
                <span class="win__typing"><span style="--i:0"></span><span style="--i:1"></span><span style="--i:2"></span></span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .iv { grid-area: 1 / 1; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
  .iv__inner { display: flex; flex-direction: column; gap: var(--space-8); width: 100%; max-width: 960px; padding: 0 var(--space-6); }

  .iv__head { text-align: center; }
  .iv__title {
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    font-weight: 400; letter-spacing: -0.035em; line-height: 1.15;
    color: var(--color-text-primary);
  }
  .iv__sub { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--color-text-secondary); }

  .iv__stage { position: relative; }
  .iv__wires { position: absolute; inset: -6% 0; width: 100%; height: 112%; pointer-events: none; opacity: 0.45; }

  .iv__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .win {
    display: flex; flex-direction: column; gap: 7px;
    padding: 9px 10px;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
    min-width: 0;
  }
  .win__no {
    font-size: 9.5px; font-weight: 600; letter-spacing: 0.03em;
    color: var(--color-text-tertiary);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* The interview room in miniature: orb left, conversation right. */
  .win__body { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .win__orb {
    width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
    background: radial-gradient(circle at 34% 30%, #fff 0%, var(--orb-teal) 46%, color-mix(in srgb, var(--orb-teal) 62%, var(--color-canvas-dark)) 100%);
    box-shadow: 0 0 0 3px var(--orb-teal-soft);
  }
  .win__thread { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
  .win__line { height: 4px; border-radius: 2px; background: var(--color-border); }
  .win__line--me { align-self: flex-end; background: color-mix(in srgb, var(--orb-teal) 34%, transparent); }
  .win__typing { display: inline-flex; gap: 3px; margin-top: 1px; }
  .win__typing span { width: 3px; height: 3px; border-radius: 50%; background: var(--orb-teal); opacity: 0.45; }

  /* ── Live choreography ─────────────────────────────────────────────────── */
  /* Absolute journey time.  4.0 windows deal in · 4.74 they converge ·
     5.0 handed over to the insight frame. */
  :global(.jstage.is-live) .iv {
    pointer-events: none;
    opacity: min(
      clamp(0, calc((var(--t) - 3.94) / 0.14), 1),
      clamp(0, calc((5.02 - var(--t)) / 0.16), 1)
    );
  }

  :global(.jstage.is-live) .iv__head {
    opacity: min(
      clamp(0, calc((var(--t) - 4.02) / 0.20), 1),
      clamp(0, calc((4.76 - var(--t)) / 0.14), 1)
    );
  }

  /* The split draws itself just before the windows land on it, and stays until
     the merge has pulled everything into the insight frame. */
  :global(.jstage.is-live) .iv__wires {
    --p: clamp(0, calc((var(--t) - 3.96) / 0.30), 1);
    clip-path: inset(0 0 calc(100% - 100% * var(--p)) 0);
  }

  :global(.jstage.is-live) .win {
    --in: clamp(0, calc((var(--t) - 4.06 - var(--g) * 0.045) / 0.26), 1);
    --home: clamp(0, calc((var(--t) - 4.74) / 0.26), 1);
    opacity: calc(var(--in) * (1 - var(--home)));
    transform:
      translate3d(calc(var(--dx) * var(--home) * 0.5), calc(14px * (1 - var(--in)) + var(--dy) * var(--home) * 0.5), 0)
      scale(calc((0.94 + 0.06 * var(--in)) * (1 - 0.35 * var(--home))));
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.jstage.is-live) .iv.is-live-beat .win__typing span {
      animation: iv-typing var(--beat) ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.16s);
    }
  }
  @keyframes iv-typing {
    0%, 60%, 100% { opacity: 0.25; transform: translateY(0); }
    30%           { opacity: 1;    transform: translateY(-2px); }
  }

  @media (max-width: 1023px) {
    .iv__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); }
    .iv__inner { gap: var(--space-6); }
    .win__orb { width: 18px; height: 18px; }
    .iv__wires { display: none; }
  }
</style>

<script>
  /* The typing dots are the only time-driven thing in the journey. Run them
     only while this beat is on screen: fifteen looping animations behind a
     section nobody is looking at is a battery bill for nothing. */
  const iv = document.querySelector<HTMLElement>('.iv');
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (iv && stage && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const sync = () => {
      const t = Number(getComputedStyle(stage).getPropertyValue('--t')) || 0;
      iv.classList.toggle('is-live-beat', t > 3.9 && t < 5.05);
    };
    addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync, { passive: true });
    sync();
  }
</script>
