---
/**
 * SceneInterviews — beat 4. The campaign is out, so the conversations run.
 *
 * The orange thread that has led down the whole journey splits here: it fans
 * out above the grid, runs down one strand per column, and merges again below
 * into the insight frame.
 *
 * The cards do not appear on their own schedule. Each strand draws downward
 * and a card lands where it arrives: row 0 first, then row 1, then row 2. That
 * is the whole point of the beat, so nothing here may move the cards off their
 * strands. An earlier version scaled the grid up from the centre, which looked
 * like a bloom and left the lines running through empty space beside it.
 *
 * The strands are plain elements positioned with the grid's own column
 * arithmetic, so they sit dead centre under each column at any width. The fans
 * are SVG curves. The trick that makes them stay ROUND rather than shearing
 * into chevrons is the viewBox: it is shaped to the fan band's real pixel
 * aspect (about 16:1), so preserveAspectRatio="none" ends up scaling X and Y
 * by nearly the same factor and the curves keep their shape. A node sits at
 * each junction, which also absorbs the hairline disagreement between the
 * fan's column centre and the strand's gap-aware one.
 *
 * The orb in every card is Silas' ACTUAL orb, not a stand-in: one real WebGL
 * instance renders offscreen and its frame is blitted into fifteen small 2d
 * canvases. Fifteen GL contexts would hit the browser's limit; one context and
 * fifteen drawImage calls do not. That also settles the colour question for
 * good, since the pixels come from the shader rather than from a guess.
 *
 * Each window is SceneInterview's room in miniature and keeps its anatomy:
 * the live disc and the clock along the top, the orb on the left, the
 * transcript on the right with a mark per turn, the mic at the foot. Only the
 * words are gone, because at this size they would be noise. The count is
 * deliberately not in the copy, only in how many windows there happen to be.
 *
 * Everything is a function of absolute journey time, so scrolling back deals
 * the windows out again. The typing dots are the one exception: a conversation
 * that freezes when you stop scrolling reads as dead, so they run on their own
 * keyframes and stop when the beat is off screen.
 */
import '../../styles/journey.css';

export interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

const rand = (s: number) => () => {
  s = (s + 0x6d2b79f5) | 0;
  let t = Math.imul(s ^ (s >>> 15), 1 | s);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const next = rand(4815162342);

const COLS = 5, ROWS = 3;
const windows = Array.from({ length: COLS * ROWS }, (_, i) => {
  const col = i % COLS, row = Math.floor(i / COLS);
  return {
    no: String(i + 1).padStart(2, '0'),
    col, row,
    // three hinted turns: agent, reply, agent. Widths only; at this size the
    // words would be noise.
    lines: Array.from({ length: 3 }, (_, k) => ({ me: k === 1, w: Math.round((k === 1 ? 54 : 72) + next() * 24) })),
    clock: `${String(4 + Math.floor(next() * 17)).padStart(2, '0')}:${String(Math.floor(next() * 60)).padStart(2, '0')}`,
    // The strand reaches row 0 first, so that is the order cards land in.
    g: row,
    beat: (1.05 + next() * 0.5).toFixed(2),
    // Distance back to the centre of the grid, as a share of the card's own
    // box (a column step is one card plus one gap, hence slightly over 100).
  };
});

// One strand per column. The exact centre accounts for the grid gap, so a
// strand sits under the middle of its column at any width.
const strands = Array.from({ length: COLS }, (_, c) => c);

const t = isDE
  ? { head: 'Jede Person wird einzeln befragt.', sub: 'Anonym, im Gespräch mit dem Agenten, wann es ihr passt.', label: 'Interview' }
  : { head: 'Everyone is interviewed separately.', sub: 'Anonymously, in conversation with the agent, whenever it suits them.', label: 'Interview' };
---

<div class="iv">
  <div class="iv__inner">
    <header class="iv__head">
      <h2 class="iv__title">{t.head}</h2>
      <p class="iv__sub">{t.sub}</p>
    </header>

    <div class="iv__stage">
      <!-- The thread, split into one strand per column and merged again. -->
      <div class="iv__wires" aria-hidden="true">
        <svg class="iv__fan iv__fan--in" viewBox="0 0 1000 63" preserveAspectRatio="none">
          {strands.map((c) => (
            <path d={`M500 0 C 500 30, ${(c + 0.5) * 200} 33, ${(c + 0.5) * 200} 63`}
                  fill="none" stroke="var(--color-accent)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
          ))}
        </svg>

        {strands.map((c) => <span class="iv__node iv__node--in" style={`--c:${c}`}></span>)}
        {strands.map((c) => <span class="iv__strand" style={`--c:${c}`}></span>)}
      </div>

      <!-- The merge is its own layer because it must not draw with the rest:
           nothing runs back together until every conversation has been had. -->
      <div class="iv__merge" aria-hidden="true">
        {strands.map((c) => <span class="iv__node iv__node--out" style={`--c:${c}`}></span>)}
        <svg class="iv__fan iv__fan--out" viewBox="0 0 1000 63" preserveAspectRatio="none">
          {strands.map((c) => (
            <path d={`M${(c + 0.5) * 200} 0 C ${(c + 0.5) * 200} 30, 500 33, 500 63`}
                  fill="none" stroke="var(--color-accent)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
          ))}
        </svg>
      </div>

      <div class="iv__grid">
        {windows.map((w) => (
          <div class="win" style={`--r:${w.row};--beat:${w.beat}s`}>
            <div class="win__top">
              <span class="win__no">{t.label} {w.no}</span>
              <span class="win__clock"><span class="disc disc--live"></span>{w.clock}</span>
            </div>

            <div class="win__body">
              <canvas class="win__orb" width="96" height="96" data-orb-cell></canvas>
              <div class="win__transcript" aria-hidden="true">
                {w.lines.map((l, k) => (
                  <span class={`turn${l.me ? ' turn--u' : ''}`} style={`--k:${k}`}>
                    <span class="turn__mark"></span>
                    <span class="turn__bubble" style={`width:${l.w}%`}></span>
                  </span>
                ))}
              </div>
            </div>

            <div class="win__foot" aria-hidden="true">
              <span class="win__mic"></span>
              <span class="win__typing"><span style="--i:0"></span><span style="--i:1"></span><span style="--i:2"></span></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* --lead lives here, not on the stage, because the gap below the header has
     to be derived from it: the fan band reaches --lead above the grid, and a
     smaller gap than that runs the curves straight through the subheading. */
  .iv { grid-area: 1 / 1; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; --lead: 64px; }
  .iv__inner {
    display: flex; flex-direction: column;
    gap: calc(var(--lead) + var(--space-4));
    width: 100%; max-width: 960px; padding: 0 var(--space-6);
  }

  /* Type is never crossed by the drawing, whatever the spacing works out to. */
  .iv__head { text-align: center; position: relative; z-index: 2; }
  .iv__title {
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    font-weight: 400; letter-spacing: -0.035em; line-height: 1.15;
    color: var(--color-text-primary);
  }
  .iv__sub { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--color-text-secondary); }

  .iv__stage {
    position: relative;
    --gap: var(--space-3);
    /* One column's width, and the centre of the first column. Everything that
       has to line up with the grid is derived from these two. */
    --colw: calc((100% - 4 * var(--gap)) / 5);
    --s0: calc(var(--colw) / 2);
  }

  /* The wire layer reaches past the grid at both ends: that overhang is where
     the single thread becomes five and five become one again. */
  /* Everything down to the bottom of the grid: the fan in and the strands. */
  .iv__wires {
    position: absolute;
    left: 0; right: 0;
    top: calc(-1 * var(--lead)); bottom: 0;
    pointer-events: none;
    opacity: 0.62;
  }
  /* And below it, on its own clock, the merge. */
  .iv__merge {
    position: absolute;
    left: 0; right: 0;
    bottom: calc(-1 * var(--lead)); height: var(--lead);
    pointer-events: none;
    opacity: 0.62;
  }

  /* The fan's viewBox puts its outer endpoints at x 100 and 900 of 1000, i.e.
     across the middle 80% of the SVG. Sizing the SVG so that those two points
     land exactly on the outer strands is what makes the curves MEET the lines
     instead of ending near them: width = (span between outer strands) / 0.8,
     shifted left by the remaining 10%. */
  .iv__fan {
    position: absolute;
    height: var(--lead);
    overflow: visible;
    width: calc((100% - var(--colw)) * 1.25);
    left: calc(var(--s0) - (100% - var(--colw)) * 0.125);
  }
  .iv__fan--in { top: 0; }
  .iv__fan--out { top: 0; }

  /* Column centre c, gaps included:
     ((100% - (COLS-1) * gap) / COLS) * (c + .5) + c * gap */
  .iv__strand {
    position: absolute;
    top: var(--lead); bottom: 0;
    width: 1.5px;
    background: var(--color-accent);
    left: calc((100% - 4 * var(--gap)) / 5 * (var(--c) + 0.5) + var(--c) * var(--gap) - 0.75px);
  }

  /* The junction node: it marks where the thread becomes five, and covers the
     hairline disagreement between the fan's and the strand's column centre. */
  .iv__node {
    position: absolute;
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--color-accent);
    left: calc((100% - 4 * var(--gap)) / 5 * (var(--c) + 0.5) + var(--c) * var(--gap) - 2.5px);
  }
  .iv__node--in { top: calc(var(--lead) - 2.5px); }
  .iv__node--out { top: -2.5px; }

  .iv__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .win {
    position: relative;
    display: flex; flex-direction: column; gap: 6px;
    padding: 8px 9px;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-xs);
    min-width: 0;
  }
  /* Top line of the room: who this is, and the clock with its live disc. */
  .win__top { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .win__no {
    font-size: 9.5px; font-weight: 600; letter-spacing: 0.03em;
    color: var(--color-text-tertiary);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .win__clock {
    display: inline-flex; align-items: center; gap: 4px; margin-left: auto; flex-shrink: 0;
    font-size: 8.5px; color: var(--color-text-quaternary); font-variant-numeric: tabular-nums;
  }
  .disc { width: 4px; height: 4px; border-radius: 50%; background: var(--color-text-quaternary); flex-shrink: 0; }
  .disc--live { background: var(--color-accent); }

  /* Body: orb left, transcript right, exactly as the full room is laid out. */
  .win__body { display: flex; align-items: center; gap: 8px; min-width: 0; }
  /* The real orb, blitted in. No background and no ring: the shader's own
     premultiplied output already carries the soft edge. */
  .win__orb { width: 26px; height: 26px; flex-shrink: 0; display: block; }

  .win__transcript { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
  /* One mark plus one bubble per turn, the same anatomy as the real transcript. */
  .turn { display: flex; align-items: center; gap: 4px; min-width: 0; }
  .turn--u { flex-direction: row-reverse; }
  .turn__mark { width: 6px; height: 6px; border-radius: 2px; flex-shrink: 0; background: var(--color-border-strong); }
  .turn--u .turn__mark { background: var(--brand-periwinkle); }
  .turn__bubble { height: 5px; border-radius: 2px; background: var(--color-surface-elevated); }
  .turn--u .turn__bubble { background: var(--brand-periwinkle-weak); }

  .win__foot { display: flex; align-items: center; gap: 6px; }
  .win__mic { width: 12px; height: 12px; border-radius: 50%; background: var(--color-surface-elevated); flex-shrink: 0; }
  .win__typing { display: inline-flex; gap: 3px; }
  .win__typing span { width: 3px; height: 3px; border-radius: 50%; background: var(--brand-periwinkle); }

  /* ── Live choreography ─────────────────────────────────────────────────── */
  /* Absolute journey time.  4.0 windows deal in · 4.74 they converge ·
     5.0 handed over to the insight frame. */
  /* The fan has to leave the UNDERSIDE of the campaign card, and that card
     sits low in the frame while this layer's apex sits high in it. So the
     whole layer starts dropped so that its apex meets the card's bottom edge,
     HOLDS there until the card has left, and only then eases up to its own
     position. The hold has to outlast the card completely: while the card is
     still at half opacity a half-released drop puts the apex back inside it,
     which is what ran the curves across it. The card is at zero by 4.12, so
     the release starts there. --drop-px is the distance, measured once in the
     script below, because it depends on the frame's height and the card's. */
  :global(.jstage.is-live) .iv {
    pointer-events: none;
    --drop: clamp(0, calc((4.24 - var(--t)) / 0.12), 1);
    /* And out the top when it is done, as one piece, at full opacity. 150%
       and not 118%: the layer is as tall as the frame, so a shove of one
       frame-height still leaves its bottom edge inside the viewport. It has
       to be COMPLETELY gone before the insight frame starts growing, or that
       frame's white ground simply covers what is still standing there. */
    --exit: clamp(0, calc((var(--t) - 4.92) / 0.24), 1);
    transform: translate3d(0,
      calc(var(--drop-px, 0px) * var(--drop) - 150% * var(--exit)), 0);
    opacity: min(
      clamp(0, calc((var(--t) - 3.88) / 0.12), 1),
      clamp(0, calc((5.20 - var(--t)) / 0.04), 1)
    );
  }

  :global(.jstage.is-live) .iv__head {
    opacity: min(
      clamp(0, calc((var(--t) - 4.30) / 0.18), 1),
      clamp(0, calc((4.86 - var(--t)) / 0.14), 1)
    );
  }

  /* The split draws itself just before the windows land on it, and stays until
     the merge has pulled everything into the insight frame. */
  /* Drawn from the moment the send is pressed, and it keeps travelling for the
     whole landing phase rather than finishing first: the front comes down the
     column and each row's card appears just behind it. A line that arrives
     alone and waits is not a flow, it is a diagram. */
  :global(.jstage.is-live) .iv__wires {
    --p: clamp(0, calc((var(--t) - 3.88) / 0.68), 1);
    clip-path: inset(0 0 calc(100% - 100% * var(--p)) 0);
  }

  /* Nothing runs back together until the last conversation is complete, and
     the lines close the loop BEFORE the cards move: first the thread is whole
     again, then what it collected travels down it. */
  :global(.jstage.is-live) .iv__merge {
    --p: clamp(0, calc((var(--t) - 4.76) / 0.14), 1);
    clip-path: inset(0 0 calc(100% - 100% * var(--p)) 0);
  }

  /* A card lands just after the strand front has passed its row. On the way in
     it must not move sideways: it has to stay on its line. On the way out it
     follows the merge instead, gathering down and inward to the point the
     strands run into, bottom row leading. */
  /* The cards only land. They neither fade nor gather: the whole section
     leaves as one piece, the way a page scrolls, and the insight frame is
     built below it. Moving the cards individually on the way out made the
     exit a second animation competing with that. */
  :global(.jstage.is-live) .win {
    --in: clamp(0, calc((var(--t) - 4.26 - var(--r) * 0.12) / 0.13), 1);
    opacity: var(--in);
    transform: translate3d(0, calc(-10px * (1 - var(--in))), 0)
               scale(calc(0.96 + 0.04 * var(--in)));
  }

  /* Then each conversation builds a turn at a time while you keep scrolling. */
  :global(.jstage.is-live) .turn {
    opacity: clamp(0, calc((var(--t) - 4.33 - var(--r) * 0.12 - var(--k) * 0.04) / 0.09), 1);
  }
  :global(.jstage.is-live) .win__typing {
    opacity: clamp(0, calc((var(--t) - 4.70) / 0.10), 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.jstage.is-live) .iv.is-live-beat .win__typing span {
      animation: iv-typing var(--beat) ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.16s);
    }
  }
  @keyframes iv-typing {
    0%, 60%, 100% { opacity: 0.25; transform: translateY(0); }
    30%           { opacity: 1;    transform: translateY(-2px); }
  }

  @media (max-width: 1023px) {
    .iv__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); }
    .iv__inner { gap: var(--space-6); }
    .iv { --lead: 0px; }
    .win__orb { width: 20px; height: 20px; }
    .iv__wires { display: none; }
  }
</style>

<script>
  /* Two time-driven things live here, and both stop when the beat is off
     screen: the typing dots, and the shared orb whose frame is copied into
     every card. Fifteen idling WebGL contexts, or fifteen loops running behind
     a section nobody is looking at, is a battery bill for nothing. */
  import { createImplicitOrb } from '../../scripts/orb.js';

  const iv = document.querySelector<HTMLElement>('.iv');
  const stage = document.querySelector<HTMLElement>('[data-stage]');

  /* How far this layer has to start dropped for the fan's apex to sit on the
     campaign card's bottom edge. Layout positions, not rects: the rects carry
     the scroll-driven transforms, offsets do not. Recomputed on resize only. */
  const topWithin = (el: HTMLElement | null, root: HTMLElement) => {
    let y = 0;
    let node: HTMLElement | null = el;
    while (node && node !== root) { y += node.offsetTop; node = node.offsetParent as HTMLElement | null; }
    return y;
  };
  let dropOk = false;
  const measureDrop = () => {
    const frame = document.querySelector<HTMLElement>('.jframe');
    const card = document.querySelector<HTMLElement>('.card');
    const ivStage = document.querySelector<HTMLElement>('.iv__stage');
    if (!frame || !card || !ivStage || !iv) return;
    const lead = parseFloat(getComputedStyle(ivStage).getPropertyValue('--lead')) || 0;
    /* Where the strands run back together, as a fraction of the frame. The
       thread is capped there until the insight frame grows out of it, so the
       line never runs on down an empty frame past the convergence. */
    const apexY = topWithin(ivStage, frame) - lead;
    const mergeY = topWithin(ivStage, frame) + ivStage.offsetHeight + lead;
    const fh = frame.offsetHeight;
    if (fh > 0) {
      /* Where the single line ends and the fan takes over... */
      frame.style.setProperty('--thread-apex', (apexY / fh).toFixed(3));
      /* ...and where the strands come back together, which is where the
         insight frame is born. */
      frame.style.setProperty('--thread-stop', (mergeY / fh).toFixed(3));
    }
    const need = Math.round(topWithin(card, frame) + card.offsetHeight - apexY);
    /* On the very first run the frame can still be laying out and every offset
       reads 0. Rather than bake that in, leave it unset and try again on the
       next scroll: the beat is five screens away, there is plenty of time. */
    if (need <= 0) { dropOk = false; return; }
    dropOk = true;
    frame.style.setProperty('--drop-px', need + 'px');
    /* The same shove as a fraction, so the thread can follow the apex while
       the layer is still dropped against the campaign card. */
    frame.style.setProperty('--drop-frac', (need / fh).toFixed(3));
  };
  const cells = [...document.querySelectorAll<HTMLCanvasElement>('[data-orb-cell]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (iv && stage) {
    let live = false;
    let orb: ReturnType<typeof createImplicitOrb> | null = null;
    let source: HTMLCanvasElement | null = null;
    let raf = 0;

    const ctxs = cells.map((c) => c.getContext('2d'));

    if (!reduced && cells.length) {
      source = document.createElement('canvas');
      /* The orb sizes itself from canvas.clientWidth. A detached canvas has a
         client size of 0, so resize() bails and nothing ever renders, which is
         exactly why the cards came out blank. It has to be in the document
         with a real CSS box: parked off-screen, not display:none. */
      source.style.cssText =
        'position:fixed;left:-200px;top:0;width:96px;height:96px;pointer-events:none;opacity:0';
      source.setAttribute('aria-hidden', 'true');
      document.body.appendChild(source);
      orb = createImplicitOrb(source, { breathe: true, preserveDrawingBuffer: true });
      if (!orb.supported) { orb = null; source.remove(); source = null; }
    }

    const blit = () => {
      if (!source || !source.width || !source.height) return;
      for (let i = 0; i < ctxs.length; i++) {
        const ctx = ctxs[i];
        if (!ctx) continue;
        ctx.clearRect(0, 0, 96, 96);
        ctx.drawImage(source, 0, 0, 96, 96);
      }
    };

    const loop = () => {
      if (!live) return;
      blit();
      raf = requestAnimationFrame(loop);
    };

    const sync = () => {
      if (!dropOk) measureDrop();
      const t = Number(getComputedStyle(stage).getPropertyValue('--t')) || 0;
      const next = t > 3.9 && t < 5.22;
      iv.classList.toggle('is-live-beat', next);
      if (next === live) return;
      live = next;
      if (live) { orb?.start(); raf = requestAnimationFrame(loop); }
      else { orb?.stop(); cancelAnimationFrame(raf); blit(); }
    };

    addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', () => { dropOk = false; sync(); }, { passive: true });
    document.addEventListener('visibilitychange', () => { if (!document.hidden) sync(); });
    measureDrop();
    sync();
  }
</script>
