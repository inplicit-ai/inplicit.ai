---
/**
 * Interview room — the participant-facing voice room.
 * Standalone by construction: no sidebar, white surface, its own bordered top
 * bar (app/interview/layout.tsx renders children bare; InterviewRoom.tsx:570).
 * The orb is the REAL AgentOrb shader, ported verbatim to vanilla WebGL.
 */
import logoIconRaw from '../../assets/logo_icon.svg?raw';

export interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const de = lang === 'de';

const topics = de ? [
  { t: 'Doppelte Prozessverantwortung',        s: 'done' },
  { t: 'Risiko bei Kundenübergabe',            s: 'done' },
  { t: 'Schlüsselpersonen im Mid-Office',      s: 'live', must: '1/2' },
  { t: 'Bindungsrisiko im übernommenen Team',  s: 'open' },
] : [
  { t: 'Duplicate process ownership',          s: 'done' },
  { t: 'Client handover risk',                 s: 'done' },
  { t: 'Key-person dependency, mid-office',    s: 'live', must: '1/2' },
  { t: 'Retention risk, acquired team',        s: 'open' },
];

const turns = de ? [
  { who: 'a', text: 'Erzähl mir, was passiert, wenn ein Kundenkonto jetzt zwischen Halden- und Meridian-Teams liegt.' },
  { who: 'u', text: 'Offiziell führt die Meridian-Verantwortliche, aber die halbe Kundenhistorie fehlt noch in Haldens CRM.' },
  { who: 'a', text: 'Wie oft ist dadurch schon eine Zusage an einen Kunden durch die Lücke gefall…' },
] : [
  { who: 'a', text: 'Walk me through what happens when a client account now sits between Halden and Meridian teams.' },
  { who: 'u', text: 'Officially the Meridian owner leads, but half our client history isn’t yet in Halden’s CRM.' },
  { who: 'a', text: 'How often has that gap caused a commitment to a client to slip thro…' },
];
---

<div class="jscene" style="--t0: 1" aria-hidden="true">
  <div class="room">

    <header class="room__top">
      <span class="jpart top__clock" data-axis="down" data-weight="chrome" style="--g:0">
        <span class="disc disc--live"></span>
        <span class="clock">11:32 <span class="clock__sep">/</span> 25:00</span>
      </span>
      <span class="jpart top__notice" data-axis="down" data-weight="chrome" style="--g:0">
        {de ? 'Hinweis: Dieses Gespräch wird von einer KI geführt, nicht von einem Menschen.'
            : 'Note: this conversation is conducted by an AI, not a human.'}
      </span>
      <span class="jpart top__actions" data-axis="down" data-weight="chrome" style="--g:0">
        <span class="btn btn--outline">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
          {de ? 'Pause' : 'Pause'}
        </span>
        <span class="btn btn--ghost">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="5" y="5" width="14" height="14" rx="2"/></svg>
          {de ? 'Beenden' : 'End'}
        </span>
      </span>
    </header>

    <div class="room__body">
      <aside class="rail">
        <p class="jpart rail__label" data-axis="left" data-weight="chrome" style="--g:1">{de ? 'Themen' : 'Topics'}</p>
        <div class="rail__list">
          {topics.map((tp, i) => (
            <div class={`jpart topic topic--${tp.s}`} data-axis="left" style={`--g:${i < 2 ? 2 : 3}`}>
              {tp.s === 'done' ? (
                <svg class="topic__check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              ) : (<span class="topic__dot"></span>)}
              <span class="topic__title">{tp.t}</span>
              {tp.must ? <span class="topic__must">{tp.must}</span> : null}
            </div>
          ))}
        </div>
      </aside>

      <div class="centre">
        <div class="jpart orb" style="--g:0">
          <canvas class="orb__canvas" data-orb></canvas>
          <div class="orb__fallback" data-orb-fallback hidden>
            <span class="orb__core"></span><span class="orb__ring"></span>
          </div>
        </div>
        <div class="jpart hud" data-axis="up" data-weight="chrome" style="--g:1">
          <span class="hud__status"><span class="disc disc--live"></span>{de ? 'Hört zu' : 'Listening'}</span>
          <span class="hud__phase">{de ? 'Phase 1 · Offen' : 'Phase 1 · Open'}</span>
          <span class="hud__div"></span>
          <span class="hud__conn"><span class="disc"></span>{de ? 'Verbunden' : 'Connected'}</span>
        </div>
      </div>

      <aside class="rail rail--right">
        <p class="jpart rail__label" data-axis="right" data-weight="chrome" style="--g:1">{de ? 'Transkript' : 'Transcript'}</p>
        <div class="rail__list">
          {turns.map((tn, i) => (
            <div class={`jpart turn turn--${tn.who}${i === turns.length - 1 ? ' turn--interim' : ''}`} data-axis="right" style={`--g:${i < 2 ? 2 : 3}`}>
              {tn.who === 'a'
                ? <span class="turn__mark" set:html={logoIconRaw} />
                : <span class="turn__mark turn__mark--user"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>}
              <span class="turn__bubble">{tn.text}</span>
            </div>
          ))}
        </div>
      </aside>
    </div>

    <!-- Controls float free on the surface — no enclosing bar. -->
    <div class="room__foot">
      <span class="jpart mic" data-axis="up" data-weight="chrome" style="--g:4">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
      </span>
      <span class="jpart btn btn--outline" data-axis="up" data-weight="chrome" style="--g:4">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        {de ? 'Zu Chat wechseln' : 'Switch to chat'}
      </span>
    </div>

  </div>
</div>

<script>
  import { createImplicitOrb } from '../../scripts/orb.js';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-orb]');
  const fallback = document.querySelector<HTMLElement>('[data-orb-fallback]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas) {
    const orb = reduced ? null : createImplicitOrb(canvas);
    if (!orb || !orb.supported) {
      canvas.hidden = true;
      if (fallback) fallback.hidden = false;
    } else {
      // Start eagerly so the shader is warm before the step is reached, and
      // pause only when the whole journey leaves the viewport.
      orb.start();
      const stage = canvas.closest('[data-stage]') ?? canvas;
      new IntersectionObserver(
        ([e]) => (e.isIntersecting ? orb.start() : orb.stop()),
        { rootMargin: '200px' },
      ).observe(stage);
    }
  }
</script>

<style>
  .room {
    width: 100%; height: 100%; overflow: hidden;
    display: flex; flex-direction: column;
    background: var(--color-surface);
  }

  .room__top {
    flex: 0 0 auto; height: 64px; padding: 0 20px;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    border-bottom: 1px solid var(--color-border);
  }
  .disc { width: 6px; height: 6px; border-radius: var(--radius-full); background: var(--color-text-tertiary); flex: none; display: inline-block; }
  .disc--live { background: var(--color-success); }
  @media (prefers-reduced-motion: no-preference) {
    .disc--live { animation: disc-breathe 2s var(--ease-smooth) infinite; }
  }
  @keyframes disc-breathe { 0%,100% { opacity: 1; } 50% { opacity: 0.45; } }

  .top__clock { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--color-text-secondary); font-variant-numeric: tabular-nums; }
  .clock__sep { color: var(--color-text-quaternary); }
  .top__notice { font-size: 12px; color: var(--color-text-tertiary); text-align: center; white-space: nowrap; }
  .top__actions { display: inline-flex; align-items: center; gap: 8px; justify-self: end; }

  .btn { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 10px; border-radius: var(--radius-ui); font-size: 12px; font-weight: 500; color: var(--color-text-secondary); }
  .btn--outline { border: 1px solid var(--color-border); background: var(--color-surface); }

  .room__body {
    flex: 1 1 auto; min-height: 0;
    display: grid; grid-template-columns: 240px minmax(0,1fr) 340px;
    gap: 32px; padding: 20px 32px;
  }

  .rail { display: flex; flex-direction: column; gap: 10px; min-height: 0; overflow: hidden; }
  .rail__label { font-size: 12px; font-weight: 400; color: var(--color-text-tertiary); }
  .rail__list { display: flex; flex-direction: column; gap: 8px; min-height: 0; overflow: hidden; }

  .topic { display: flex; align-items: center; gap: 10px; padding: 9px 14px; border-radius: var(--radius-ui); border: 1px solid var(--color-border-subtle); background: var(--color-surface); }
  .topic__title { font-size: 12px; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .topic__dot { width: 6px; height: 6px; border-radius: var(--radius-full); background: var(--color-border-strong); flex: none; }
  .topic__must { font-size: 12px; color: var(--color-text-tertiary); font-variant-numeric: tabular-nums; }
  .topic--done .topic__check { color: var(--color-success); flex: none; }
  .topic--done .topic__title { color: var(--color-text-tertiary); }
  .topic--open .topic__title { color: var(--color-text-secondary); }
  .topic--live { border-color: var(--color-gap-muted); background: var(--color-accent-soft); box-shadow: inset 0 0 0 1px var(--color-gap-muted); }
  .topic--live .topic__dot { background: var(--color-accent); }
  .topic--live .topic__title { color: var(--color-text-primary); font-weight: 500; }

  .centre { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px; min-height: 0; }
  /* The orb is the canvas alone — no ring, border or glow around it. */
  .orb { position: relative; width: 160px; height: 160px; flex: none; }
  .orb__canvas { display: block; width: 100%; height: 100%; }
  .orb__fallback { position: absolute; inset: 0; display: grid; place-items: center; }
  .orb__fallback[hidden] { display: none; }  /* `hidden` alone loses to display:grid */
  .orb__core { width: 38%; height: 38%; border-radius: var(--radius-full); background: var(--color-accent); opacity: 0.68; }
  .orb__ring { position: absolute; inset: 0; border-radius: var(--radius-full); border: 1px solid var(--color-accent-muted); transform: scale(0.776); opacity: 0.37; }

  .hud { display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; font-size: 13px; }
  .hud__status { display: inline-flex; align-items: center; gap: 6px; font-weight: 500; color: var(--color-text-secondary); }
  .hud__phase { border-radius: var(--radius-full); border: 1px solid var(--color-border-subtle); background: var(--color-surface-elevated); padding: 2px 10px; font-size: 12px; font-weight: 500; color: var(--color-text-secondary); }
  .hud__div { width: 1px; height: 14px; background: var(--color-border); }
  .hud__conn { display: inline-flex; align-items: center; gap: 6px; color: var(--color-text-secondary); }

  .turn { display: flex; gap: 10px; align-items: flex-start; }
  .turn--u { flex-direction: row-reverse; }
  .turn__mark { width: 26px; height: 26px; flex: none; display: grid; place-items: center; }
  .turn__mark :global(svg) { width: 100%; height: 100%; display: block; }
  .turn__mark--user { border-radius: var(--radius-full); border: 1px solid var(--color-border); background: var(--color-surface-elevated); color: var(--color-text-tertiary); }
  .turn__bubble { max-width: 85%; border-radius: var(--radius-xl); padding: 8px 14px; font-size: 14px; line-height: 1.55; }
  .turn--a .turn__bubble { background: var(--color-surface-elevated); color: var(--color-text-primary); border-bottom-left-radius: var(--radius-sm); }
  .turn--u .turn__bubble { background: var(--dash-cta); color: var(--dash-cta-text); border-bottom-right-radius: var(--radius-sm); }
  .turn--interim .turn__bubble { opacity: 0.7; }

  /* Floating controls: no bar, no divider — they sit on the surface. */
  .room__foot { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 0 20px 20px; }
  .mic { width: 48px; height: 48px; border-radius: var(--radius-full); border: 1px solid var(--color-border); background: var(--color-surface); display: grid; place-items: center; color: var(--color-text-secondary); }

  @media (max-width: 1023px) {
    .room__body { grid-template-columns: 1fr; gap: 16px; padding: 16px; }
    .rail, .top__notice { display: none; }
    .centre { gap: 16px; }
    .orb { width: 120px; height: 120px; }
    .room__top { grid-template-columns: 1fr auto; }
  }
</style>
