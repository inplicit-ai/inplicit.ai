---
/**
 * TheProblem — "Die Herausforderung" as a pinned, scroll-driven stage on the
 * same primitive as the product journey (ScrollStage writes --t in scene units;
 * everything below is a pure CSS function of it).
 *
 * Two beats:
 *   0 → 1  the knowledge field fills in. Every bubble is one piece of knowledge
 *          that only lives in somebody's head. The orange ones are hers.
 *   1 → 2  she leaves. Her bubbles drift after her and fade out, and the hole
 *          they leave stays on screen as a dashed ring.
 *
 * The field is deliberately NOT inside a .jscene: it persists across both beats
 * on absolute journey time (--lt: var(--t)), the same trick AppShell uses for
 * the dashboard chrome. Only the left-hand copy swaps, so the loss reads as one
 * continuous picture instead of two slides.
 *
 * Base markup (no .is-live) is the full, assembled field with nobody gone. That
 * is the no-JS and reduced-motion state, per the journey.css contract.
 */
import ScrollStage from './scroll/ScrollStage.astro';

export interface Props { lang?: 'en' | 'de' }
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

// Deterministic scatter: same seed, same field on every build.
const rand = (s: number) => () => {
  s = (s + 0x6d2b79f5) | 0;
  let t = Math.imul(s ^ (s >>> 15), 1 | s);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const CENTRE = 50;
const R_FIELD = 48;   // field radius, in % of the square stage
const R_CLEAR = 9;    // no bubble this close to her: she needs her own space
const R_LOST = 26;    // roughly where her knowledge ends

const next = rand(20260915);
const field: { x: number; y: number; w: number; g: number; lost: boolean; ddx: number; ddy: number }[] = [];
for (let tries = 0; tries < 9000 && field.length < 124; tries++) {
  const a = next() * Math.PI * 2;
  // sqrt keeps the disc evenly covered instead of crowding the middle
  const d = Math.sqrt(next()) * R_FIELD;
  if (d < R_CLEAR) continue;
  const x = CENTRE + Math.cos(a) * d;
  const y = CENTRE + Math.sin(a) * d;
  const r = 1.15 + next() * next() * 2.9;
  if (field.some((b) => Math.hypot(b.x - x, b.y - y) < b.w / 2 + r + 1.25)) continue;
  // A ragged boundary, not a drawn circle: the hole has to look like something
  // was pulled out of the field, not like a shape was placed on top of it. A
  // few small outliers further out go too, because her work touched them.
  const lost = d < R_LOST * (0.8 + 0.4 * next()) || (r < 1.9 && next() < 0.07);
  field.push({
    x, y, w: r * 2,
    g: Math.min(4, Math.floor((d / R_FIELD) * 5)),
    lost,
    // her knowledge drifts after her: inward, then up and out
    ddx: (CENTRE - x) * 0.42,
    ddy: (CENTRE - y) * 0.42 - 7,
  });
}

const t = isDE
  ? {
      eyebrow: 'Die Herausforderung',
      head0: 'Das meiste Wissen Ihrer Organisation steht nirgends geschrieben.',
      sub0: 'Es steckt in Erfahrung, in Gewohnheiten, in Gesprächen auf dem Flur.',
      chip: 'Wissen der Organisation',
      person: 'Seit 14 Jahren dabei',
      head1: 'Geht eine Person, geht ihr Wissen mit.',
      statValue: '11 Mrd. €',
      statBody: 'Umsatz entgehen allein den deutschen IT-Unternehmen jedes Jahr, weil Wissen und Kompetenz mit den Menschen gehen.',
      statSource: 'Fraunhofer IAO und Bitkom, Befragung von 203 IT- und Telekommunikationsunternehmen',
    }
  : {
      eyebrow: 'The challenge',
      head0: 'Most of what your organisation knows is written down nowhere.',
      sub0: 'It lives in experience, in habits, in conversations by the coffee machine.',
      chip: 'What the organisation knows',
      person: '14 years in the company',
      head1: 'When a person leaves, their knowledge leaves with them.',
      statValue: '11 Mrd. €',
      statBody: 'in revenue is lost by German IT companies alone every year, because knowledge and competence walk out with the people.',
      statSource: 'Fraunhofer IAO and Bitkom, survey of 203 IT and telecoms companies',
    };
---

<ScrollStage scenes={2} travel={230} id="the-problem" class="pstage">
  <div class="pframe">

    <div class="pcopy">
      <p class="section-eyebrow pcopy__eyebrow">{t.eyebrow}</p>

      <div class="pcopy__scenes">
        <div class="jscene" style="--t0: 0">
          <h2 class="pcopy__head jpart" data-axis="up" style="--g: 0">{t.head0}</h2>
          <p class="pcopy__sub jpart" data-axis="up" style="--g: 1">{t.sub0}</p>
        </div>

        <div class="jscene" style="--t0: 1" data-last>
          <h2 class="pcopy__head jpart" data-axis="up" style="--g: 0">{t.head1}</h2>
          <p class="pcopy__stat jpart" data-axis="up" style="--g: 1">
            <span class="pcopy__stat-value">{t.statValue}</span>{t.statBody}
          </p>
          <p class="pcopy__source jpart" data-axis="up" style="--g: 2">
            <a href="https://www.computerwoche.de/article/2875892/teurer-wissensverlust.html" target="_blank" rel="noopener noreferrer">{t.statSource}</a>
          </p>
        </div>
      </div>
    </div>

    <div class="kf" aria-hidden="true">
      <div class="kf__disc">
        <span class="kf__hole"></span>

        {field.map((b) => (
          <span
            class={`kf__b${b.lost ? ' kf__b--lost' : ''}`}
            style={`--x:${b.x.toFixed(2)}%;--y:${b.y.toFixed(2)}%;--w:${b.w.toFixed(2)}%;--g:${b.g}${b.lost ? `;--ddx:${b.ddx.toFixed(1)}%;--ddy:${b.ddy.toFixed(1)}%` : ''}`}
          ></span>
        ))}

        <span class="kf__person">
          <img src="/people/s3.png" alt="" width="96" height="96" loading="lazy" decoding="async" />
        </span>
        <span class="kf__person-label">{t.person}</span>
      </div>

      <p class="kf__chip">{t.chip}</p>
    </div>

  </div>
</ScrollStage>

<style>
  /* ── Frame ──────────────────────────────────────────────────────────── */
  .pframe {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--space-8);
    display: grid;
    grid-template-columns: 0.92fr 1fr;
    align-items: center;
    gap: var(--space-16);
  }

  /* ── Copy ───────────────────────────────────────────────────────────── */
  .pcopy { display: flex; flex-direction: column; gap: var(--space-6); }
  .pcopy__eyebrow { display: block; }

  /* Both copy beats share one cell and start on the same line, so the heading
     does not jump when the scenes swap. */
  .pcopy__scenes {
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  .pcopy__scenes .jscene { grid-area: 1 / 1; display: flex; flex-direction: column; }

  .pcopy__head {
    font-size: clamp(var(--text-xl), 3.2vw, 2.6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--color-text-primary);
    max-width: 18ch;
  }
  .pcopy__sub {
    margin-top: var(--space-5);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 44ch;
  }
  .pcopy__stat {
    margin-top: var(--space-6);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-primary);
    max-width: 44ch;
  }
  .pcopy__stat-value {
    display: block;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-3);
  }
  .pcopy__source { margin-top: var(--space-4); font-size: var(--text-xs); color: var(--color-text-tertiary); }
  .pcopy__source a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .pcopy__source a:hover { color: var(--color-text-secondary); }

  /* ── Knowledge field ────────────────────────────────────────────────── */
  .kf { display: flex; flex-direction: column; align-items: center; gap: var(--space-5); }

  .kf__disc {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1;
  }

  .kf__b {
    position: absolute;
    left: calc(var(--x) + var(--ddx, 0%) * var(--gone, 0));
    top: calc(var(--y) + var(--ddy, 0%) * var(--gone, 0));
    width: var(--w);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--color-border-strong);
  }
  /* Hers are orange from the first beat, so the thing that disappears is the
     thing the eye was already tracking. */
  .kf__b--lost { background: var(--color-accent); }

  .kf__hole {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px dashed var(--color-accent-muted);
    transform: translate(-50%, -50%);
    opacity: 0;
  }

  .kf__person {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 3px var(--color-bg), 0 0 0 4px var(--color-accent);
  }
  .kf__person img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Sits on top of the bubble cluster, so it needs its own ground to stay
     legible against whatever bubble happens to be behind it. */
  .kf__person-label {
    position: absolute;
    left: 50%;
    top: calc(50% + 10%);
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 3px 9px;
    border-radius: var(--radius-full, 999px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-xs);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .kf__chip {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-text-tertiary);
  }

  /* ── Live choreography (pure functions of --t) ───────────────────────── */
  /* The field runs on ABSOLUTE journey time: it has to survive the scene swap. */
  :global(.jstage.is-live) .kf { --lt: var(--t); }

  :global(.jstage.is-live) .kf__b {
    /* rings fill outward, so the middle (hers) is populated first */
    --d: calc(var(--g) * 0.09);
    --in: clamp(0, calc((var(--lt) - var(--d)) / 0.42), 1);
    opacity: calc(0.92 * var(--in));
    transform: translate(-50%, -50%) scale(calc(0.35 + 0.65 * var(--in)));
  }

  :global(.jstage.is-live) .kf__b--lost {
    --gone: clamp(0, calc((var(--lt) - 1.02 - var(--g) * 0.03) / 0.44), 1);
    opacity: calc(var(--in) * (1 - var(--gone)));
    transform: translate(-50%, -50%) scale(calc((0.35 + 0.65 * var(--in)) * (1 - 0.55 * var(--gone))));
  }

  :global(.jstage.is-live) .kf__person,
  :global(.jstage.is-live) .kf__person-label {
    --inp: clamp(0, calc((var(--lt) - 0.22) / 0.40), 1);
    --gonep: clamp(0, calc((var(--lt) - 1.00) / 0.40), 1);
    top: calc(50% - 7% * var(--gonep));
    opacity: calc(var(--inp) * (1 - var(--gonep)));
  }
  :global(.jstage.is-live) .kf__person {
    transform: translate(-50%, -50%) scale(calc(0.6 + 0.4 * var(--inp)));
  }
  :global(.jstage.is-live) .kf__person-label { top: calc(50% + 10% - 7% * var(--gonep)); }

  /* The hole only exists once her bubbles are actually gone. */
  :global(.jstage.is-live) .kf__hole {
    opacity: clamp(0, calc((var(--lt) - 1.30) / 0.40), 1);
  }

  :global(.jstage.is-live) .kf__chip {
    opacity: clamp(0, calc(var(--lt) / 0.30), 1);
  }

  /* ── Stacked below the 2-column breakpoint ──────────────────────────── */
  @media (max-width: 1023px) {
    .pframe {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
      padding: 0 var(--space-6);
    }
    .pcopy__head { max-width: none; }
    .pcopy__sub, .pcopy__stat { max-width: none; }
    /* The pin is one viewport tall and the copy sits above the field on this
       breakpoint, so the disc has to leave room for both. */
    .kf__disc { max-width: min(330px, 68vw); }
    .kf { gap: var(--space-4); }
  }
</style>
