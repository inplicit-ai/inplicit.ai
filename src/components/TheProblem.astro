---
// "Die Herausforderung" — the first section after the hero. It names the pain
// (undocumented knowledge leaving the company) before the product is shown, so
// the ProcessFlow animation that follows has something to answer.
export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

const t = isDE
  ? {
      eyebrow: 'Die Herausforderung',
      statValue: '26,5 Mio. $',
      statBody: 'verliert ein Unternehmen mit 10.000 Mitarbeitenden jedes Jahr an Produktivität, weil Wissen nicht geteilt wird. 5,3 Stunden pro Woche und Kopf gehen dafür drauf, auf Informationen zu warten oder Wissen neu zu erarbeiten.',
      statSource: 'Panopto Workplace Knowledge and Productivity Report, 2018',
      headA: 'Wissen verlässt Ihr Unternehmen,',
      headB: 'bevor es jemand aufschreibt.',
      lead: 'Rund 80 Prozent dessen, was Ihre Organisation weiß, steht in keinem Dokument. Es steckt in Erfahrung, in Gewohnheiten, in Gesprächen auf dem Flur. Und es geht mit jedem Wechsel, jeder Kündigung und jedem Ruhestand ein Stück verloren.',
      note: 'Klassische Mitarbeiterbefragungen ändern daran wenig: zu grob, zu selten, zu teuer.',
      items: [
        {
          title: 'Menschen gehen, ihr Wissen geht mit',
          body: 'Wenn erfahrene Mitarbeitende das Haus verlassen, verschwindet undokumentiertes Wissen mit ihnen. Die Nachfolge beginnt wieder bei null.',
        },
        {
          title: 'Entscheidungen ohne das Wissen aus der Praxis',
          body: 'Was in Berichte und Präsentationen wandert, ist bereits stark verdichtet. Wie die Arbeit tatsächlich läuft, wissen die Menschen, die sie täglich machen.',
        },
        {
          title: 'KI ohne Unternehmensrealität',
          body: 'Ihre KI-Tools lesen Dokumente. Das Wissen darüber, wie in Ihrem Haus tatsächlich gearbeitet wird, fehlt ihnen komplett.',
        },
      ],
    }
  : {
      eyebrow: 'The challenge',
      statValue: '$26.5M',
      statBody: 'is what a company of 10,000 people loses in productivity every year because knowledge is not shared. 5.3 hours per person per week go into waiting for information or recreating knowledge that already exists.',
      statSource: 'Panopto Workplace Knowledge and Productivity Report, 2018',
      headA: 'Knowledge leaves your company',
      headB: 'before anyone writes it down.',
      lead: 'Around 80 percent of what your organisation knows appears in no document. It lives in experience, in habits, in hallway conversations. And a piece of it goes every time someone moves on, resigns or retires.',
      note: 'Classic employee surveys barely change this: too coarse, too rare, too expensive.',
      items: [
        {
          title: 'People leave, their knowledge leaves with them',
          body: 'When experienced employees walk out, undocumented knowledge walks out too. Their successors start again from zero.',
        },
        {
          title: 'Decisions without the knowledge from practice',
          body: 'What makes it into reports and slide decks is already heavily condensed. How the work actually runs is known by the people who do it every day.',
        },
        {
          title: 'AI without organisational reality',
          body: 'Your AI tools read documents. The knowledge of how your company actually works is missing entirely.',
        },
      ],
    };
---

<section class="tp" id="the-problem">
  <div class="container">

    <div class="tp__head section-fade">
      <h2 class="tp__heading">
        <span class="section-eyebrow tp__eyebrow">{t.eyebrow}</span>
        <span class="tp__line">{t.headA}</span>
        <span class="tp__line tp__line--ghost">{t.headB}</span>
      </h2>
      <p class="tp__lead">{t.lead}</p>
    </div>

    <div class="tp__stat section-fade">
      <p class="tp__stat-value">{t.statValue}</p>
      <div class="tp__stat-copy">
        <p class="tp__stat-body">{t.statBody}</p>
        <p class="tp__stat-source">
          <a href="https://www.panopto.com/company/news/inefficient-knowledge-sharing-costs-large-businesses-47-million-per-year/" target="_blank" rel="noopener noreferrer">{t.statSource}</a>
        </p>
      </div>
    </div>

    <ul class="tp__grid">
      {t.items.map((item, i) => (
        <li class="tp__item section-fade" style={`--delay: ${i * 90}ms`}>
          <span class="tp__rule" aria-hidden="true"></span>
          <span class="tp__num">{`0${i + 1}`}</span>
          <h3 class="tp__item-title">{item.title}</h3>
          <p class="tp__item-body">{item.body}</p>
        </li>
      ))}
    </ul>

    <p class="tp__note section-fade">{t.note}</p>

  </div>
</section>

<style>
  .tp {
    padding: var(--space-section) 0;
    background-color: var(--color-bg);
  }
  @media (max-width: 767px) { .tp { padding: var(--space-24) 0; } }

  /* Stacked like the other section heads, so the headline gets a full line. */
  .tp__head {
    max-width: 760px;
    margin-bottom: var(--space-12);
  }

  .tp__eyebrow { display: block; margin-bottom: var(--space-5); }

  .tp__heading {
    font-size: clamp(var(--text-xl), 4vw, var(--text-2xl));
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.05;
    display: flex;
    flex-direction: column;
    gap: 0.06em;
  }
  .tp__line { color: var(--color-text-primary); }
  .tp__line--ghost { opacity: 0.3; }

  .tp__lead {
    margin-top: var(--space-5);
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-secondary);
    max-width: 60ch;
  }

  /* One number carries the cost of the problem before the three symptoms. */
  .tp__stat {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: var(--space-6) var(--space-10);
    padding: var(--space-10) 0;
    margin-bottom: var(--space-16);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  @media (max-width: 767px) {
    .tp__stat { grid-template-columns: 1fr; gap: var(--space-4); padding: var(--space-8) 0; margin-bottom: var(--space-12); }
  }

  .tp__stat-value {
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.95;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tp__stat-copy { max-width: 56ch; }

  .tp__stat-body {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-primary);
  }

  .tp__stat-source {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
  .tp__stat-source a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .tp__stat-source a:hover { color: var(--color-text-secondary); }

  .tp__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-10) var(--space-8);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (max-width: 860px) { .tp__grid { grid-template-columns: 1fr; gap: var(--space-8); } }

  .tp__item { display: flex; flex-direction: column; }

  .tp__rule {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-border);
    border-radius: 2px;
    margin-bottom: var(--space-5);
    position: relative;
    overflow: hidden;
  }
  /* Orange head on the rule, so the three items read as one measured sequence. */
  .tp__rule::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 34px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .tp__num {
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-3);
  }

  .tp__item-title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .tp__item-body {
    font-size: var(--text-sm);
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .tp__note {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-primary);
    max-width: 62ch;
  }
  @media (max-width: 767px) { .tp__note { margin-top: var(--space-12); } }
</style>
