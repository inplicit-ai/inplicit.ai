---
/**
 * ScrollStage — the pin primitive. Knows nothing about content.
 *
 * A tall spacer whose child sticks to the viewport. The driver writes ONE CSS
 * property, --t, holding the position inside the stage in SCENE units (0 → scenes).
 * Everything else is a pure CSS function of it (see styles/journey.css).
 *
 * No scroll-jacking: we read scrollY and set a custom property. Native momentum,
 * trackpad inertia and scrollbar dragging all stay intact.
 */
import '../../styles/journey.css';

export interface Props {
  /** Number of scenes. --t runs 0 → scenes. */
  scenes?: number;
  /** Travel in vh. Scene-normalised --t means this is a pure budget knob. */
  travel?: number;
  class?: string;
  id?: string;
}
const { scenes = 4, travel = 400, class: klass = '', id } = Astro.props;
---

<section
  class={`jstage ${klass}`}
  id={id}
  data-stage
  data-scenes={scenes}
  style={`--travel: ${travel}`}
>
  <div class="jstage__pin"><slot /></div>
</section>

<script>
  /* One passive listener and one rAF for every stage on the page. JS writes a
     single property on a single element per frame; ~80 parts read it in CSS. */
  const stages = Array.from(
    document.querySelectorAll<HTMLElement>('[data-stage]')
  );

  if (stages.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Base markup (no .is-live) is the assembled, in-flow document — the no-JS
    // and reduced-motion state. Motion is strictly an enhancement.
    stages.forEach((s) => s.classList.add('is-live'));

    const scenesOf = stages.map((s) => Number(s.dataset.scenes) || 1);
    const sceneEls = stages.map((s) =>
      Array.from(s.querySelectorAll<HTMLElement>('.jscene'))
    );
    const lastIdx = stages.map(() => -1);
    const lastT = stages.map(() => -1); // not NaN: NaN comparisons are always false

    let queued = false;

    const frame = () => {
      queued = false;
      for (let i = 0; i < stages.length; i++) {
        const stage = stages[i];
        const pin = stage.firstElementChild as HTMLElement | null;
        if (!pin) continue;

        const rect = stage.getBoundingClientRect();
        const range = stage.offsetHeight - pin.offsetHeight;
        if (range <= 0) continue;

        const p = Math.min(1, Math.max(0, -rect.top / range));
        const t = p * scenesOf[i];

        if (Math.abs(t - lastT[i]) > 0.002) {
          lastT[i] = t;
          stage.style.setProperty('--t', t.toFixed(3));
        }

        // Only the scene under the playhead gets compositor layers, and this is
        // the hook a scene uses to pause expensive work (the WebGL orb) offscreen.
        const idx = Math.min(scenesOf[i] - 1, Math.floor(t));
        if (idx !== lastIdx[i]) {
          lastIdx[i] = idx;
          sceneEls[i].forEach((el, j) => el.classList.toggle('is-active', j === idx));
        }
      }
    };

    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(frame);
      }
    };

    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request, { passive: true });
    request();
  }
</script>
