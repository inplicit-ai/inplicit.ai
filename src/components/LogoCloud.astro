---
import ylcg from '../assets/logos/ylcg.svg?url';
import ignite from '../assets/logos/ignite.svg?url';
import utopia from '../assets/logos/utopia.svg?url';

export interface Props {
  lang?: 'en' | 'de';
}
const { lang = 'en' } = Astro.props;
const isDE = lang === 'de';

// Heights are tuned per logo, not uniform: the marks carry different amounts of
// text, so one shared height would make some read far larger than others.
const logos = [
  { name: 'Youth Lead The Change Germany', src: ylcg,   h: 56 },
  { name: 'Ignite Startup Club Lüneburg',  src: ignite, h: 52 },
  { name: 'Utopia',                        src: utopia, h: 30 },
];
---

<section class="logos">
  <div class="container">
    <p class="logos__label">
      {isDE
        ? 'Führungskräfte dieser Organisationen vertrauen uns bereits'
        : 'Leaders of these organisations already trust us'}
    </p>
    <div class="logos__row">
      {logos.map((l) => (
        <img
          class="logos__img"
          src={l.src}
          alt={l.name}
          style={`--h: ${l.h}px`}
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
  </div>
</section>

<style>
  .logos {
    padding: var(--space-12) 0;
    background-color: var(--color-surface);
  }

  .logos__label {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }

  .logos__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-8) var(--space-16);
    max-width: 880px;
    margin: 0 auto;
  }

  /* Greyscale by default so three different brand palettes sit together
     calmly; the real colours come back on hover. */
  .logos__img {
    height: var(--h, 32px);
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.55;
    transition: opacity 0.25s var(--ease-smooth), filter 0.25s var(--ease-smooth);
  }

  .logos__img:hover {
    filter: grayscale(0);
    opacity: 1;
  }

  @media (max-width: 767px) {
    .logos { padding: var(--space-10) 0; }
    .logos__row { gap: var(--space-6) var(--space-10); }
    .logos__img { height: calc(var(--h, 32px) * 0.82); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logos__img { transition: none; }
  }
</style>
